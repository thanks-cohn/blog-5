      setFocusPlaybackProgram(program: FocusPlaybackProgram) {
        const next: FocusPlaybackProgram = {
          scope: program?.scope === "station" ? "station" : "all",
          order: program?.order === "random" ? "random" : "ordered",
          sequence: Array.isArray(program?.sequence)
            ? program.sequence.filter((value) => typeof value === "string")
            : [],
          residency: (() => {
            const mode =
              program?.residency?.mode === "songs" || program?.residency?.mode === "coverage"
                ? program.residency.mode
                : "cycles";
            const raw = Number(program?.residency?.value);
            return {
              mode,
              value:
                mode === "coverage"
                  ? Math.max(1, Math.min(100, Number.isFinite(raw) ? raw : 100))
                  : Math.max(1, Math.floor(Number.isFinite(raw) ? raw : 1))
            } as PlaneResidencyPolicy;
          })(),
          travelMode:
            program?.travelMode === "teleport" || program?.travelMode === "custom"
              ? program.travelMode
              : "roller-coaster",
          customTravelId:
            typeof program?.customTravelId === "string"
              ? program.customTravelId
              : "",
          pools: Array.isArray(program?.pools)
            ? program.pools.map((pool) => ({
                id: String(pool?.id ?? ""),
                assets: Array.isArray(pool?.assets)
                  ? pool.assets.filter((value) => typeof value === "string")
                  : [],
                tracks: Array.isArray(pool?.tracks)
                  ? pool.tracks.filter((value) => typeof value === "string")
                  : [],
                order: pool?.order === "random" ? "random" : "ordered",
                repeat:
                  pool?.repeat === "forever"
                    ? "forever"
                    : Math.max(1, Math.floor(Number(pool?.repeat) || 1))
              }))
            : []
        };
        focusPlaybackProgram = next;
        presentationSettings.focusAudio.scope = next.scope === "station" ? "station" : "all";
        for (const settings of Object.values(stationSettings)) {
          settings.focusAudio.scope = presentationSettings.focusAudio.scope;
          settings.focusAudio.playbackMode = "zone-cycle";
        }
        window.dispatchEvent(new CustomEvent("webrev:focus-playback-program", {
          detail: JSON.parse(JSON.stringify(next))
        }));
        return JSON.parse(JSON.stringify(next));
