      function renderFocusSongPairing() {
        const api = window.webrevPresentationSettings;
        if (!api || !focusSongGlbPicker || !focusSongTrackPicker || !focusSongStationPicker) return;

        const currentGlb = focusSongGlbPicker.value;
        const glbs = api
          .listAssetLibrary()
          .filter((asset) => asset.kind === "3d" && asset.uploaded)
          .sort((a, b) => a.name.localeCompare(b.name));

        focusSongGlbPicker.replaceChildren();
        const glbPrompt = document.createElement("option");
        glbPrompt.value = "";
        glbPrompt.textContent = glbs.length ? "Choose any GLB…" : "No GLBs uploaded";
        focusSongGlbPicker.appendChild(glbPrompt);

        for (const glb of glbs) {
          const stationLabel =
            stations.find((station: any) => station.id === glb.stationId)?.label ??
            glb.stationId;
          const option = document.createElement("option");
          option.value = glb.name;
          option.textContent = `${glb.name} · ${stationLabel}`;
          option.selected = glb.name === currentGlb;
          focusSongGlbPicker.appendChild(option);
        }

        if (currentGlb && !glbs.some((glb) => glb.name === currentGlb)) {
          focusSongGlbPicker.value = "";
        }

        const selectedGlb = focusSongGlbPicker.value;
        const selectedStation = selectedGlb ? api.getAssetStation(selectedGlb) ?? "" : "";
        const assigned = selectedGlb
          ? api.getAssetFocusAudio(selectedGlb)?.track ?? ""
          : "";

        focusSongStationPicker.replaceChildren();
        const stationPrompt = document.createElement("option");
        stationPrompt.value = "";
        stationPrompt.textContent = selectedGlb ? "Choose plane…" : "Pick a GLB first";
        focusSongStationPicker.appendChild(stationPrompt);
        for (const station of stations) {
          const option = document.createElement("option");
          option.value = station.id;
          option.textContent = station.label ?? station.id;
          option.selected = station.id === selectedStation;
          focusSongStationPicker.appendChild(option);
        }
        focusSongStationPicker.disabled = !selectedGlb;
        focusSongStationPicker.value = selectedStation;

        focusSongTrackPicker.replaceChildren();
        const trackPrompt = document.createElement("option");
        trackPrompt.value = "";
        trackPrompt.textContent = selectedGlb
          ? (config.musicTracks?.length ? "No fixed pairing" : "No songs in assets/music")
          : "Pick a GLB first";
        focusSongTrackPicker.appendChild(trackPrompt);

        for (const track of Array.isArray(config.musicTracks) ? config.musicTracks : []) {
          const option = document.createElement("option");
          option.value = String(track.name);
          option.textContent = String(track.name);
          option.selected = assigned === track.name;
          focusSongTrackPicker.appendChild(option);
        }

        focusSongTrackPicker.disabled = !selectedGlb;
        focusSongTrackPicker.value = assigned;

        if (focusSongPairingStatus) {
          const stationLabel =
            stations.find((station: any) => station.id === selectedStation)?.label ??
            selectedStation;
          focusSongPairingStatus.textContent = selectedGlb
            ? `${selectedGlb} · ${stationLabel || "unassigned"} · ${assigned || "no fixed song"}`
            : "Choose any uploaded GLB, then assign its plane and optional song.";
        }
      }

      function renderSphereSettings() {
        if (!frontAssetsList || !backAssetsList || !assetPicker || !sphereSizeReadout) return;
        const api = window.webrevPresentationSettings;
        if (!api) return;

        const currentStation = stations[arrivingAt];
        if (stationSettingsTitle) {
          stationSettingsTitle.textContent = `${currentStation?.label ?? "Section"} settings`;
        }
        const snapshot = api.get() as PresentationSettingsSnapshot;
        sphereSizeReadout.textContent =
          `Radius ${snapshot.sphere.radius.toFixed(2)} · collision boundary = sphere surface`;

        renderApiSettingsControls();
        renderFocusSongPairing();
        updateStyleExplorationUi();

        frontAssetsList.replaceChildren();
        backAssetsList.replaceChildren();

        const assets = api.listAssets(activeStationId);
        const library = api
          .listAssetLibrary()
          .filter((asset) => asset.uploaded)
          .sort((a, b) => a.name.localeCompare(b.name));

        for (const asset of assets.filter((asset) => asset.visible !== false && asset.hemisphere !== "back")) {
          frontAssetsList.appendChild(makeAssetRowFromApi(asset));
        }
        for (const asset of assets.filter((asset) => asset.visible !== false && asset.hemisphere === "back")) {
          backAssetsList.appendChild(makeAssetRowFromApi(asset));
        }

        assetPicker.replaceChildren();
        const prompt = document.createElement("option");
        prompt.value = "";
        prompt.textContent = library.length ? "Choose any uploaded asset…" : "No uploaded assets";
        assetPicker.appendChild(prompt);

        for (const asset of library) {
          const option = document.createElement("option");
          option.value = asset.name;
          const stationLabel =
            stations.find((station: any) => station.id === asset.stationId)?.label ??
            asset.stationId;
          option.textContent =
            asset.stationId === activeStationId
              ? `${asset.name} · this plane`
              : `${asset.name} · ${stationLabel}`;
          assetPicker.appendChild(option);
        }

        assetPicker.disabled = library.length === 0;
      }

