          presentationSettings.textPlane.offsetY = Math.max(0, Number(value) || 0);
        } else if (key === "textPlane.offsetZ") {
          presentationSettings.textPlane.offsetZ = Number(value) || 0;
        } else if (key === "textPlane.angleDegrees") {
          presentationSettings.textPlane.angleDegrees = Math.max(-180, Math.min(180, Number(value) || 0));
        }
        return publishSettings();
      },
      reset(key?: PresentationSettingKey) {
        const defaults = defaultsForStation(
          stationDefinitions.find((station: any) => station.id === activeStationId)
        );
        if (!key) {
          presentationSettings = cloneSettings(defaults);
          stationSettings[activeStationId] = presentationSettings;
          return publishSettings();
        }
        if (key === "camera.mode") presentationSettings.camera.mode = defaults.camera.mode;
        if (key === "camera.placement") {
          presentationSettings.camera.placement = defaults.camera.placement;
          presentationSettings.camera.distanceFromCenter = defaults.camera.distanceFromCenter;
        }
        if (key === "camera.distanceFromCenter") {
          presentationSettings.camera.distanceFromCenter = defaults.camera.distanceFromCenter;
        }
        if (key === "sphere.diameter" || key === "sphere.radius" || key === "sphere.circumference") {
          applySphereGeometry(sphereFromDiameter(defaults.sphere.diameter));
        }
        if (key === "sphere.restitution") presentationSettings.sphere.restitution = defaults.sphere.restitution;
        if (key === "viewport.enabled") presentationSettings.viewport.enabled = defaults.viewport.enabled;
        if (key === "viewport.paddingPx") presentationSettings.viewport.paddingPx = defaults.viewport.paddingPx;
        if (key === "focusAudio.enabled") presentationSettings.focusAudio.enabled = defaults.focusAudio.enabled;
        if (key === "focusAudio.track") presentationSettings.focusAudio.track = defaults.focusAudio.track;
        if (key === "focusAudio.playbackMode") presentationSettings.focusAudio.playbackMode = defaults.focusAudio.playbackMode;
        if (key === "focusAudio.scope") presentationSettings.focusAudio.scope = defaults.focusAudio.scope;
        if (key === "focusAudio.volume") presentationSettings.focusAudio.volume = defaults.focusAudio.volume;
        if (key === "focusAudio.fadeInMs") presentationSettings.focusAudio.fadeInMs = defaults.focusAudio.fadeInMs;
        if (key === "focusAudio.fadeOutMs") presentationSettings.focusAudio.fadeOutMs = defaults.focusAudio.fadeOutMs;
        if (key === "debug.glbGlobe.enabled") presentationSettings.debug.glbGlobe.enabled = defaults.debug.glbGlobe.enabled;
        if (key === "debug.glbGlobe.objectName") presentationSettings.debug.glbGlobe.objectName = defaults.debug.glbGlobe.objectName;
        if (key === "editor.mode" || key === "editor.hemisphere" || key === "editor.cameraPreset" || key === "editor.repositionObjectName") presentationSettings.editor = { mode: "none" };
        if (key === "textPlane.enabled") presentationSettings.textPlane.enabled = defaults.textPlane.enabled;
        if (key === "textPlane.color") presentationSettings.textPlane.color = defaults.textPlane.color;
        if (key === "textPlane.width") presentationSettings.textPlane.width = defaults.textPlane.width;
        if (key === "textPlane.height") presentationSettings.textPlane.height = defaults.textPlane.height;
        if (key === "textPlane.offsetY") presentationSettings.textPlane.offsetY = defaults.textPlane.offsetY;
        if (key === "textPlane.offsetZ") presentationSettings.textPlane.offsetZ = defaults.textPlane.offsetZ;
        if (key === "textPlane.attachment") presentationSettings.textPlane.attachment = "separate";
        if (key === "textPlane.orientationMode") presentationSettings.textPlane.orientationMode = "axis-angle";
        if (key === "textPlane.rotationAxis") presentationSettings.textPlane.rotationAxis = "center-horizontal-line";
        if (key === "textPlane.angleDegrees") presentationSettings.textPlane.angleDegrees = defaults.textPlane.angleDegrees;
        if (key === "textPlane.placementSpace") presentationSettings.textPlane.placementSpace = "image-relative";
        normalizeCameraForSphere(presentationSettings);
        return publishSettings();
