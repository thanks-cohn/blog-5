        return presentationSettings.sphere.radius;
      }

      function visualBoundsRadius(obj: SceneObject) {
        if (obj.kind === "3d" && Number.isFinite(obj.modelRadius)) {
          return Math.max(0.02, Number(obj.modelRadius) * obj.size);
        }
        return Math.max(0.02, obj.size);
      }

      function spatialEnvelopeConfigFor(obj: SceneObject) {
        return spatialEnvelopeState[obj.name] ??
          normalizeSpatialEnvelopeConfig(
            config.assetEnvelope?.[obj.name],
            obj.motion.type === "fixed" ? "immovable" : "dynamic"
          );
      }

      function objectBodyRadius(obj: SceneObject) {
        return spatialEnvelopeRadius(
          visualBoundsRadius(obj),
          spatialEnvelopeConfigFor(obj)
        );
      }


