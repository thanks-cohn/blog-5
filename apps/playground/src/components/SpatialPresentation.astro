        window.webrevPresentationSettings?.setStyleExplorationMode(
          styleExplorationToggle.checked
        );
      });
      settingsSave?.addEventListener("click", () => {
        window.webrevPresentationSettings?.saveSettings();
      });
      styleExplorationDownload?.addEventListener("click", () => {
        window.webrevPresentationSettings?.downloadStyleSnapshot();
      });

      settingsToggle?.addEventListener("click", () => {
        if (!settingsPanel) return;
        const open = settingsPanel.hidden;
        settingsPanel.hidden = !open;
        settingsToggle.setAttribute("aria-expanded", String(open));
        if (open) renderSphereSettings();
      });
      settingsClose?.addEventListener("click", () => {
        if (!settingsPanel) return;
        settingsPanel.hidden = true;
        settingsToggle?.setAttribute("aria-expanded", "false");
      });
      assetPicker?.addEventListener("change", () => {
        const name = assetPicker.value;
        if (!name) return;
        window.webrevPresentationSettings?.setAssetStation(name, activeStationId);
        window.webrevPresentationSettings?.setAssetHemisphere(name, "front");
        window.webrevPresentationSettings?.setAssetVisible(name, true);
        assetPicker.value = "";
      });
      focusSongGlbPicker?.addEventListener("change", () => {
        renderFocusSongPairing();
      });
      focusSongStationPicker?.addEventListener("change", () => {
        const name = focusSongGlbPicker?.value ?? "";
        if (!name || !focusSongStationPicker.value) return;
        window.webrevPresentationSettings?.setAssetStation(name, focusSongStationPicker.value);
        renderFocusSongPairing();
      });
      focusSongTrackPicker?.addEventListener("change", () => {
        const name = focusSongGlbPicker?.value ?? "";
        if (!name) return;
        window.webrevPresentationSettings?.setAssetFocusAudio(name, {
          track: focusSongTrackPicker.value
        });
        renderFocusSongPairing();
      });
      window.addEventListener("webrev:presentation-settings", () => {
        stationSettings[activeStationId] = presentationSettings;
        targetZ = stationZ(arrivingAt) + presentationSettings.camera.distanceFromCenter;
        syncLiveFocusAudio();
        renderSphereSettings();
      });
      window.addEventListener("webrev:asset-station", () => {
        rebuildAssetLayouts();
        if (settingsPanel && !settingsPanel.hidden) renderSphereSettings();
      });
      window.addEventListener("webrev:asset-placement", () => {
        syncAssetPlacementToLayouts();
        renderSphereSettings();
      });
      window.addEventListener("webrev:asset-runtime-status", () => {
        if (settingsPanel && !settingsPanel.hidden) renderSphereSettings();
      });
      window.addEventListener("webrev:avoid-current-plane-songs", () => {
      });
      window.addEventListener("webrev:fallback-song-history-window", () => {
        // Policy is evaluated at selection time, so no scene rebuild is needed.
        if (settingsPanel && !settingsPanel.hidden) renderSphereSettings();
      });
      window.addEventListener("webrev:unpaired-glb-limit", () => {
        rebuildAssetLayouts();
        if (settingsPanel && !settingsPanel.hidden) renderSphereSettings();
      });
      window.addEventListener("webrev:asset-track-exclusions", () => {
        syncLiveFocusAudio();
        if (settingsPanel && !settingsPanel.hidden) renderSphereSettings();
      });
      window.addEventListener("webrev:asset-focus-audio", () => {
        // Pairing/unpairing a GLB changes whether it participates in the live scene.
        // Rebuild immediately so Settings acts like an activation control.
        rebuildAssetLayouts();
        syncLiveFocusAudio();
        if (settingsPanel && !settingsPanel.hidden) {
          renderFocusSongPairing();
          renderSphereSettings();
        }
      });
      window.addEventListener("webrev:asset-motion", () => {
        for (const layout of layouts) {
          for (const obj of layout) {
            obj.motion = normalizeObjectMotion(
              assetMotionState[obj.name] ?? config.assetMotion?.[obj.name]
            );
            if (obj.motion.type === "fixed") {
              obj.velocity = { x: 0, y: 0, z: 0 };
              obj.anchor = currentFixedAnchor(obj);
              obj.local = { ...obj.anchor };
            } else {
              obj.anchor = { ...obj.local };
            }
          }
        }
        renderSphereSettings();
      });
      renderSphereSettings();

      function stationZ(index: number) {
        return -18 - index * spacing;
      }

      function hashSeed(text: string, seed: number) {
        let h = seed | 0;
        for (let i = 0; i < text.length; i++) h = Math.imul(h ^ text.charCodeAt(i), 16777619);
        return h >>> 0;
      }

      function rngFor(station: any, index: number) {
        const randomVisit = arrangement.mode === "random-every-visit";
        let state = randomVisit
          ? ((Math.random() * 0xffffffff) >>> 0)
          : hashSeed(station.artworkName ?? station.id ?? String(index), Number(arrangement.seed) || 1);

        return () => {
          state += 0x6D2B79F5;
          let t = state;
          t = Math.imul(t ^ (t >>> 15), t | 1);
          t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
      }

      function insideProtectedViewport(p: Vec3) {
        const pad = Number(exclusion.padding) || 0;
        return (
          Math.abs(p.x) < Number(exclusion.width) * 0.5 + pad &&
          Math.abs(p.y) < Number(exclusion.height) * 0.5 + pad &&
          Math.abs(p.z) < Number(exclusion.depth) * 0.5 + pad
        );
      }

      function randomPlacement(rand: () => number): Vec3 {
        const outer = sphereRadius() * 0.72;
        const inner = sphereRadius() * 0.28;
        const radius = inner + (outer - inner) * Math.cbrt(rand());
        const theta = rand() * Math.PI * 2;
        const cosPhi = rand() * 2 - 1;
        const sinPhi = Math.sqrt(Math.max(0, 1 - cosPhi * cosPhi));
        return {
          x: Math.cos(theta) * sinPhi * radius,
          y: cosPhi * radius,
          z: Math.sin(theta) * sinPhi * radius
        };
      }

      function resolve3dSettings(station: any) {
        const defaults = arrangement.asset3d ?? {};
        const override = station.asset3d ?? {};
        const requestedLayer = override.layer ?? defaults.layer ?? "middle";
        const layer: "near" | "middle" | "far" =
          requestedLayer === "near" || requestedLayer === "far" ? requestedLayer : "middle";
        return {
          layer,
          hideBehindImage: Boolean(override.hideBehindImage ?? defaults.hideBehindImage ?? true)
        };
      }

      function applyDepthLayer(position: Vec3, layer: "near" | "middle" | "far"): Vec3 {
        // Camera sits in front of each station along +Z, so positive local Z is nearer.
        // Near assets must stay inside a tighter screen-visible envelope because
        // perspective magnifies their x/y offsets substantially.
        if (layer === "near") {
          position.x *= 0.5;
          position.y *= 0.5;
          position.z = Math.abs(position.z) * 0.24 + sphereRadius() * 0.30;
        } else if (layer === "far") {
          position.z = -Math.abs(position.z) * 0.45 - sphereRadius() * 0.34;
        } else {
          position.z *= 0.3;
        }
        return position;
      }

      function placeUploaded3d(
        assetIndex: number,
        assetCount: number,
        layer: "near" | "middle" | "far"
      ): Vec3 {
        const count = Math.max(1, assetCount);
        const angle = -Math.PI / 2 + (assetIndex / count) * Math.PI * 2;
        const ring = Math.max(2.4, Math.min(sphereRadius() * 0.58, 3.6));
        const position: Vec3 = {
          x: Math.cos(angle) * ring,
          y: Math.sin(angle) * ring * 0.72,
          z: 0
        };
        return applyDepthLayer(position, layer);
      }

      function enforceHemisphere(obj: SceneObject) {
        const minimum = Math.max(0.02, objectBodyRadius(obj));
        const magnitude = Math.max(Math.abs(obj.local.z), minimum);
        obj.local.z = obj.hemisphere === "back" ? -magnitude : magnitude;
      }

      function syncAssetPlacementToLayouts() {
        if (typeof layouts === "undefined") return;
        for (const layout of layouts) {
          for (const obj of layout) {
            const state = assetPlacement[obj.name] ?? { hemisphere: "front" as AssetHemisphere, visible: true };
            obj.hemisphere = state.hemisphere;
            obj.visible = state.visible;
            enforceHemisphere(obj);
            constrainToSphere(obj);
          }
        }
      }

      function resolveConfiguredAnchor(
        name: string,
        fallback: Vec3
      ): {
        anchor: Vec3;
        mode: "absolute" | "camera-midpoint";
        offset: Vec3;
      } {
        const raw = config.assetMotion?.[name]?.anchor;
        const offset: Vec3 = {
          x: Number(raw?.offset?.x) || 0,
          y: Number(raw?.offset?.y) || 0,
          z: Number(raw?.offset?.z) || 0
        };

        if (raw?.mode === "camera-midpoint") {
          return {
            anchor: { ...fallback },
            mode: "camera-midpoint",
            offset
          };
        }

        const hasAbsolute =
          Number.isFinite(Number(raw?.x)) ||
          Number.isFinite(Number(raw?.y)) ||
          Number.isFinite(Number(raw?.z));

        return {
          anchor: hasAbsolute
            ? {
                x: Number.isFinite(Number(raw?.x)) ? Number(raw.x) : fallback.x,
                y: Number.isFinite(Number(raw?.y)) ? Number(raw.y) : fallback.y,
                z: Number.isFinite(Number(raw?.z)) ? Number(raw.z) : fallback.z
              }
            : { ...fallback },
          mode: "absolute",
          offset
        };
      }

      function currentFixedAnchor(obj: SceneObject) {
        if (obj.anchorMode !== "camera-midpoint") return { ...obj.anchor };

        const halfDistance = presentationSettings.camera.distanceFromCenter * 0.5;
        const sign = obj.hemisphere === "back" ? -1 : 1;
        return {
          x: obj.anchorOffset?.x ?? 0,
          y: obj.anchorOffset?.y ?? 0,
          z: sign * halfDistance + (obj.anchorOffset?.z ?? 0)
        };
      }

      function initialPlacementSettingsFor(station: any) {
        return stationSettings[station.id]?.initialPlacement ??
          defaultsForStation(station).initialPlacement;
      }

      function keepInitialViewerImageSightlineClear(
        station: any,
        obj: SceneObject,
        rand: () => number
      ) {
        if (!initialPlacementSettingsFor(station).keepViewerImageSightlineClear) return;
        if (obj.hemisphere === "back" || obj.local.z <= 0) return;

        // Main image plane is 5.4 x 5.9. Add the object's canonical envelope
        // plus a small breathing gap so its visible body does not begin directly
        // between the visitor and the picture.
        const bodyRadius = objectBodyRadius(obj);
        const gap = 0.18;
        const clearHalfWidth = 2.7 + bodyRadius + gap;
        const clearHalfHeight = 2.95 + bodyRadius + gap;

        if (
          Math.abs(obj.local.x) >= clearHalfWidth ||
          Math.abs(obj.local.y) >= clearHalfHeight
        ) return;

        const maxCenterRadius = Math.max(
          bodyRadius,
          sphereRadius() - bodyRadius - 0.001
        );
        const xTarget = clearHalfWidth;
        const yTarget = clearHalfHeight;
        const canUseX = xTarget < maxCenterRadius;
        const canUseY = yTarget < maxCenterRadius;
        if (!canUseX && !canUseY) return;

        const preferX =
          canUseX &&
          (!canUseY ||
            (xTarget - Math.abs(obj.local.x)) <=
              (yTarget - Math.abs(obj.local.y)));

        const sign = (value: number) =>
          value < 0 ? -1 : value > 0 ? 1 : rand() < 0.5 ? -1 : 1;

        if (preferX) {
          obj.local.x = sign(obj.local.x) * xTarget;
          const xySquared = obj.local.x * obj.local.x + obj.local.y * obj.local.y;
          const allowedZ = Math.sqrt(Math.max(bodyRadius * bodyRadius, maxCenterRadius * maxCenterRadius - xySquared));
          obj.local.z = Math.max(bodyRadius, Math.min(Math.abs(obj.local.z), allowedZ));
        } else {
          obj.local.y = sign(obj.local.y) * yTarget;
          const xySquared = obj.local.x * obj.local.x + obj.local.y * obj.local.y;
          const allowedZ = Math.sqrt(Math.max(bodyRadius * bodyRadius, maxCenterRadius * maxCenterRadius - xySquared));
          obj.local.z = Math.max(bodyRadius, Math.min(Math.abs(obj.local.z), allowedZ));
        }

        constrainToSphere(obj);

        // Camera-midpoint anchors are runtime-derived each frame. Preserve the
        // clear starting composition by updating the runtime offset only.
        if (obj.anchorMode === "camera-midpoint") {
          const halfDistance = presentationSettings.camera.distanceFromCenter * 0.5;
          // This helper already returned for back-hemisphere objects above.
          obj.anchorOffset = {
            x: obj.local.x,
            y: obj.local.y,
            z: obj.local.z - halfDistance
          };
        }
      }

      function generateLayout(station: any, index: number): SceneObject[] {
        const rand = rngFor(station, index);
        const fullInventory = Array.isArray(config.assetInventory)
          ? config.assetInventory
          : [];
        const stationInventory = fullInventory.filter((asset: any) =>
          (assetStationState[asset.name] ?? inferredStationForAsset(asset)) === station.id
        );

        // Authored pairings belong to their assigned plane.
        const paired3d = stationInventory.filter((asset: any) => {
          if (asset?.kind !== "3d") return false;
          const pairedTrack =
            assetFocusAudioState[asset.name]?.track ??
            configuredAssetFocusTrack(asset.name);
          return Boolean(pairedTrack);
        });

        // Extra unpaired GLBs are a GLOBAL discovery pool. This is what allows
        // a new/empty plane to receive its normal randomized 3–5 objects even
        // when no GLBs have been explicitly assigned to that plane yet.
        const unpaired3d = fullInventory.filter((asset: any) => {
          if (asset?.kind !== "3d") return false;
          const pairedTrack =
            assetFocusAudioState[asset.name]?.track ??
            configuredAssetFocusTrack(asset.name);
          return !pairedTrack;
        });

        const unpairedPolicy = resolvedUnpairedGlbLimit(station.id);
        const unpairedLimit = resolveUnpairedGlbCount(unpairedPolicy, rand);
        const targetCount =
          unpairedLimit === "all"
            ? unpaired3d.length
            : Math.max(0, unpairedLimit);

        const usedEarlier = new Set(
          randomGlbSelectionHistory.slice(0, index).flat()
        );
        const previousPlane = new Set(
          index > 0 ? randomGlbSelectionHistory[index - 1] ?? [] : []
        );

        // First preference: never used anywhere earlier in this complete run.
        let preferred = randomGlbDiversityPolicy.avoidWithinRun
          ? unpaired3d.filter((asset: any) => !usedEarlier.has(asset.name))
          : [...unpaired3d];
        const afterWithinRunCandidates = preferred.map(
          (asset: any) => String(asset.name)
        );

        // Adjacent-plane repeats are a stronger visual repetition, so avoid them
        // whenever there are enough alternatives.
        if (randomGlbDiversityPolicy.avoidAdjacent) {
          const nonAdjacent = preferred.filter(
            (asset: any) => !previousPlane.has(asset.name)
          );
          if (nonAdjacent.length >= targetCount) preferred = nonAdjacent;
        }

        const afterAdjacentCandidates = preferred.map(
          (asset: any) => String(asset.name)
        );

        let sampledUnpaired = weightedRandomGlbSample(
          preferred,
          Math.min(targetCount, preferred.length),
          index,
          rand
        );

        // If the never-used pool is exhausted, fill from previously used GLBs,
        // still preferring non-adjacent choices and applying distance penalties.
        let fallbackCandidates: string[] = [];
        if (sampledUnpaired.length < targetCount) {
          const selectedNames = new Set(
            sampledUnpaired.map((asset: any) => asset.name)
          );
          let fallbackPool = unpaired3d.filter(
            (asset: any) => !selectedNames.has(asset.name)
          );

          if (randomGlbDiversityPolicy.avoidAdjacent) {
            const nonAdjacentFallback = fallbackPool.filter(
              (asset: any) => !previousPlane.has(asset.name)
            );
            if (nonAdjacentFallback.length >= targetCount - sampledUnpaired.length) {
              fallbackPool = nonAdjacentFallback;
            }
          }

          fallbackCandidates = fallbackPool.map(
            (asset: any) => String(asset.name)
          );

          sampledUnpaired = [
            ...sampledUnpaired,
            ...weightedRandomGlbSample(
              fallbackPool,
              targetCount - sampledUnpaired.length,
              index,
              rand
            )
          ];
        }

        randomGlbSelectionHistory[index] =
          sampledUnpaired.map((asset: any) => String(asset.name));

        const glbInventoryState = fullInventory
          .filter((asset: any) => asset?.kind === "3d")
          .map((asset: any) => {
            const focusTrack =
              assetFocusAudioState[asset.name]?.track ??
              configuredAssetFocusTrack(asset.name);
            return {
              name: String(asset.name),
              assignedStationId:
                assetStationState[asset.name] ?? inferredStationForAsset(asset),
              focusTrack: focusTrack || null,
              paired: Boolean(focusTrack),
              randomPoolEligible: !focusTrack,
              hemisphere: assetPlacement[asset.name]?.hemisphere ?? "front",
              visible: assetPlacement[asset.name]?.visible ?? true
            };
          });

        randomGlbSelectionDebug[index] = {
          stationId: String(station.id),
          stationIndex: index,
          policy: {
            unpaired: JSON.parse(JSON.stringify(unpairedPolicy)),
            resolvedTargetCount: targetCount,
            diversity: JSON.parse(JSON.stringify(randomGlbDiversityPolicy))
          },
          inventory: {
            allGlbs: glbInventoryState,
            assignedToPlane: stationInventory
              .filter((asset: any) => asset?.kind === "3d")
              .map((asset: any) => String(asset.name)),
            pairedOnPlane: paired3d.map((asset: any) => String(asset.name)),
            globalUnpairedPool: unpaired3d.map((asset: any) => String(asset.name))
          },
          history: {
            usedEarlier: [...usedEarlier],
            previousPlane: [...previousPlane]
          },
          candidates: {
            beforeDiversityFilters: unpaired3d.map(
              (asset: any) => String(asset.name)
            ),
            afterWithinRunFilter: afterWithinRunCandidates,
            afterAdjacentFilter: afterAdjacentCandidates,
            fallbackPool: fallbackCandidates
          },
          selectedRandomGlbs: sampledUnpaired.map((asset: any) => String(asset.name)),
          explanation:
            sampledUnpaired.length === 0
              ? "No unpaired GLBs survived the current pool and diversity rules."
              : `Selected ${sampledUnpaired.length} randomized GLB(s) from the global unpaired pool. GLBs with focus-track pairings are excluded from that pool by current runtime semantics.`
        };

        const allDiscovered = [
          ...stationInventory.filter((asset: any) => asset?.kind !== "3d"),
          ...paired3d,
          ...sampledUnpaired
        ];
        const displayMainImageAsFloatingObject =
          station?.mainImage?.displayAsFloatingObject ??
          arrangement?.mainImage?.displayAsFloatingObject ??
          false;
        const mainImageFile = String(
          station?.centerImage ??
          `${station.artworkName}-center`
        ).replace(/^.*\//, "");
        const mainImageBase = mainImageFile.replace(/\.[^.]+$/, "");
        const discovered = allDiscovered.filter((asset: any) => {
          if (displayMainImageAsFloatingObject) return true;
          const assetBase = String(asset?.name ?? "").replace(/\.[^.]+$/, "");
          return assetBase !== mainImageBase && assetBase !== `${station.artworkName}-center`;
        });
        const requestedDisplayMode = station.assetDisplayMode ?? arrangement.assetDisplayMode;
        const displayMode = requestedDisplayMode === "assets-and-proxies"
          ? "assets-and-proxies"
          : "assets-only";
        const configuredProxyCount = Math.max(
          0,
          Math.floor(Number(arrangement.proxyCount ?? sphere.defaultObjectCount ?? 10))
        );
        const extraProxyCount = displayMode === "assets-and-proxies"
          ? configuredProxyCount
          : 0;
        const sceneItems = [
          ...discovered.map((asset: any) => ({ asset })),
          ...Array.from({ length: extraProxyCount }, () => ({ asset: undefined }))
        ];
        const result: SceneObject[] = [];
        const threeSettings = resolve3dSettings(station);
        const uploaded3dCount = discovered.filter((asset: any) => asset?.kind === "3d").length;
        let uploaded3dIndex = 0;

        for (let i = 0; i < sceneItems.length; i++) {
          const asset = sceneItems[i].asset;
          const kind: "2d" | "3d" = asset?.kind === "2d" ? "2d" : "3d";
          const objectName = asset?.name ?? `${station.artworkName}-proxy-${i + 1}`;
          const initialLocal = kind === "3d" && asset
            ? placeUploaded3d(uploaded3dIndex++, uploaded3dCount, threeSettings.layer)
            : kind === "3d"
              ? applyDepthLayer(randomPlacement(rand), threeSettings.layer)
              : randomPlacement(rand);
          const anchorConfig = resolveConfiguredAnchor(objectName, initialLocal);
          const objectMotion = normalizeObjectMotion(
            assetMotionState[objectName] ?? config.assetMotion?.[objectName]
          );
          const obj: SceneObject = {
            id: asset
              ? `${station.id}-asset-${encodeURIComponent(objectName)}`
              : `${station.id}-proxy-${i}`,
            name: objectName,
            kind,
            url: asset?.url,
            local: { ...initialLocal },
            velocity: { x: 0, y: 0, z: 0 },
            size: 0.42 + rand() * 0.7,
            shape: Math.floor(rand() * 4),
            spin: rand() * Math.PI * 2,
            spinVelocity: (rand() - 0.5) * 0.28,
            phase: rand() * Math.PI * 2,
            action: asset ? assetActions[asset.name] : undefined,
            depthLayer: kind === "3d" ? threeSettings.layer : undefined,
            hideBehindImage: kind === "3d" ? threeSettings.hideBehindImage : undefined,
            hemisphere: assetPlacement[objectName]?.hemisphere ?? "front",
            visible: assetPlacement[objectName]?.visible ?? true,
            motion: objectMotion,
            anchor: anchorConfig.anchor,
            anchorMode: anchorConfig.mode,
            anchorOffset: anchorConfig.offset
          };
          if (obj.motion.type === "fixed") {
            obj.local = currentFixedAnchor(obj);
          }
          enforceHemisphere(obj);
          keepInitialViewerImageSightlineClear(station, obj, rand);
          obj.anchor = obj.anchorMode === "camera-midpoint"
            ? currentFixedAnchor(obj)
            : { ...obj.local };

          if (kind === "2d" && asset?.url) {
            const image = new Image();
            image.src = asset.url;
            obj.image = image;
          }

          result.push(obj);
        }

        return result;
      }

      function twistAt(z: number) {
        return Math.sin(z * 0.035) * 0.58 + Math.sin(z * 0.013) * 0.22;
      }

      function topFacePoint(z: number): Vec3 {
        const twist = twistAt(z);
        return {
          x: Math.sin(twist) * prismRadius,
          y: Math.cos(twist) * prismRadius,
          z
        };
      }

      function stationCenter(index: number): Vec3 {
        const z = stationZ(index);
        const railPoint = topFacePoint(z);
        return { x: railPoint.x, y: railPoint.y + 0.9, z };
      }

      function mediaEnvelopeSourceUrl(src: string) {
        return mediaEnvelopeCatalog.get(src) ?? src;
      }

      function mediaEnvelopeDistance(a: Vec3, b: Vec3) {
        return Math.hypot(a.x - b.x, a.y - b.y, a.z - b.z);
      }

      function mediaEnvelopeDirection(from: Vec3, to: Vec3): Vec3 | null {
        const dx = to.x - from.x;
        const dy = to.y - from.y;
        const dz = to.z - from.z;
        const length = Math.hypot(dx, dy, dz);
        if (length < 0.0001) return null;
        return { x: dx / length, y: dy / length, z: dz / length };
      }

      function mediaEnvelopeAngles(direction: Vec3) {
        return {
          azimuthDeg: Math.atan2(direction.x, direction.z) * 180 / Math.PI,
          elevationDeg: Math.asin(Math.max(-1, Math.min(1, direction.y))) * 180 / Math.PI
        };
      }

      function mediaEnvelopeUnitFromAngles(azimuthDeg: number, elevationDeg: number): Vec3 {
        const az = azimuthDeg * Math.PI / 180;
        const el = elevationDeg * Math.PI / 180;
        const ce = Math.cos(el);
        return {
          x: ce * Math.sin(az),
          y: Math.sin(el),
          z: ce * Math.cos(az)
        };
      }

      function mediaEnvelopeAngularDistanceDeg(a: Vec3, b: Vec3) {
        const dot = Math.max(-1, Math.min(1, a.x * b.x + a.y * b.y + a.z * b.z));
        return Math.acos(dot) * 180 / Math.PI;
      }

      function mediaEnvelopeFocusedObject(stationIndex: number, assetName: string) {
        return (layouts[stationIndex] ?? []).find(
          (candidate: SceneObject) =>
            candidate.kind === "3d" &&
            candidate.visible !== false &&
            candidate.name === assetName
        ) ?? null;
      }

      function resolveMediaEnvelopeOrigin(
        program: MediaEnvelopeProgram,
        stationIndex: number,
        assetName: string
      ): Vec3 {
        const center = stationCenter(stationIndex);
        const object = mediaEnvelopeFocusedObject(stationIndex, assetName);
        const mode = program.envelope?.origin?.mode ?? "focused-object";
        const offset = program.envelope?.origin?.offset ?? { x: 0, y: 0, z: 0 };
        const base =
          mode === "focused-object" && object
            ? {
                x: center.x + object.local.x,
                y: center.y + object.local.y,
                z: center.z + object.local.z
              }
            : center;
        return {
          x: base.x + Number(offset.x || 0),
          y: base.y + Number(offset.y || 0),
          z: base.z + Number(offset.z || 0)
        };
      }

      function resolveMediaEnvelopeRadius(
        program: MediaEnvelopeProgram,
        stationIndex: number,
        origin: Vec3
      ) {
        const fixedRadius = Number(program.envelope?.radius);
        if (Number.isFinite(fixedRadius) && fixedRadius > 0) {
          return Math.max(2, fixedRadius);
        }

        const coverage = program.coverage ?? {};
        const include = new Set(
          Array.isArray(coverage.include) && coverage.include.length
            ? coverage.include
            : ["current-main-panel", "next-main-panel"]
        );
        const points: Vec3[] = [];
        if (include.has("current-main-panel")) points.push(stationCenter(stationIndex));
        if (include.has("next-main-panel") && stationIndex < stations.length - 1) {
          points.push(stationCenter(stationIndex + 1));
        }
        const furthest = points.reduce(
          (max, point) => Math.max(max, mediaEnvelopeDistance(origin, point)),
          0
        );
        const padding = Math.max(0, Number(coverage.padding ?? 3));
        const panelAllowance = Math.max(0, Number(coverage.panelAllowance ?? 4));
        const minRadius = Math.max(2, Number(coverage.minRadius ?? 10));
        return Math.max(minRadius, furthest + padding + panelAllowance);
      }

      function createMediaEnvelopePatchGeometry(
        radius: number,
        azimuthDeg: number,
        elevationDeg: number,
        widthDeg: number,
        heightDeg: number
      ) {
        const T3: any = THREE;
        const segmentsX = 12;
        const segmentsY = 8;
        const centerUnit = mediaEnvelopeUnitFromAngles(azimuthDeg, elevationDeg);
        const centerOffset = {
          x: centerUnit.x * radius,
          y: centerUnit.y * radius,
          z: centerUnit.z * radius
        };
        const positions: number[] = [];
        const uvs: number[] = [];
        const indices: number[] = [];

        for (let y = 0; y <= segmentsY; y++) {
          const v = y / segmentsY;
          const elevation = elevationDeg + (v - 0.5) * heightDeg;
          for (let x = 0; x <= segmentsX; x++) {
            const u = x / segmentsX;
            const azimuth = azimuthDeg + (u - 0.5) * widthDeg;
            const point = mediaEnvelopeUnitFromAngles(azimuth, elevation);
            positions.push(
              point.x * radius - centerOffset.x,
              point.y * radius - centerOffset.y,
              point.z * radius - centerOffset.z
            );
            uvs.push(u, v);
          }
        }

        for (let y = 0; y < segmentsY; y++) {
          for (let x = 0; x < segmentsX; x++) {
            const a = y * (segmentsX + 1) + x;
            const b = a + 1;
            const d = (y + 1) * (segmentsX + 1) + x;
            const e = d + 1;
            indices.push(a, d, b, b, d, e);
          }
        }

        const geometry = new T3.BufferGeometry();
        geometry.setAttribute("position", new T3.Float32BufferAttribute(positions, 3));
        geometry.setAttribute("uv", new T3.Float32BufferAttribute(uvs, 2));
        geometry.setIndex(indices);
        geometry.computeVertexNormals();
        return { geometry, centerOffset };
      }

      function mediaEnvelopeProtectedDirections(
        program: MediaEnvelopeProgram,
        stationIndex: number,
        origin: Vec3
      ) {
        const policies =
          Array.isArray(program.protectedRegions)
            ? program.protectedRegions
            : [
                { target: "current-main-panel", mode: "avoid", angularRadiusDeg: 18 },
                { target: "next-main-panel", mode: "avoid", angularRadiusDeg: 18 }
              ];
        const result: Array<{ direction: Vec3; radiusDeg: number; target: string }> = [];
        for (const policy of policies) {
          let targetIndex = stationIndex;
          if (policy.target === "next-main-panel") targetIndex = stationIndex + 1;
          if (targetIndex < 0 || targetIndex >= stations.length) continue;
          const direction = mediaEnvelopeDirection(origin, stationCenter(targetIndex));
          if (!direction) continue;
          result.push({
            direction,
            radiusDeg: Math.max(4, Number(policy.angularRadiusDeg ?? 18)),
            target: policy.target
          });
        }
        return result;
      }

      function createMediaEnvelopeTexture(source: MediaEnvelopeMediaSource) {
        const T3: any = THREE;
        const src = mediaEnvelopeSourceUrl(source.src);
        if (source.type === "video") {
          const video = document.createElement("video");
          video.src = src;
          video.loop = source.loop !== false;
          video.muted = source.muted !== false;
          video.playsInline = true;
          video.preload = "auto";
          video.crossOrigin = "anonymous";
          const texture = new T3.VideoTexture(video);
          if ("colorSpace" in texture && T3.SRGBColorSpace) texture.colorSpace = T3.SRGBColorSpace;
          void video.play().catch(() => {});
          return { texture, video };
        }
        const texture = new T3.TextureLoader().load(src);
        if ("colorSpace" in texture && T3.SRGBColorSpace) texture.colorSpace = T3.SRGBColorSpace;
        return { texture };
      }

      function disposeActiveMediaEnvelope() {
        const active = activeMediaEnvelope;
        if (!active) return;
        for (const tile of active.tiles) {
          tile.video?.pause();
          if (tile.video) {
            tile.video.removeAttribute("src");
            tile.video.load();
          }
          tile.mesh?.geometry?.dispose?.();
          disposeMaterial(tile.material);
          tile.texture?.dispose?.();
        }
        active.group?.parent?.remove?.(active.group);
        activeMediaEnvelope = null;
        window.dispatchEvent(new CustomEvent("webrev:media-envelope-deactivated"));
      }

      function oversphereVideoCatalog() {
        const videos = Array.isArray(config.oversphereVideos)
          ? config.oversphereVideos
          : [];
        return videos
          .filter((entry: any) =>
            entry &&
            typeof entry.id === "string" &&
            typeof entry.url === "string" &&
            entry.id &&
            entry.url
          )
          .map((entry: any) => ({
            id: String(entry.id),
            name: String(entry.name ?? entry.id),
            url: String(entry.url)
          }));
      }

      function normalizeOversphereVideoSelectionPolicy(
        value: Partial<OversphereVideoSelectionPolicy> | undefined
      ): OversphereVideoSelectionPolicy {
        return {
          avoidRecent: Math.max(
            0,
            Math.floor(
              Number(value?.avoidRecent ?? oversphereVideoSelectionPolicy.avoidRecent) || 0
            )
          ),
          avoidCurrentPlane:
            typeof value?.avoidCurrentPlane === "boolean"
              ? value.avoidCurrentPlane
              : oversphereVideoSelectionPolicy.avoidCurrentPlane,
          avoidPreviousPlane:
            typeof value?.avoidPreviousPlane === "boolean"
              ? value.avoidPreviousPlane
              : oversphereVideoSelectionPolicy.avoidPreviousPlane,
          pairingRequired:
            typeof value?.pairingRequired === "boolean"
              ? value.pairingRequired
              : oversphereVideoSelectionPolicy.pairingRequired,
          selection: "random"
        };
      }

      function beginOverspherePlaneHistory(stationIndex: number) {
        const stationId = String(stations[stationIndex]?.id ?? "");
        if (!stationId) return;
        if (oversphereHistoryStationId === stationId) return;

        if (oversphereHistoryStationId !== null) {
          overspherePreviousPlaneVideoIds = [...new Set(oversphereCurrentPlaneVideoIds)];
        }
        oversphereCurrentPlaneVideoIds = [];
        oversphereHistoryStationId = stationId;
      }

      function selectDefaultOversphereVideo(stationIndex: number) {
        const videos = oversphereVideoCatalog();
        if (!videos.length) return null;

        beginOverspherePlaneHistory(stationIndex);

        const recentWindow = Math.min(
          Math.max(0, oversphereVideoSelectionPolicy.avoidRecent),
          Math.max(0, videos.length - 1)
        );
        const recentBlocked = new Set(
          oversphereRecentVideoIds.slice(-recentWindow)
        );

        let candidates = videos.filter((video: any) => !recentBlocked.has(video.id));
        if (!candidates.length) candidates = [...videos];

        if (
          oversphereVideoSelectionPolicy.avoidCurrentPlane &&
          oversphereCurrentPlaneVideoIds.length
        ) {
          const currentPlaneBlocked = new Set(oversphereCurrentPlaneVideoIds);
          const withoutCurrentPlane = candidates.filter(
            (video: any) => !currentPlaneBlocked.has(video.id)
          );
          // Current-plane uniqueness is preferred whenever the pool can satisfy it.
          // If every remaining candidate has already appeared on this plane, relax
          // this rule rather than leaving the focused item without media.
          if (withoutCurrentPlane.length) candidates = withoutCurrentPlane;
        }

        if (
          oversphereVideoSelectionPolicy.avoidPreviousPlane &&
          overspherePreviousPlaneVideoIds.length
        ) {
          const previousBlocked = new Set(overspherePreviousPlaneVideoIds);
          const withoutPreviousPlane = candidates.filter(
            (video: any) => !previousBlocked.has(video.id)
          );
          // Previous-plane exclusion is a preference, not a dead end. Relax it
          // only when the available pool cannot satisfy the rule.
          if (withoutPreviousPlane.length) candidates = withoutPreviousPlane;
        }

        const selected =
          candidates[Math.floor(Math.random() * candidates.length)] ??
          videos[0] ??
          null;
        if (!selected) return null;

        oversphereRecentVideoIds.push(selected.id);
        const historyLimit = Math.max(
          8,
          oversphereVideoSelectionPolicy.avoidRecent + videos.length * 2
        );
        if (oversphereRecentVideoIds.length > historyLimit) {
          oversphereRecentVideoIds = oversphereRecentVideoIds.slice(-historyLimit);
        }
        oversphereCurrentPlaneVideoIds.push(selected.id);

        window.dispatchEvent(new CustomEvent("webrev:oversphere-video-selected", {
          detail: {
            stationId: oversphereHistoryStationId,
            videoId: selected.id,
            recentExcluded: [...recentBlocked],
            currentPlaneExcluded:
              oversphereVideoSelectionPolicy.avoidCurrentPlane
                ? [...new Set(oversphereCurrentPlaneVideoIds)]
                : [],
            previousPlaneExcluded:
              oversphereVideoSelectionPolicy.avoidPreviousPlane
                ? [...overspherePreviousPlaneVideoIds]
                : [],
            candidates: candidates.map((entry: any) => entry.id)
          }
        }));

        return selected;
      }

      function activateDefaultOversphereForSong(
        trigger: Extract<MediaEnvelopeTrigger, { type: "song" }>,
        context: Record<string, unknown>
      ) {
        if (oversphereVideoSelectionPolicy.pairingRequired) return false;

        const stationIndex = Math.max(
          0,
          Math.min(
            stations.length - 1,
            Number.isFinite(Number(context.stationIndex))
              ? Number(context.stationIndex)
              : arrivingAt
          )
        );
        const selected = selectDefaultOversphereVideo(stationIndex);
        const focusedObject = mediaEnvelopeFocusedObject(
          stationIndex,
          typeof context.focusedAssetName === "string"
            ? context.focusedAssetName
            : ""
        );
        const viewportSideOffset =
          focusedObject?.local.x < 0 ? 18 : -18;
        const programId = "__default-oversphere-video__";
        const program: MediaEnvelopeProgram = {
          id: programId,
          envelope: {
            shape: "sphere",
            origin: { mode: "focused-object" },
            radius: defaultOversphereRadius,
            growth: {
              mode: "timed",
              durationMs: 1200,
              easing: "easeOutCubic"
            }
          },
          coverage: {
            include: ["current-main-panel", "next-main-panel"],
            padding: 3,
            panelAllowance: 4,
            minRadius: 10
          },
          surface: {
            side: "inside",
            orientation: { mode: "upright-to-world" },
            depthMode: "foreground"
          },
          protectedRegions: [],
          layout: {
            mode: "hero",
            rows: 1,
            columns: 1,
            horizontalArcDeg: 64,
            verticalArcDeg: 40,
            gapDeg: 0,
            tileAngularWidthDeg: 56,
            tileAngularHeightDeg: 34,
            azimuthOffsetDeg: viewportSideOffset,
            elevationOffsetDeg: 4
          },
          media: selected
            ? [{
                id: selected.id,
                type: "video",
                src: selected.url,
                loop: false,
                muted: true,
                opacity: 1
              }]
            : [],
          lifecycle: {
            endOnMediaEnd: true
          },
          performance: {
            cullOutsideEnvelope: true,
            restoreOutsideAfterMs: 180
          }
        };
        mediaEnvelopePrograms.set(programId, program);
        return activateMediaEnvelopeInternal(
          programId,
          { ...context, trigger },
          "__default-oversphere-song-fallback__"
        );
      }

      function mediaEnvelopeDebugState(): MediaEnvelopeRuntimeState {
        const active = activeMediaEnvelope;
        if (!active) return { active: false };
        const clockSeconds =
          focusAudioElement?.currentTime ??
          Math.max(0, (performance.now() - active.activatedAt) / 1000);
        return {
          active: true,
          bindingId: active.bindingId,
          programId: active.program.id,
          trigger: JSON.parse(JSON.stringify(active.trigger)),
          stationId: stations[active.stationIndex]?.id,
          focusedAssetName: active.focusedAssetName,
          resolvedRadius: active.radius,
          origin: { ...active.origin },
          clockSeconds,
          tileCount: active.tiles.length,
          tiles: active.tiles.map((tile) => ({
            mediaId: tile.mediaId,
            visible: tile.mesh?.visible !== false && tile.opacity > 0.001,
            surfaceCoordinate: { ...tile.surfaceCoordinate },
            scale: tile.scale,
            opacity: tile.opacity,
            hero: tile.hero
          })),
          activeCues: [...active.activeCueLabels]
        };
      }

      function activateMediaEnvelopeInternal(
        programId: string,
        context: Record<string, unknown> = {},
        bindingId?: string
      ) {
        const program = mediaEnvelopePrograms.get(programId);
        if (!program) return false;
        if ((program.envelope?.shape ?? "sphere") !== "sphere") return false;

        ensureThree();
        if (!threeScene) return false;
        disposeActiveMediaEnvelope();

        const stationIndex = Math.max(
          0,
          Math.min(
            stations.length - 1,
            Number.isFinite(Number(context.stationIndex))
              ? Number(context.stationIndex)
              : arrivingAt
          )
        );
        const focusedAssetName =
          typeof context.focusedAssetName === "string"
            ? context.focusedAssetName
            : focusExperience?.object.name ?? "";
        const origin = resolveMediaEnvelopeOrigin(program, stationIndex, focusedAssetName);
        const radius = resolveMediaEnvelopeRadius(program, stationIndex, origin);

        const T3: any = THREE;
        const group = new T3.Group();
        group.position.set(origin.x, origin.y, origin.z);
        group.scale.setScalar(0.001);
        group.renderOrder = -20;
        threeScene.add(group);

        const media = Array.isArray(program.media) ? program.media : [];
        const layout = program.layout ?? {};
        const rows = Math.max(1, Math.floor(Number(layout.rows ?? 3)));
        const columns = Math.max(1, Math.floor(Number(layout.columns ?? 5)));
        const horizontalArc = Math.max(20, Math.min(330, Number(layout.horizontalArcDeg ?? 150)));
        const verticalArc = Math.max(16, Math.min(160, Number(layout.verticalArcDeg ?? 80)));
        const gap = Math.max(0, Number(layout.gapDeg ?? 4));
        const cellWidth = horizontalArc / columns;
        const cellHeight = verticalArc / rows;
        const tileWidth = Math.max(4, Number(layout.tileAngularWidthDeg ?? Math.max(5, cellWidth - gap)));
        const tileHeight = Math.max(4, Number(layout.tileAngularHeightDeg ?? Math.max(5, cellHeight - gap)));

        const camera = cameraPosition();
        // The focus camera is inside the temporary oversphere. Put the media
        // on the far inner wall along the view ray: camera -> focus -> sphere.
        const innerViewWallDirection =
          mediaEnvelopeDirection(camera, origin) ??
          ({ x: 0, y: 0, z: -1 } as Vec3);
        const baseCenterAngles = mediaEnvelopeAngles(innerViewWallDirection);
        const centerAngles = {
          azimuthDeg:
            baseCenterAngles.azimuthDeg + Number(layout.azimuthOffsetDeg ?? 0),
          elevationDeg:
            baseCenterAngles.elevationDeg + Number(layout.elevationOffsetDeg ?? 0)
        };
        const protectedDirections = mediaEnvelopeProtectedDirections(program, stationIndex, origin);
        const candidates: Array<{ azimuthDeg: number; elevationDeg: number }> = [];

        for (let row = 0; row < rows; row++) {
          for (let column = 0; column < columns; column++) {
            const azimuthDeg =
              centerAngles.azimuthDeg -
              horizontalArc / 2 +
              cellWidth * (column + 0.5);
            const elevationDeg =
              centerAngles.elevationDeg +
              verticalArc / 2 -
              cellHeight * (row + 0.5);
            if (elevationDeg <= -86 || elevationDeg >= 86) continue;
            const direction = mediaEnvelopeUnitFromAngles(azimuthDeg, elevationDeg);
            const blocked = protectedDirections.some(
              (protectedRegion) =>
                mediaEnvelopeAngularDistanceDeg(direction, protectedRegion.direction) <
                protectedRegion.radiusDeg
            );
            if (!blocked) candidates.push({ azimuthDeg, elevationDeg });
          }
        }

        const tiles: ActiveMediaEnvelopeTile[] = [];
        for (let index = 0; index < media.length && index < candidates.length; index++) {
          const source = media[index];
          const coordinate = candidates[index];
          if (!source?.id || !source?.src) continue;
          const patch = createMediaEnvelopePatchGeometry(
            radius,
            coordinate.azimuthDeg,
            coordinate.elevationDeg,
            tileWidth,
            tileHeight
          );
          const created = createMediaEnvelopeTexture(source);
          const baseOpacity = Math.max(0, Math.min(1, Number(source.opacity ?? 1)));
          const foreground = program.surface?.depthMode === "foreground";
          const material = new T3.MeshBasicMaterial({
            map: created.texture,
            transparent: true,
            opacity: baseOpacity,
            side: T3.DoubleSide,
            depthTest: !foreground,
            depthWrite: false,
            toneMapped: false
          });
          const mesh = new T3.Mesh(patch.geometry, material);
          mesh.position.set(
            patch.centerOffset.x,
            patch.centerOffset.y,
            patch.centerOffset.z
          );
          mesh.renderOrder = foreground ? 9000 : -10;
          group.add(mesh);
          tiles.push({
            mediaId: source.id,
            mesh,
            material,
            texture: created.texture,
            video: created.video,
            baseOpacity,
            scale: 1,
            opacity: baseOpacity,
            hero: false,
            surfaceCoordinate: coordinate
          });
        }

        activeMediaEnvelope = {
          program,
          bindingId,
          trigger:
            context.trigger && typeof context.trigger === "object"
              ? JSON.parse(JSON.stringify(context.trigger))
              : { type: "direct" },
          stationIndex,
          focusedAssetName,
          origin,
          radius,
          group,
          tiles,
          activatedAt: performance.now(),
          cueActivatedAt: new Map(),
          activeCueLabels: new Set()
        };

        window.dispatchEvent(new CustomEvent("webrev:media-envelope-activated", {
          detail: mediaEnvelopeDebugState()
        }));
        return true;
      }

      function activateMediaEnvelopeForTrigger(
        trigger: MediaEnvelopeTrigger,
        context: Record<string, unknown> = {}
      ) {
        const matches = mediaEnvelopeBindings
          .filter((binding) => {
            if (binding.trigger.type !== trigger.type) return false;
            if (trigger.type === "song" && binding.trigger.type === "song") {
              return binding.trigger.trackId === trigger.trackId;
            }
            if (trigger.type === "object-focus" && binding.trigger.type === "object-focus") {
              return binding.trigger.assetName === trigger.assetName;
            }
            if (trigger.type === "station-enter" && binding.trigger.type === "station-enter") {
              return binding.trigger.stationId === trigger.stationId;
            }
            return false;
          })
          .sort((a, b) => Number(b.priority ?? 0) - Number(a.priority ?? 0));
        const binding = matches[0];
        if (binding) {
          return activateMediaEnvelopeInternal(
            binding.programId,
            { ...context, trigger },
            binding.id
          );
        }
        if (trigger.type === "song") {
          return activateDefaultOversphereForSong(trigger, context);
        }
        return false;
      }

      function updateActiveMediaEnvelope() {
        const active = activeMediaEnvelope;
        if (!active) return;

        const clockSeconds =
          focusAudioElement?.currentTime ??
          Math.max(0, (performance.now() - active.activatedAt) / 1000);
        const growth = active.program.envelope?.growth ?? {};
        const durationMs =
          growth.mode === "instant"
            ? 0
            : Math.max(0, Number(growth.durationMs ?? 1200));
        const rawGrowth =
          durationMs <= 0
            ? 1
            : Math.max(0, Math.min(1, (performance.now() - active.activatedAt) / durationMs));
        const growthT =
          growth.easing === "linear"
            ? rawGrowth
            : 1 - Math.pow(1 - rawGrowth, 3);
        active.group.scale.setScalar(Math.max(0.001, growthT));

        for (const tile of active.tiles) {
          tile.scale = 1;
          tile.opacity = tile.baseOpacity;
          tile.hero = false;
          tile.mesh.visible = true;
        }
        active.activeCueLabels.clear();

        const cues = Array.isArray(active.program.choreography?.cues)
          ? active.program.choreography!.cues!
          : [];

        for (let cueIndex = 0; cueIndex < cues.length; cueIndex++) {
          const cue: any = cues[cueIndex];
          const at = Math.max(0, Number(cue.at ?? 0));
          if (clockSeconds < at) continue;
          const action = String(cue.action ?? "");
          const label = cue.id ? String(cue.id) : `${action || "cue"}@${at}`;

          if (action === "promote" || action === "scale") {
            const tile = active.tiles.find((entry) => entry.mediaId === cue.mediaId);
            if (!tile) continue;
            const duration = Math.max(0, Number(cue.durationMs ?? 0)) / 1000;
            const progress =
              duration <= 0
                ? 1
                : Math.max(0, Math.min(1, (clockSeconds - at) / duration));
            const eased = 1 - Math.pow(1 - progress, 3);
            const targetScale = Math.max(0.01, Number(cue.targetScale ?? cue.scale ?? 1));
            tile.scale = 1 + (targetScale - 1) * eased;
            tile.hero = targetScale > 1;
            active.activeCueLabels.add(label);
            continue;
          }

          const condition: any = cue.when;
          if (condition?.source === "media-scale") {
            const watched = active.tiles.find((entry) => entry.mediaId === condition.mediaId);
            if (!watched || watched.scale < Number(condition.gte ?? 0)) continue;
          }

          if (action === "fade-others" || action === "hide-others") {
            if (!active.cueActivatedAt.has(cueIndex)) {
              active.cueActivatedAt.set(cueIndex, clockSeconds);
            }
            const started = active.cueActivatedAt.get(cueIndex) ?? clockSeconds;
            const duration = Math.max(0, Number(cue.durationMs ?? 0)) / 1000;
            const progress =
              action === "hide-others" || duration <= 0
                ? 1
                : Math.max(0, Math.min(1, (clockSeconds - started) / duration));
            const except = new Set(
              Array.isArray(cue.except)
                ? cue.except.map((value: unknown) => String(value))
                : cue.mediaId
                  ? [String(cue.mediaId)]
                  : []
            );
            for (const tile of active.tiles) {
              if (!except.has(tile.mediaId)) {
                tile.opacity = tile.baseOpacity * (1 - progress);
              }
            }
            active.activeCueLabels.add(label);
            continue;
          }

          if (action === "fade" || action === "hide") {
            const tile = active.tiles.find((entry) => entry.mediaId === cue.mediaId);
            if (!tile) continue;
            const duration = Math.max(0, Number(cue.durationMs ?? 0)) / 1000;
            const progress =
              action === "hide" || duration <= 0
                ? 1
                : Math.max(0, Math.min(1, (clockSeconds - at) / duration));
            tile.opacity = tile.baseOpacity * (1 - progress);
            active.activeCueLabels.add(label);
          }
        }

        for (const tile of active.tiles) {
          tile.mesh.scale.setScalar(tile.scale);
          tile.material.opacity = Math.max(0, Math.min(1, tile.opacity));
          tile.mesh.visible = tile.material.opacity > 0.001;
        }
      }

      Object.assign(window.webrevPresentationSettings ?? {}, {
        listMediaEnvelopePrograms() {
          return [...mediaEnvelopePrograms.values()].map((program) =>
            JSON.parse(JSON.stringify(program))
          );
        },
        getMediaEnvelopeProgram(id: string) {
          const program = mediaEnvelopePrograms.get(id);
          return program ? JSON.parse(JSON.stringify(program)) : null;
        },
        setMediaEnvelopeProgram(program: MediaEnvelopeProgram) {
          if (!program || typeof program.id !== "string" || !program.id) {
            throw new Error("Media envelope program requires a stable id.");
          }
          const normalized = JSON.parse(JSON.stringify(program));
          mediaEnvelopePrograms.set(normalized.id, normalized);
          window.dispatchEvent(new CustomEvent("webrev:media-envelope-program-changed", {
            detail: { id: normalized.id, operation: "set" }
          }));
          return JSON.parse(JSON.stringify(normalized));
        },
        removeMediaEnvelopeProgram(id: string) {
          if (activeMediaEnvelope?.program.id === id) disposeActiveMediaEnvelope();
          const removed = mediaEnvelopePrograms.delete(id);
          if (removed) {
            mediaEnvelopeBindings = mediaEnvelopeBindings.filter(
              (binding) => binding.programId !== id
            );
            window.dispatchEvent(new CustomEvent("webrev:media-envelope-program-changed", {
              detail: { id, operation: "remove" }
            }));
          }
          return removed;
        },
        listMediaEnvelopeBindings() {
          return mediaEnvelopeBindings.map((binding) =>
            JSON.parse(JSON.stringify(binding))
          );
        },
        setMediaEnvelopeBinding(binding: MediaEnvelopeBinding) {
          if (
            !binding ||
            typeof binding.id !== "string" ||
            !binding.id ||
            typeof binding.programId !== "string" ||
            !binding.programId ||
            !binding.trigger ||
            typeof binding.trigger.type !== "string"
          ) {
            throw new Error("Media envelope binding requires id, programId, and trigger.");
          }
          const normalized = JSON.parse(JSON.stringify(binding));
          const index = mediaEnvelopeBindings.findIndex(
            (candidate) => candidate.id === normalized.id
          );
          if (index >= 0) mediaEnvelopeBindings[index] = normalized;
          else mediaEnvelopeBindings.push(normalized);
          window.dispatchEvent(new CustomEvent("webrev:media-envelope-binding-changed", {
            detail: { id: normalized.id, operation: "set" }
          }));
          return JSON.parse(JSON.stringify(normalized));
        },
        removeMediaEnvelopeBinding(id: string) {
          const before = mediaEnvelopeBindings.length;
          mediaEnvelopeBindings = mediaEnvelopeBindings.filter(
            (binding) => binding.id !== id
          );
          const removed = mediaEnvelopeBindings.length !== before;
          if (removed) {
            window.dispatchEvent(new CustomEvent("webrev:media-envelope-binding-changed", {
              detail: { id, operation: "remove" }
            }));
          }
          return removed;
        },
        bindSongToMediaEnvelope(
          trackId: string,
          programId: string,
          bindingId = `song:${trackId}→${programId}`
        ) {
          const binding: MediaEnvelopeBinding = {
            id: bindingId,
            trigger: { type: "song", trackId },
            programId
          };
          const index = mediaEnvelopeBindings.findIndex(
            (candidate) => candidate.id === bindingId
          );
          if (index >= 0) mediaEnvelopeBindings[index] = binding;
          else mediaEnvelopeBindings.push(binding);
          window.dispatchEvent(new CustomEvent("webrev:media-envelope-binding-changed", {
            detail: { id: bindingId, operation: "set" }
          }));
          return JSON.parse(JSON.stringify(binding));
        },
        activateMediaEnvelope(
          programId: string,
          context: Record<string, unknown> = {}
        ) {
          return activateMediaEnvelopeInternal(programId, context);
        },
        deactivateMediaEnvelope() {
          disposeActiveMediaEnvelope();
        },
        getActiveMediaEnvelopeState() {
          return mediaEnvelopeDebugState();
        },
        getOversphereVideoSelectionPolicy() {
          return { ...oversphereVideoSelectionPolicy };
        },
        setOversphereVideoSelectionPolicy(
          patch: Partial<OversphereVideoSelectionPolicy>
        ) {
          oversphereVideoSelectionPolicy =
            normalizeOversphereVideoSelectionPolicy(patch);
          window.dispatchEvent(new CustomEvent("webrev:oversphere-video-policy", {
            detail: { ...oversphereVideoSelectionPolicy }
          }));
          return { ...oversphereVideoSelectionPolicy };
        },
        getOversphereVideoHistory() {
          return {
            recent: [...oversphereRecentVideoIds],
            currentPlane: [...oversphereCurrentPlaneVideoIds],
            previousPlane: [...overspherePreviousPlaneVideoIds],
            stationId: oversphereHistoryStationId
          };
        },
        clearOversphereVideoHistory() {
          oversphereRecentVideoIds = [];
          oversphereCurrentPlaneVideoIds = [];
          overspherePreviousPlaneVideoIds = [];
          oversphereHistoryStationId = null;
          window.dispatchEvent(new CustomEvent("webrev:oversphere-video-history-cleared"));
        }
      });

      function hemisphereEditorPose() {
        if (presentationSettings.editor.mode !== "hemisphere") return null;
        const center = stationCenter(arrivingAt);
        const position = hemisphereEditorCameraPosition(
          center,
          presentationSettings.sphere.radius,
          presentationSettings.editor.cameraPreset,
          presentationSettings.editor.hemisphere
        );
        const angles = lookAnglesAt(center, position);
        return { center, position, ...angles };
      }

      function resize() {
        const rect = gameCanvas.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = Math.max(1, rect.width);
        height = Math.max(1, rect.height);
        const pixelW = Math.floor(width * dpr);
        const pixelH = Math.floor(height * dpr);

        if (gameCanvas.width !== pixelW || gameCanvas.height !== pixelH) {
          gameCanvas.width = pixelW;
          gameCanvas.height = pixelH;
        }

        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        if (threeRenderer && threeCamera) {
          threeRenderer.setPixelRatio(dpr);
          threeRenderer.setSize(width, height, false);
          const focal = Math.min(width, height) * 0.92;
          threeCamera.aspect = width / Math.max(1, height);
          threeCamera.fov = 2 * Math.atan(height / (2 * focal)) * 180 / Math.PI;
          threeCamera.updateProjectionMatrix();
        }
      }

      function outsideDistanceToFitSphere() {
        if (presentationSettings.camera.placement !== "outside") {
          return presentationSettings.camera.distanceFromCenter;
        }

        const radius = presentationSettings.sphere.radius;
        const minViewport = Math.max(1, Math.min(width, height));
        const focal = minViewport * 0.92;
        const padding = Math.max(28, minViewport * 0.045);
        const allowedRadiusPx = Math.max(1, minViewport * 0.5 - padding);
        const required = radius * Math.sqrt(
          1 + Math.pow(focal / allowedRadiusPx, 2)
        );
        return Math.max(
          presentationSettings.camera.distanceFromCenter,
          required + Math.max(0.15, radius * 0.04)
        );
      }

      function cameraPosition(): Vec3 {
        const editPose = hemisphereEditorPose();
        if (editPose) return editPose.position;

        if (focusExperience && focusExperience.stationIndex === arrivingAt) {
          const center = stationCenter(arrivingAt);
          const elapsed = Math.max(0, performance.now() - focusExperience.startedAt);
          const t = Math.min(1, elapsed / 1450);
          const eased = 1 - Math.pow(1 - t, 3);
          const end = {
            x: center.x + focusExperience.cameraOffsetX,
            y: center.y + focusExperience.cameraOffsetY,
            z: center.z + focusExperience.cameraDistance
          };
          return {
            x: focusExperience.cameraStart.x + (end.x - focusExperience.cameraStart.x) * eased,
            y: focusExperience.cameraStart.y + (end.y - focusExperience.cameraStart.y) * eased,
            z: focusExperience.cameraStart.z + (end.z - focusExperience.cameraStart.z) * eased
          };
        }

        const center = stationCenter(arrivingAt);
        const animatedDistance = cameraZ - stationZ(arrivingAt);
        const distance = presentationSettings.camera.placement === "outside"
          ? Math.max(animatedDistance, outsideDistanceToFitSphere())
          : animatedDistance;
        return {
          x: center.x,
          y: center.y,
          z: center.z + distance
        };
      }

      function cameraSpace(point: Vec3) {
        const camera = cameraPosition();
        const dx = point.x - camera.x;
        const dy = point.y - camera.y;
        const dz = point.z - camera.z;

        const cy = Math.cos(-lookYaw);
        const sy = Math.sin(-lookYaw);
        const x1 = dx * cy - dz * sy;
        const z1 = dx * sy + dz * cy;

        const cp = Math.cos(-lookPitch);
        const sp = Math.sin(-lookPitch);
        const y2 = dy * cp - z1 * sp;
        const z2 = dy * sp + z1 * cp;

        return { x: x1, y: y2, z: z2, depth: -z2 };
      }

      function project(point: Vec3): Projected | null {
        const transformed = cameraSpace(point);
        const x1 = transformed.x;
        const y2 = transformed.y;
        const depth = transformed.depth;
        if (depth < 0.35) return null;

        const focal = Math.min(width, height) * 0.92;
        const scale = focal / depth;
        return {
          x: width * 0.5 + x1 * scale,
          y: height * 0.5 - y2 * scale,
          depth,
          scale
        };
      }

      function projectedObjectBounds(center: Vec3, obj: SceneObject) {
        const worldCenter = {
          x: center.x + obj.local.x,
          y: center.y + obj.local.y,
          z: center.z + obj.local.z
        };
        const centerProjection = project(worldCenter);
        if (!centerProjection) return null;

        if (obj.kind === "3d" && obj.modelBounds) {
          const b = obj.modelBounds;
          const corners = [
            [b.min.x, b.min.y, b.min.z],
            [b.min.x, b.min.y, b.max.z],
            [b.min.x, b.max.y, b.min.z],
            [b.min.x, b.max.y, b.max.z],
            [b.max.x, b.min.y, b.min.z],
            [b.max.x, b.min.y, b.max.z],
            [b.max.x, b.max.y, b.min.z],
            [b.max.x, b.max.y, b.max.z]
          ];
          const cos = Math.cos(obj.spin);
          const sin = Math.sin(obj.spin);
          let minX = Infinity, minY = Infinity;
          let maxX = -Infinity, maxY = -Infinity;
          let count = 0;

          for (const [bx, by, bz] of corners) {
            const sx = bx * obj.size;
            const sy = by * obj.size;
            const sz = bz * obj.size;
            const rx = sx * cos + sz * sin;
            const rz = -sx * sin + sz * cos;
            const p = project({
              x: worldCenter.x + rx,
              y: worldCenter.y + sy,
              z: worldCenter.z + rz
            });
            if (!p) continue;
            count++;
            minX = Math.min(minX, p.x);
            minY = Math.min(minY, p.y);
            maxX = Math.max(maxX, p.x);
            maxY = Math.max(maxY, p.y);
          }

          if (count > 0) return { minX, minY, maxX, maxY, centerProjection };
        }

        const radius = Math.max(10, objectBodyRadius(obj) * centerProjection.scale);
        return {
          minX: centerProjection.x - radius,
          minY: centerProjection.y - radius,
          maxX: centerProjection.x + radius,
          maxY: centerProjection.y + radius,
          centerProjection
        };
      }

      function pullIntoProjectableView(center: Vec3, obj: SceneObject) {
        const world = {
          x: center.x + obj.local.x,
          y: center.y + obj.local.y,
          z: center.z + obj.local.z
        };
        if (project(world)) return;

        // Pull toward the image center without changing hemisphere sign.
        for (let i = 0; i < 10; i++) {
          obj.local.x *= 0.78;
          obj.local.y *= 0.78;
          obj.local.z *= 0.78;
          enforceHemisphere(obj);
          constrainToSphere(obj);
          const candidate = {
            x: center.x + obj.local.x,
            y: center.y + obj.local.y,
            z: center.z + obj.local.z
          };
          if (project(candidate)) return;
        }
      }

      function constrainToViewport(center: Vec3, obj: SceneObject) {
        if (!presentationSettings.viewport.enabled) return;

        pullIntoProjectableView(center, obj);
        const bounds = projectedObjectBounds(center, obj);
        if (!bounds) return;

        const pad = presentationSettings.viewport.paddingPx;
        let dx = 0;
        let dy = 0;

        if (bounds.minX < pad) dx = pad - bounds.minX;
        else if (bounds.maxX > width - pad) dx = (width - pad) - bounds.maxX;

        if (bounds.minY < pad) dy = pad - bounds.minY;
        else if (bounds.maxY > height - pad) dy = (height - pad) - bounds.maxY;

        if (dx === 0 && dy === 0) return;

        const worldPerPixel = 1 / Math.max(bounds.centerProjection.scale, 0.0001);

        // Screen right/left maps to camera-local x. With locked/focus modes this is
        // effectively world x/y; small iterative passes below handle look offsets.
        obj.local.x += dx * worldPerPixel;
        obj.local.y -= dy * worldPerPixel;

        if (dx !== 0) obj.velocity.x *= -0.55;
        if (dy !== 0) obj.velocity.y *= -0.55;
      }

      function drawBackground() {
        const g = ctx.createRadialGradient(
          width * 0.5, height * 0.42, 10,
          width * 0.5, height * 0.5, Math.max(width, height) * 0.78
        );
        g.addColorStop(0, "#18202b");
        g.addColorStop(0.45, "#090d13");
        g.addColorStop(1, "#020304");
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, width, height);

        ctx.fillStyle = "rgba(255,255,255,.14)";
        for (let i = 0; i < 42; i++) {
          const x = (i * 193.1) % width;
          const y = (i * 91.7) % height;
          ctx.fillRect(x, y, i % 4 === 0 ? 1.5 : 1, i % 4 === 0 ? 1.5 : 1);
        }
      }

      function drawRail() {
        const start = Math.floor(cameraZ / 4) * 4 + 8;
        const points: Projected[] = [];

        for (let z = start; z >= cameraZ - spacing * (stations.length + 2); z -= 1.2) {
          const p = project(topFacePoint(z));
          if (p) points.push(p);
        }

        if (points.length > 1) {
          ctx.beginPath();
          ctx.moveTo(points[0].x, points[0].y);
          for (let i = 1; i < points.length; i++) ctx.lineTo(points[i].x, points[i].y);
          ctx.strokeStyle = "rgba(232,218,192,.68)";
          ctx.lineWidth = 1.25;
          ctx.stroke();
        }
      }

      function themeColors(theme: string) {
        if (theme === "blue") return ["#203954", "#7ea6d7", "#0d1520"];
        if (theme === "rose") return ["#512937", "#c77f94", "#180d13"];
        return ["#5a3a22", "#d5a268", "#1b120c"];
      }

      function createFallbackMainImageTexture(station: any) {
        const textureCanvas = document.createElement("canvas");
        textureCanvas.width = 1024;
        textureCanvas.height = 1120;
        const tctx = textureCanvas.getContext("2d");
        if (!tctx) return null;

        const colors = themeColors(station.theme);
        tctx.fillStyle = "#141414";
        tctx.fillRect(0, 0, textureCanvas.width, textureCanvas.height);

        const inset = 28;
        const gradient = tctx.createLinearGradient(
          inset,
          inset,
          textureCanvas.width - inset,
          textureCanvas.height - inset
        );
        gradient.addColorStop(0, colors[0]);
        gradient.addColorStop(.52, colors[1]);
        gradient.addColorStop(1, colors[2]);
        tctx.fillStyle = gradient;
        tctx.fillRect(
          inset,
          inset,
          textureCanvas.width - inset * 2,
          textureCanvas.height - inset * 2
        );

        tctx.strokeStyle = "rgba(255,255,255,.22)";
        tctx.lineWidth = 2;
        tctx.strokeRect(
          inset + 1,
          inset + 1,
          textureCanvas.width - inset * 2 - 2,
          textureCanvas.height - inset * 2 - 2
        );

        tctx.fillStyle = "rgba(255,255,255,.88)";
        tctx.font = "600 34px ui-sans-serif, system-ui";
        tctx.textAlign = "left";
        tctx.textBaseline = "alphabetic";
        tctx.fillText(String(station.label ?? ""), 64, textureCanvas.height - 68);

        const T3: any = THREE;
        const texture = new T3.CanvasTexture(textureCanvas);
        texture.needsUpdate = true;
        return texture;
      }

      function mainImageUrlFor(station: any) {
        const bundled = config.centerImagesByArtwork?.[station.artworkName];
        const configured = station?.centerImage;

        // Repo-managed center images live in src/assets/2d-assets and Astro
        // rewrites them to hashed build URLs. Prefer that resolved URL whenever
        // a matching *-center asset exists; a bare filename is metadata, not a
        // browser-loadable public path.
        if (bundled) return String(bundled);
        if (typeof configured === "string" && configured) return configured;
        return "";
      }

      function ensureMainImagePlane(station: any, center: Vec3) {
        if (!threeScene) return null;
        const imageUrl = mainImageUrlFor(station);
        const signature = [station.id, station.label, station.theme, imageUrl].join("|");
        let entry = imagePlanes.get(station.id);

        if (!entry || entry.signature !== signature) {
          if (entry) {
            threeScene.remove(entry.group);
            entry.mesh.geometry?.dispose?.();
            entry.mesh.material?.dispose?.();
            entry.texture?.dispose?.();
          }

          const fallbackTexture = createFallbackMainImageTexture(station);
          if (!fallbackTexture) return null;

          const T3: any = THREE;
          const group = new T3.Group();
          const geometry = new T3.PlaneGeometry(5.4, 5.9);
          const material = new T3.MeshBasicMaterial({
            map: fallbackTexture,
            side: T3.DoubleSide,
            depthTest: true,
            depthWrite: true
          });

          let texture = fallbackTexture;
          if (imageUrl) {
            const loader = new T3.TextureLoader();
            loader.load(
              imageUrl,
              (loaded: any) => {
                loaded.needsUpdate = true;
                material.map = loaded;
                material.needsUpdate = true;
                const live = imagePlanes.get(station.id);
                if (live && live.signature === signature) {
                  live.texture?.dispose?.();
                  live.texture = loaded;
                } else {
                  loaded.dispose?.();
                }
              },
              undefined,
              (error: any) => {
                console.warn(`Center image failed to load for ${station.id}: ${imageUrl}`, error);
              }
            );
          }
          const mesh = new T3.Mesh(geometry, material);
          mesh.renderOrder = 10;
          group.add(mesh);
          threeScene.add(group);

          entry = { group, mesh, texture, signature };
          imagePlanes.set(station.id, entry);
        }

        entry.group.visible = true;
        entry.group.position.set(center.x, center.y, center.z);

        if (presentationSettings.editor.mode === "hemisphere") {
          // Hemisphere Editor invariant: image is the fixed world-space center plane.
          entry.group.quaternion.identity();
        } else {
          const basis = screenBasis(center, cameraPosition());
          const imageRight = basis.right;
          const imageUp = basis.up;
          const imageNormal = {
            x: -basis.forward.x,
            y: -basis.forward.y,
            z: -basis.forward.z
          };
          const T3: any = THREE;
          const matrix = new T3.Matrix4().makeBasis(
            new T3.Vector3(imageRight.x, imageRight.y, imageRight.z),
            new T3.Vector3(imageUp.x, imageUp.y, imageUp.z),
            new T3.Vector3(imageNormal.x, imageNormal.y, imageNormal.z)
          );
          entry.group.quaternion.setFromRotationMatrix(matrix);
        }

        return entry;
      }

      function constrainToSphere(obj: SceneObject) {
        const radius = sphereRadius();
        let bodyRadius = objectBodyRadius(obj);
        const maximumBodyRadius = maxBodyRadiusForSphere(radius);

        // If the sphere is resized smaller than an existing model, fit the model
        // first. This preserves the invariant that the complete GLB remains inside.
        if (bodyRadius > maximumBodyRadius && bodyRadius > 0) {
          obj.size *= maximumBodyRadius / bodyRadius;
          bodyRadius = maximumBodyRadius;
        }

        const constrained = constrainBodyToHemisphereSphere(
          {
            position: obj.local,
            velocity: obj.velocity
          },
          obj.hemisphere === "back" ? "back" : "front",
          radius,
          bodyRadius,
          presentationSettings.sphere.restitution
        );

        obj.local = constrained.position;
        obj.velocity = constrained.velocity;
      }

      function visibleModelFitsAssignedHemisphere(obj: SceneObject) {
        if (obj.kind !== "3d" || !obj.modelBounds) return true;
        const scaledMinZ = obj.modelBounds.min.z * obj.size;
        const scaledMaxZ = obj.modelBounds.max.z * obj.size;
        const worldMinZ = obj.local.z + scaledMinZ;
        const worldMaxZ = obj.local.z + scaledMaxZ;
        return obj.hemisphere === "back"
          ? worldMaxZ <= 0.0005
          : worldMinZ >= -0.0005;
      }

      function solveObjectBounds(stationIndex: number, obj: SceneObject) {
        const center = stationCenter(stationIndex);

        // Rule 1 is always authoritative.
        enforceHemisphere(obj);
        constrainToSphere(obj);

        // Normal visitor framing rule. Focus mode deliberately suspends this:
        // only the selected object + main picture define the shot, and other
        // assets are allowed to leave the viewport.
        const focusOwnsComposition =
          focusExperience && focusExperience.stationIndex === stationIndex;
        if (
          !focusOwnsComposition &&
          presentationSettings.viewport.enabled &&
          stationIndex === arrivingAt
        ) {
          for (let pass = 0; pass < 5; pass++) {
            constrainToViewport(center, obj);
            enforceHemisphere(obj);
            constrainToSphere(obj);
          }
          // Final viewport correction followed by a final sphere guarantee.
          constrainToViewport(center, obj);
          enforceHemisphere(obj);
          constrainToSphere(obj);
        }

        // Rule 1 applies to the ACTUAL visible model, not merely its logical center.
        if (obj.kind === "3d" && obj.modelBounds && !visibleModelFitsAssignedHemisphere(obj)) {
          const scaledMinZ = obj.modelBounds.min.z * obj.size;
          const scaledMaxZ = obj.modelBounds.max.z * obj.size;
          if (obj.hemisphere === "front") {
            obj.local.z = Math.max(obj.local.z, -scaledMinZ + 0.001);
          } else {
            obj.local.z = Math.min(obj.local.z, -scaledMaxZ - 0.001);
          }
          constrainToSphere(obj);
        }
      }

      function resolveEnvelopeCollisions(stationIndex: number) {
        const layout = layouts[stationIndex].filter(
          (obj: SceneObject) => obj.visible !== false
        );

        // Broad phase is intentionally simple while station counts are small.
        // The envelope API is independent of this strategy, so we can swap this
        // for a spatial hash later without changing callers.
        for (let i = 0; i < layout.length; i++) {
          const a = layout[i];
          if (focusExperience?.object === a) continue;
          const configA = spatialEnvelopeConfigFor(a);
          if (!configA.collision.enabled) continue;

          for (let j = i + 1; j < layout.length; j++) {
            const b = layout[j];
            if (focusExperience?.object === b) continue;
            const configB = spatialEnvelopeConfigFor(b);
            if (!configB.collision.enabled) continue;

            // Objects in opposite hemispheres are already separated by the image plane.
            if (a.hemisphere !== b.hemisphere) continue;

            const radiusA = objectBodyRadius(a);
            const radiusB = objectBodyRadius(b);
            const responseA =
              a.motion.type === "fixed" && configA.collision.response === "dynamic"
                ? "immovable"
                : configA.collision.response;
            const responseB =
              b.motion.type === "fixed" && configB.collision.response === "dynamic"
                ? "immovable"
                : configB.collision.response;

            const result = resolveSphereCollision(
              {
                position: a.local,
                velocity: a.velocity,
                radius: radiusA,
                mass: configA.collision.mass,
                response: responseA
              },
              {
                position: b.local,
                velocity: b.velocity,
                radius: radiusB,
                mass: configB.collision.mass,
                response: responseB
              },
              Math.min(configA.collision.restitution, configB.collision.restitution)
            );
            if (!result.collided) continue;

            a.local = { ...result.a.position };
            a.velocity = { ...result.a.velocity };
            b.local = { ...result.b.position };
            b.velocity = { ...result.b.velocity };

            solveObjectBounds(stationIndex, a);
            solveObjectBounds(stationIndex, b);
          }
        }
      }

      function updateObjects(now: number, dt: number) {
        const damping = Math.pow(Number(motion.tossDamping) || 0.992, dt * 60);
        const floatStrength = Number(motion.floatStrength) || 0.08;
        const floatSpeed = Number(motion.floatSpeed) || 0.22;

        for (let stationIndex = 0; stationIndex < layouts.length; stationIndex++) {
          const layout = layouts[stationIndex];
          const center = stationCenter(stationIndex);
          for (const obj of layout) {
            if (obj.visible === false) continue;
            if (grabbed?.object === obj) continue;

            const activeFocus =
              focusExperience &&
              focusExperience.stationIndex === stationIndex &&
              focusExperience.object === obj
                ? focusExperience
                : null;

            if (activeFocus) {
              const elapsed = Math.max(0, now - activeFocus.startedAt);
              const bob = Math.sin(elapsed * 0.001 * 1.35 + obj.phase) * 0.12;

              // Focus never relocates the selected object. It freezes the
              // object's translational position at the point the visitor chose,
              // while preserving a small presentation bob and slow spin.
              obj.local = {
                x: activeFocus.baseLocal.x,
                y: activeFocus.baseLocal.y + bob,
                z: activeFocus.baseLocal.z
              };
              obj.velocity = { x: 0, y: 0, z: 0 };
              obj.spin = activeFocus.startSpin + elapsed * 0.00018;
              continue;
            }

            if (obj.motion.type === "fixed") {
              obj.velocity = { x: 0, y: 0, z: 0 };
              const anchor = currentFixedAnchor(obj);
              obj.anchor = { ...anchor };
              obj.local = fixedPositionAtTime(
                anchor,
                obj.motion,
                obj.phase,
                now * 0.001
              );
            } else {
              obj.velocity.x *= damping;
              obj.velocity.y *= damping;
              obj.velocity.z *= damping;

              const t = now * 0.001 * floatSpeed + obj.phase;
              obj.velocity.y += Math.sin(t) * floatStrength * dt;
              obj.velocity.x += Math.cos(t * 0.77) * floatStrength * 0.42 * dt;

              obj.local.x += obj.velocity.x * dt;
              obj.local.y += obj.velocity.y * dt;
              obj.local.z += obj.velocity.z * dt;
            }

            if (obj.kind === "3d") obj.spin += obj.spinVelocity * dt;
            solveObjectBounds(stationIndex, obj);
          }
          resolveEnvelopeCollisions(stationIndex);
        }
      }

      function drawSceneObject(center: Vec3, obj: SceneObject, alpha: number, now: number) {
        if (obj.visible === false) {
          obj.lastScreen = undefined;
          return;
        }
        const world = {
          x: center.x + obj.local.x,
          y: center.y + obj.local.y,
          z: center.z + obj.local.z
        };
        const p = project(world);
        if (!p || p.depth > 60) {
          obj.lastScreen = undefined;
          return;
        }

        const size = Math.max(8, obj.size * p.scale);
        obj.lastScreen = { x: p.x, y: p.y, radius: size * 1.15, depth: p.depth };

        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.globalAlpha = alpha;

        if (obj.kind === "2d") {
          const wobbleDeg = Number(billboard.wobbleDegrees) || 1.4;
          const wobbleSpeed = Number(billboard.wobbleSpeed) || 0.28;
          const maxYaw = Number(billboard.maxYawDegrees) || 5;
          const wobble = Math.sin(now * 0.001 * wobbleSpeed + obj.phase) * wobbleDeg;
          const tossTilt = Math.max(-maxYaw, Math.min(maxYaw, obj.velocity.x * 1.4));
          const rotation = (wobble + tossTilt) * Math.PI / 180;
          ctx.rotate(rotation);

          if (obj.image?.complete && obj.image.naturalWidth > 0) {
            const aspect = obj.image.naturalWidth / obj.image.naturalHeight;
            const h = size * 1.7;
            const w = h * aspect;
            ctx.drawImage(obj.image, -w / 2, -h / 2, w, h);
            ctx.strokeStyle = "rgba(255,255,255,.25)";
            ctx.strokeRect(-w / 2, -h / 2, w, h);
          } else {
            ctx.fillStyle = "rgba(225,232,244,.88)";
            ctx.fillRect(-size, -size * .72, size * 2, size * 1.44);
            ctx.strokeStyle = "rgba(255,255,255,.28)";
            ctx.strokeRect(-size, -size * .72, size * 2, size * 1.44);
          }
        } else if (obj.url) {
          // Lazy-load only models close enough to matter visually. This keeps
          // randomized assets on distant planes from consuming GPU memory before
          // the visitor approaches them.
          if (p.depth <= 30) ensureThreeObject(obj);
          const model = threeObjects.get(obj.id);
          if (model) {
            model.visible = true;
            model.position.set(world.x, world.y, world.z);
            model.rotation.set(0, obj.spin, 0);
            model.scale.setScalar(obj.size);
          }

          const envelopeConfig = spatialEnvelopeConfigFor(obj);
          if (envelopeConfig.debug.visible) {
            const envelopeGlobe = ensureEnvelopeDebugGlobe(
              obj,
              envelopeConfig.debug.opacity
            );
            if (envelopeGlobe) {
              envelopeGlobe.visible = true;
              envelopeGlobe.position.set(world.x, world.y, world.z);
              envelopeGlobe.scale.setScalar(objectBodyRadius(obj));
            }
          }

          if (
            presentationSettings.debug.glbGlobe.enabled &&
            presentationSettings.debug.glbGlobe.objectName === obj.name
          ) {
            const globe = ensureDebugGlobe(obj);
            if (globe) {
              const debugRadius = Math.max(
                0.18,
                (Number.isFinite(obj.modelRadius) ? Number(obj.modelRadius) : 1) * obj.size
              );
              globe.visible = true;
              globe.position.set(world.x, world.y, world.z);
              globe.scale.setScalar(debugRadius);
            }
          }
        } else {
          // No uploaded 3D asset exists for this slot, so render a mathematical
          // proxy placeholder. Uploaded GLB/GLTF assets are rendered by Three.js.
          ctx.rotate(obj.spin);
          if (obj.shape === 0) {
            const g = ctx.createRadialGradient(-size * .2, -size * .25, 0, 0, 0, size);
            g.addColorStop(0, "#d9e4f2");
            g.addColorStop(1, "#26303e");
            ctx.fillStyle = g;
            ctx.beginPath();
            ctx.arc(0, 0, size, 0, Math.PI * 2);
            ctx.fill();
          } else if (obj.shape === 1) {
            ctx.fillStyle = "#4d5968";
            ctx.fillRect(-size, -size * .6, size * 2, size * 1.2);
          } else if (obj.shape === 2) {
            ctx.strokeStyle = "rgba(198,211,226,.72)";
            ctx.lineWidth = Math.max(1, size * .16);
            ctx.beginPath();
            ctx.arc(0, 0, size, 0, Math.PI * 2);
            ctx.stroke();
          } else {
            ctx.fillStyle = "#747b85";
            ctx.beginPath();
            ctx.moveTo(0, -size);
            ctx.lineTo(size * .82, size * .72);
            ctx.lineTo(-size * .82, size * .72);
            ctx.closePath();
            ctx.fill();
          }
        }

        if (obj.action) {
          ctx.strokeStyle = "rgba(255,255,255,.34)";
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.arc(0, 0, size * 1.22, 0, Math.PI * 2);
          ctx.stroke();
        }

        ctx.restore();
      }

      function wrapText(text: string, x: number, y: number, maxWidth: number, lineHeight: number) {
        const words = String(text).split(/\s+/);
        let line = "";
        let yy = y;
        for (const word of words) {
          const test = line ? `${line} ${word}` : word;
          if (ctx.measureText(test).width > maxWidth && line) {
            ctx.fillText(line, x, yy);
            line = word;
            yy += lineHeight;
          } else {
            line = test;
          }
        }
        if (line) ctx.fillText(line, x, yy);
      }

      function ensureHorizontalTextPlane(station: any, imageEntry: any, current: boolean) {
        if (!threeScene || !imageEntry) return;
        const settings = stationSettings[station.id]?.textPlane ?? defaultsForStation(station).textPlane;
        if (!settings.enabled) {
          const existing = textPlanes.get(station.id);
          if (existing) existing.mesh.visible = false;
          return;
        }

        const text = current && paperTextOverride ? paperTextOverride : station.text ?? {};
        const title = String(text.title ?? station.label ?? "");
        const body = String(text.body ?? "");
        const signature = [title, body, settings.color, settings.width, settings.height].join("|");
        let entry = textPlanes.get(station.id);

        if (!entry || entry.signature !== signature) {
          if (entry) {
            entry.mesh.parent?.remove?.(entry.mesh);
            entry.mesh.geometry?.dispose?.();
            entry.mesh.material?.dispose?.();
            entry.texture?.dispose?.();
          }

          const textureCanvas = document.createElement("canvas");
          textureCanvas.width = 1024;
          textureCanvas.height = 256;
          const tctx = textureCanvas.getContext("2d");
          if (!tctx) return;
          tctx.fillStyle = settings.color;
          tctx.fillRect(0, 0, 1024, 256);

          const raw = settings.color.replace("#", "");
          const rr = parseInt(raw.slice(0,2),16) || 255;
          const gg = parseInt(raw.slice(2,4),16) || 255;
          const bb = parseInt(raw.slice(4,6),16) || 255;
          const lum = (0.2126*rr + 0.7152*gg + 0.0722*bb)/255;
          tctx.fillStyle = lum > 0.55 ? "#171717" : "#f7f7f7";
          tctx.textBaseline = "top";
          tctx.font = "700 46px ui-sans-serif, system-ui";
          tctx.fillText(title, 54, 34, 916);
          tctx.font = "30px ui-sans-serif, system-ui";

          const words = body.split(/\s+/);
          let line = "", y = 108;
          for (const word of words) {
            const candidate = line ? `${line} ${word}` : word;
            if (tctx.measureText(candidate).width > 916 && line) {
              tctx.fillText(line, 54, y);
              line = word;
              y += 40;
              if (y > 205) break;
            } else {
              line = candidate;
            }
          }
          if (line && y <= 205) tctx.fillText(line, 54, y);

          const T3:any = THREE;
          const texture = new T3.CanvasTexture(textureCanvas);
          const geometry = new T3.PlaneGeometry(settings.width, settings.height);
          const material = new T3.MeshBasicMaterial({
            map: texture,
            side: T3.DoubleSide,
            depthTest: true,
            depthWrite: true
          });
          const mesh = new T3.Mesh(geometry, material);
          mesh.renderOrder = 20;
          imageEntry.group.add(mesh);

          entry = { mesh, texture, signature };
          textPlanes.set(station.id, entry);
        } else if (entry.mesh.parent !== imageEntry.group) {
          entry.mesh.parent?.remove?.(entry.mesh);
          imageEntry.group.add(entry.mesh);
        }

        entry.mesh.visible = true;

        // Local transform relative to the real main-image object.
        // The plaque stays visually separate, but can no longer drift from the image frame.
        const imageHalfHeight = 5.9 * 0.5;
        entry.mesh.position.set(
          0,
          -(imageHalfHeight + settings.offsetY),
          settings.offsetZ
        );
        entry.mesh.rotation.order = "XYZ";
        entry.mesh.rotation.set(
          -Math.PI / 2 + settings.angleDegrees * Math.PI / 180,
          0,
          0
        );
      }

      function hideAllThreeObjects() {
        for (const model of threeObjects.values()) model.visible = false;
        for (const globe of debugGlobes.values()) globe.visible = false;
        for (const globe of envelopeDebugGlobes.values()) globe.visible = false;
      }

      function resolvedPlanePreviewPolicy(index: number): PlanePreviewPolicy {
        const stationId = stations[index]?.id;
        if (stationId && planePreviewPolicies[stationId]) {
          return planePreviewPolicies[stationId];
        }
        if (planePreviewPolicies.global) return planePreviewPolicies.global;

        // Default distance policy:
        // current plane = full scene (handled by drawStation)
        // immediately next plane = image + two GLB previews
        // every farther plane = image only
        if (index === arrivingAt + 1) {
          return { showGlbs: true, maxGlbs: 2, representation: "glb" };
        }
        return { showGlbs: false, maxGlbs: 0, representation: "glb" };
      }

      function drawStation(index: number, now: number) {
        const station = stations[index];
        const center = stationCenter(index);
        const cp = project(center);
        if (!cp || cp.depth > 54) return;

        const alpha = Math.max(.12, Math.min(1, 1 - cp.depth / 60));
        const current = index === arrivingAt;

        const stationObjects = layouts[index] ?? [];
        if (current) {
          for (const obj of stationObjects) {
            drawSceneObject(center, obj, alpha * .84, now);
          }
        } else {
          const preview = resolvedPlanePreviewPolicy(index);
          if (preview.showGlbs && preview.representation !== "icon") {
            const glbs = stationObjects.filter(
              (obj: SceneObject) =>
                obj.kind === "3d" &&
                obj.visible !== false
            );
            const count =
              preview.maxGlbs === "all"
                ? glbs.length
                : Math.max(0, Math.floor(Number(preview.maxGlbs) || 0));
            for (const obj of glbs.slice(0, count)) {
              drawSceneObject(center, obj, alpha * .84, now);
            }
          }
          // "icon" is intentionally reserved for the future lightweight
          // 2D-icon/GLB pairing system. Until then, icon mode means image-only.
        }

        // The main image is now a real 3D plane and the plaque is its child.
        const imageEntry = ensureMainImagePlane(station, center);
        ensureHorizontalTextPlane(station, imageEntry, current);
      }

      function arrived() {
        return Math.abs(cameraZ - targetZ) < 0.08;
      }

      function updateRailRideControl() {
        if (!railRideNext) return;
        const canRide = arrived() && !focusExperience && presentationSettings.editor.mode === "none";
        railRideNext.hidden = !canRide;
        if (!canRide) return;
        const nextIndex = arrivingAt + railRideDirection;
        const goingBack = railRideDirection < 0;
        railRideNext.textContent =
          goingBack
            ? "Take the Roller Coaster · Back"
            : "Take the Roller Coaster · Forward";
        railRideNext.setAttribute(
          "aria-label",
          `Take the roller coaster ${goingBack ? "backward" : "forward"} to ${stations[nextIndex]?.label ?? "the next plane"}`
        );
      }

      function requestStation(
        index: number,
        preservePendingFocus = false,
        travelMode: PlaneTravelMode = "teleport",
        customTravelId = ""
      ) {
        if (!preservePendingFocus) {
          pendingFocusPlaylistEntry = null;
          journeyEntries = [];
          journeyCursor = -1;
          journeyStationIndex = -1;
          resetPlaneResidencyProgress();
        }

        endFocusExperience();
        const nextIndex = Math.max(0, Math.min(stations.length - 1, index));
        arrivingAt = nextIndex;
        activeStationId = stations[arrivingAt]?.id ?? activeStationId;
        presentationSettings =
          stationSettings[activeStationId] ??
          defaultsForStation(stations[arrivingAt]);
        stationSettings[activeStationId] = presentationSettings;

        targetZ = stationZ(arrivingAt) + presentationSettings.camera.distanceFromCenter;

        if (travelMode === "teleport") {
          cameraZ = targetZ;
        } else if (travelMode === "custom") {
          const event = new CustomEvent("webrev:custom-plane-travel", {
            cancelable: true,
            detail: {
              customTravelId: String(customTravelId || ""),
              stationId: activeStationId,
              stationIndex: arrivingAt,
              targetZ,
              fallback: "roller-coaster"
            }
          });
          const handled = !window.dispatchEvent(event);
          if (!handled) {
            // Unhandled custom strategies degrade safely to the built-in ride.
            status && (status.textContent = `Riding to ${stations[arrivingAt].label}`);
          }
        } else {
          status && (status.textContent = `Riding to ${stations[arrivingAt].label}`);
        }

        paperTextOverride = null;
        if (travelMode === "teleport") {
          status && (status.textContent = `Moved to ${stations[arrivingAt].label}`);
        }
        renderSphereSettings();
      }

      requestStationFromApi = (index, mode, customTravelId = "") => {
        requestStation(index, false, mode, customTravelId);
      };

      function executeAction(action: AssetAction | undefined) {
        if (!action) return;
        if (action.type === "station") {
          const index = stations.findIndex((station: any) => station.id === action.stationId);
          if (index >= 0) requestStation(index, false, "teleport");
          return;
        }
        if (action.type === "link") {
          const destination = resolvedLinks[action.linkKey];
          if (typeof destination === "string") window.location.assign(destination);
          return;
        }
        if (action.type === "url") {
          if (typeof action.url === "string") window.location.assign(action.url);
          return;
        }
        if (action.type === "text") {
          paperTextOverride = { title: action.title, body: action.body };
        }
      }

      function findHitObject(x: number, y: number) {
        const objects = layouts[arrivingAt]
          .filter((obj: SceneObject) => obj.visible !== false && obj.lastScreen)
          .sort((a: SceneObject, b: SceneObject) => (a.lastScreen?.depth ?? 999) - (b.lastScreen?.depth ?? 999));

        for (const obj of objects) {
          const s = obj.lastScreen;
          if (!s) continue;
          if (Math.hypot(x - s.x, y - s.y) <= s.radius) return obj;
        }
        return null;
      }

      let focusAudioElement: HTMLAudioElement | null = null;
      let focusAudioFadeFrame = 0;
      let focusAudioSourceUrl = "";
      let focusAudioCurrentAssetName = "";

      function rememberPlayedTrack(url: string) {
        const track = trackCatalog().find(
          (candidate: { name: string; url: string }) => candidate.url === url
        );
        if (!track) return;
        playedTrackHistory.push(track.name);
        playedTrackLedger.add(track.name);
        const keep = Math.max(32, fallbackSongHistoryWindow + 16);
        if (playedTrackHistory.length > keep) {
          playedTrackHistory.splice(0, playedTrackHistory.length - keep);
        }
      }

      function recentPlayedTrackNames() {
        if (fallbackSongHistoryWindow <= 0) return new Set<string>();
        return new Set(playedTrackHistory.slice(-fallbackSongHistoryWindow));
      }

      function unheardTrackNames() {
        return new Set(
          trackCatalog()
            .map((track) => track.name)
            .filter((name) => !playedTrackLedger.has(name))
        );
      }

      function historyEligibleTracks(
        tracks: Array<{ name: string; url: string }>
      ) {
        const recent = recentPlayedTrackNames();
        const eligible = tracks.filter((track) => !recent.has(track.name));
        return eligible.length ? eligible : tracks;
      }

      function resolvedFocusPlaylist(): FocusPlaylistEntry[] {
        const tracks = Array.isArray(config.musicTracks) ? config.musicTracks : [];
        const trackUrl = new Map<string, string>(
          tracks
            .filter((track: any) => typeof track?.name === "string" && typeof track?.url === "string")
            .map((track: any) => [String(track.name), String(track.url)])
        );

        const effectiveScope =
          focusPlaybackProgram.scope === "station" ? "station" : "all";
        const stationIndexes =
          effectiveScope === "all"
            ? stations.map((_: any, index: number) => index)
            : [arrivingAt];

        const visibleGlbs: Array<{ stationId: string; stationIndex: number; assetName: string }> = [];
        for (const stationIndex of stationIndexes) {
          const station = stations[stationIndex];
          if (!station) continue;
          for (const obj of layouts[stationIndex] ?? []) {
            if (obj.kind !== "3d" || obj.visible === false) continue;
            visibleGlbs.push({
              stationId: station.id,
              stationIndex,
              assetName: obj.name
            });
          }
        }

        const base: FocusPlaylistEntry[] = [];
        if (visibleGlbs.length) {
          const pairedByTrack = new Map<string, typeof visibleGlbs[number]>();
          for (const visual of visibleGlbs) {
            const assigned =
              assetFocusAudioState[visual.assetName]?.track ??
              configuredAssetFocusTrack(visual.assetName);
            if (assigned && !pairedByTrack.has(assigned)) {
              pairedByTrack.set(assigned, visual);
            }
          }

          let fallbackIndex = 0;
          for (const track of tracks) {
            if (typeof track?.name !== "string" || typeof track?.url !== "string") continue;
            const paired = pairedByTrack.get(String(track.name));
            const visual = paired ?? visibleGlbs[fallbackIndex++ % visibleGlbs.length];
            base.push({
              stationId: visual.stationId,
              stationIndex: visual.stationIndex,
              assetName: visual.assetName,
              track: String(track.name),
              url: String(track.url)
            });
          }
        }

        const sequence = Array.isArray(focusPlaybackProgram.sequence)
          ? focusPlaybackProgram.sequence
          : [];
        const pools = Array.isArray(focusPlaybackProgram.pools)
          ? focusPlaybackProgram.pools
          : [];

        if (!sequence.length) return base;

        const byPool = new Map(
          pools.map((pool) => [String(pool.id), pool] as const)
        );
        const resolved: FocusPlaylistEntry[] = [];

        const appendMatches = (matches: FocusPlaylistEntry[], order: FocusPlaybackOrder = "ordered", repeat: number | "forever" = 1) => {
          const source = [...matches];
          if (order === "random") {
            for (let i = source.length - 1; i > 0; i--) {
              const j = Math.floor(Math.random() * (i + 1));
              [source[i], source[j]] = [source[j], source[i]];
            }
          }
          const count = repeat === "forever" ? 1 : Math.max(1, Math.floor(Number(repeat) || 1));
          for (let i = 0; i < count; i++) resolved.push(...source);
        };

        for (const token of sequence) {
          if (typeof token !== "string" || !token) continue;

          if (token.startsWith("pool:")) {
            const pool = byPool.get(token.slice(5));
            if (!pool) continue;
            const assets = new Set(pool.assets ?? []);
            const tracks = new Set(pool.tracks ?? []);
            const matches = base.filter((entry) =>
              (!assets.size || assets.has(entry.assetName)) &&
              (!tracks.size || tracks.has(entry.track))
            );
            appendMatches(
              matches,
              pool.order === "random" ? "random" : "ordered",
              pool.repeat ?? 1
            );
            continue;
          }

          if (token.startsWith("station:")) {
            appendMatches(base.filter((entry) => entry.stationId === token.slice(8)));
            continue;
          }
          if (token.startsWith("asset:")) {
            appendMatches(base.filter((entry) => entry.assetName === token.slice(6)));
            continue;
          }
          if (token.startsWith("track:")) {
            appendMatches(base.filter((entry) => entry.track === token.slice(6)));
            continue;
          }

          // Bare tokens are intentionally convenient: asset name first, then track.
          const assetMatches = base.filter((entry) => entry.assetName === token);
          appendMatches(
            assetMatches.length
              ? assetMatches
              : base.filter((entry) => entry.track === token)
          );
        }

        return resolved.length ? resolved : base;
      }

      function trackCatalog(): Array<{ name: string; url: string }> {
        return (Array.isArray(config.musicTracks) ? config.musicTracks : [])
          .filter((track: any) =>
            typeof track?.name === "string" &&
            typeof track?.url === "string"
          )
          .map((track: any) => ({
            name: String(track.name),
            url: String(track.url)
          }));
      }

      function globallyAssignedTrackNames() {
        const assigned = new Set<string>();
        for (const asset of allSceneAssetNames()) {
          if (asset.kind !== "3d") continue;
          const track =
            assetFocusAudioState[asset.name]?.track ??
            configuredAssetFocusTrack(asset.name);
          if (track) assigned.add(track);
        }
        return assigned;
      }

      function unassignedTracks() {
        const assigned = globallyAssignedTrackNames();
        return trackCatalog().filter((track: { name: string; url: string }) => !assigned.has(track.name));
      }

      function visiblePlaneGlbs(stationIndex = arrivingAt) {
        return (layouts[stationIndex] ?? [])
          .filter((obj: SceneObject) => obj.kind === "3d" && obj.visible !== false);
      }

      function pairedTrackNamesOnPlane(stationIndex = arrivingAt) {
        const names = new Set<string>();
        for (const obj of visiblePlaneGlbs(stationIndex)) {
          const assigned =
            assetFocusAudioState[obj.name]?.track ??
            configuredAssetFocusTrack(obj.name);
          if (assigned) names.add(assigned);
        }
        return names;
      }

      function focusTrackForObject(obj: SceneObject) {
        if (!presentationSettings.focusAudio.enabled) return null;

        const catalog = trackCatalog();
        if (!catalog.length) return null;

        const assigned =
          assetFocusAudioState[obj.name]?.track ??
          configuredAssetFocusTrack(obj.name);
        const excludedTracks = new Set(
          assetTrackExclusionsState[obj.name] ?? []
        );

        if (assigned && !excludedTracks.has(assigned)) {
          return catalog.find(
            (track: { name: string; url: string }) => track.name === assigned
          ) ?? null;
        }

        // Excluding an assigned song from this object makes this encounter fall
        // through to the object's fallback resolver without globally unassigning it.
        const fallbackPool = unassignedTracks().filter(
          (track: { name: string; url: string }) =>
            !excludedTracks.has(track.name)
        );
        if (!fallbackPool.length) return null;

        const recent = recentPlayedTrackNames();
        const planeSongs = avoidCurrentPlaneSongsForFallback
          ? new Set<string>([
              ...pairedTrackNamesOnPlane(arrivingAt),
              ...journeyPlanePlayedTracks
            ])
          : new Set<string>();
        const unheard = unheardTrackNames();

        // Tier 1: prefer genuinely new music while still respecting the two
        // strongest variety constraints: recent-history and current-plane reuse.
        let candidates = fallbackPool.filter(
          (track: { name: string; url: string }) =>
            unheard.has(track.name) &&
            !recent.has(track.name) &&
            !planeSongs.has(track.name)
        );

        // Tier 2: once the unheard pool is exhausted, allow previously heard
        // music but still enforce recent-history and current-plane avoidance.
        if (!candidates.length) {
          candidates = fallbackPool.filter(
            (track: { name: string; url: string }) =>
              !recent.has(track.name) &&
              !planeSongs.has(track.name)
          );
        }

        // If the catalog is too small for both minimum constraints, degrade
        // gracefully while never leaving the globally unassigned/object-safe pool.
        if (!candidates.length) {
          candidates = fallbackPool.filter(
            (track: { name: string; url: string }) => !recent.has(track.name)
          );
        }
        if (!candidates.length) {
          candidates = fallbackPool.filter(
            (track: { name: string; url: string }) => !planeSongs.has(track.name)
          );
        }
        if (!candidates.length) candidates = fallbackPool;

        return candidates[Math.floor(Math.random() * candidates.length)] ?? null;
      }

      function planeJourneyEntries(stationIndex: number) {
        const station = stations[stationIndex];
        if (!station) return [];

        return visiblePlaneGlbs(stationIndex).map((obj: SceneObject) => {
          const assigned =
            assetFocusAudioState[obj.name]?.track ??
            configuredAssetFocusTrack(obj.name);
          const paired = assigned
            ? trackCatalog().find(
                (track: { name: string; url: string }) =>
                  track.name === assigned
              )
            : null;

          return {
            stationId: station.id,
            stationIndex,
            assetName: obj.name,
            // Unpaired entries intentionally carry no preselected song.
            // Their eligible fallback is resolved fresh when the step is played.
            track: paired?.name ?? "",
            url: paired?.url ?? ""
          };
        });
      }

      function rotateJourneyEntries(
        entries: FocusPlaylistEntry[],
        assetName: string,
        trackName?: string
      ) {
        if (!entries.length) return [];
        let startIndex = entries.findIndex(
          (entry) =>
            entry.assetName === assetName &&
            (!trackName || entry.track === trackName)
        );
        if (startIndex < 0) {
          startIndex = entries.findIndex((entry) => entry.assetName === assetName);
        }
        if (startIndex < 0) startIndex = 0;
        return [...entries.slice(startIndex), ...entries.slice(0, startIndex)];
      }

      function resetPlaneResidencyProgress() {
        journeyPlaneSongCount = 0;
        journeyPlaneCyclesCompleted = 0;
        journeyPlanePlayedTracks.clear();
        journeyPlaneVisitedObjects.clear();
      }

      function currentPlaneEligibleObjectNames() {
        const entries =
          journeyStationIndex === arrivingAt && journeyEntries.length
            ? journeyEntries
            : planeJourneyEntries(arrivingAt);
        return [...new Set(entries.map((entry) => entry.assetName).filter(Boolean))];
      }

      function currentPlaneObjectCoverageComplete() {
        const eligible = currentPlaneEligibleObjectNames();
        if (!eligible.length) return true;
        return eligible.every((name) => journeyPlaneVisitedObjects.has(name));
      }

      function shouldRemainOnCurrentPlane() {
        const policy =
          focusPlaybackProgram.residency ??
          ({ mode: "cycles", value: 1 } as PlaneResidencyPolicy);

        if (policy.mode === "songs") {
          return journeyPlaneSongCount < Math.max(1, Math.floor(policy.value));
        }

        if (policy.mode === "coverage") {
          const available = Math.max(1, trackCatalog().length);
          const percent = (journeyPlanePlayedTracks.size / available) * 100;
          return percent < Math.max(1, Math.min(100, policy.value));
        }

        return journeyPlaneCyclesCompleted < Math.max(1, Math.floor(policy.value));
      }

      function playJourneyEntry(entry: FocusPlaylistEntry) {
        const obj = (layouts[entry.stationIndex] ?? []).find(
          (candidate: SceneObject) =>
            candidate.kind === "3d" &&
            candidate.visible !== false &&
            candidate.name === entry.assetName
        );
        if (!obj) return;

        // Resolve at playback time so paired tracks, object exclusions,
        // recent-history rules, and unpaired fallback selection all share one path.
        const chosen = focusTrackForObject(obj);

        journeyPlaneVisitedObjects.add(entry.assetName);

        if (chosen) {
          journeyPlaneSongCount += 1;
          journeyPlanePlayedTracks.add(chosen.name);
        }

        requestFocusExperience(
          obj,
          chosen ? { url: chosen.url, track: chosen.name } : undefined
        );
      }

      function beginJourneyFromObject(obj: SceneObject) {
        const track = focusTrackForObject(obj);
        const entries = planeJourneyEntries(arrivingAt);
        journeyEntries = rotateJourneyEntries(
          entries,
          obj.name,
          track?.name
        );
        journeyCursor = 0;
        journeyStationIndex = arrivingAt;
        resetPlaneResidencyProgress();

        const first = journeyEntries[0];
        if (first) {
          playJourneyEntry(first);
        } else {
          requestFocusExperience(
            obj,
            track ? { url: track.url, track: track.name } : undefined
          );
        }
      }

      function continueJourneyToNextPlane() {
        if (!stations.length) return;
        const fromStationIndex = arrivingAt;
        const nextStationIndex = (arrivingAt + 1) % stations.length;
        const fromStationId = stations[fromStationIndex]?.id ?? String(fromStationIndex);
        const toStationId = stations[nextStationIndex]?.id ?? String(nextStationIndex);
        const transitionId = `${fromStationId}→${toStationId}`;
        const transitionResource = resolveTransitionResourceInternal(transitionId);

        window.dispatchEvent(new CustomEvent("webrev:journey-transition", {
          detail: {
            transitionId,
            fromStationId,
            toStationId,
            completedJourneyCount,
            resource: transitionResource,
            policy: transitionResourcePolicy(transitionId)
          }
        }));

        if (
          fromStationIndex === stations.length - 1 &&
          nextStationIndex === 0
        ) {
          completedJourneyCount += 1;
          window.dispatchEvent(new CustomEvent("webrev:journey-completed", {
            detail: { completedJourneyCount }
          }));
        }

        const nextEntries = planeJourneyEntries(nextStationIndex);
        const next = nextEntries[0];

        journeyEntries = nextEntries;
        journeyCursor = next ? 0 : -1;
        journeyStationIndex = nextStationIndex;
        resetPlaneResidencyProgress();

        if (!next) {
          requestStation(
            nextStationIndex,
            false,
            focusPlaybackProgram.travelMode === "teleport" ||
              focusPlaybackProgram.travelMode === "custom"
              ? focusPlaybackProgram.travelMode
              : "roller-coaster",
            focusPlaybackProgram.customTravelId ?? ""
          );
          return;
        }

        pendingFocusPlaylistEntry = next;
        requestStation(
          nextStationIndex,
          true,
          focusPlaybackProgram.travelMode === "teleport" ||
            focusPlaybackProgram.travelMode === "custom"
            ? focusPlaybackProgram.travelMode
            : "roller-coaster",
          focusPlaybackProgram.customTravelId ?? ""
        );
      }

      function stepFocusObject(direction: -1 | 1) {
        if (!focusExperience) return;

        if (
          journeyStationIndex !== focusExperience.stationIndex ||
          !journeyEntries.length
        ) {
          const currentTrack = trackCatalog().find(
            (track: { name: string; url: string }) =>
              track.url === focusAudioSourceUrl
          );
          journeyEntries = rotateJourneyEntries(
            planeJourneyEntries(focusExperience.stationIndex),
            focusExperience.object.name,
            currentTrack?.name
          );
          journeyCursor = 0;
          journeyStationIndex = focusExperience.stationIndex;
        }

        if (!journeyEntries.length) return;

        // Always anchor manual navigation to the object that is actually in
        // focus. Cross-plane arrival, audio-driven advancement, or a rebuilt
        // layout must never leave the numeric cursor one step away from the
        // visual object the visitor is currently seeing.
        const focusedIndex = journeyEntries.findIndex(
          (entry) => entry.assetName === focusExperience?.object.name
        );
        if (focusedIndex >= 0) journeyCursor = focusedIndex;

        if (direction > 0) {
          if (journeyCursor >= journeyEntries.length - 1) {
            journeyPlaneCyclesCompleted += 1;
            journeyCursor = 0;
          } else {
            journeyCursor += 1;
          }
        } else {
          journeyCursor =
            journeyCursor <= 0
              ? journeyEntries.length - 1
              : journeyCursor - 1;
        }

        const next = journeyEntries[journeyCursor];
        if (!next) return;
        playJourneyEntry(next);

        window.dispatchEvent(new CustomEvent("webrev:focus-object-step", {
          detail: {
            direction,
            stationId: next.stationId,
            objectName: next.assetName,
            track: next.track,
            journeyIndex: journeyCursor,
            journeyLength: journeyEntries.length,
            visitedObjects: [...journeyPlaneVisitedObjects],
            objectCoverageComplete: currentPlaneObjectCoverageComplete()
          }
        }));
      }

      function selectedFocusTrackUrl(obj: SceneObject) {
        return focusTrackForObject(obj)?.url ?? "";
      }

      function stopFocusAudio() {
        disposeActiveMediaEnvelope();
        if (focusAudioFadeFrame) cancelAnimationFrame(focusAudioFadeFrame);
        focusAudioFadeFrame = 0;
        focusAudioSourceUrl = "";
        focusAudioCurrentAssetName = "";
        if (!focusAudioElement) return;
        focusAudioElement.pause();
        focusAudioElement.currentTime = 0;
        focusAudioElement = null;
      }

      function playFocusAudioSource(
        url: string,
        assetName: string,
        initialVolume = 0
      ) {
        stopFocusAudio();
        if (!url) return;

        const audio = new Audio(url);
        audio.preload = "auto";
        audio.loop = presentationSettings.focusAudio.playbackMode === "loop-item";
        audio.volume = Math.max(0, Math.min(1, initialVolume));
        focusAudioElement = audio;
        focusAudioSourceUrl = url;
        focusAudioCurrentAssetName = assetName;
        rememberPlayedTrack(url);

        const activeTrack = trackCatalog().find(
          (candidate: { name: string; url: string }) => candidate.url === url
        );
        if (activeTrack) {
          activateMediaEnvelopeForTrigger(
            { type: "song", trackId: activeTrack.name },
            {
              stationIndex: arrivingAt,
              focusedAssetName: assetName
            }
          );
        }

        audio.addEventListener("ended", () => {
          if (focusAudioElement !== audio) return;
          if (presentationSettings.focusAudio.playbackMode === "loop-item") return;
          advanceFocusPlaylist();
        });

        const playAttempt = audio.play();
        void playAttempt.catch((error) => {
          if (focusAudioElement !== audio) return;
          status && (status.textContent = `Audio waiting for interaction · ${assetName}`);
          window.dispatchEvent(new CustomEvent("webrev:focus-audio-playback-error", {
            detail: {
              assetName,
              url,
              message: error instanceof Error ? error.message : String(error)
            }
          }));
        });
      }

      function primeFocusAudio(obj: SceneObject) {
        const track = focusTrackForObject(obj);
        playFocusAudioSource(track?.url ?? "", obj.name, 0);
      }

      function advanceFocusPlaylist() {
        if (!focusExperience || presentationSettings.focusAudio.playbackMode === "loop-item") return;

        // While focused, song completion advances through the same song journey.
        // The roller coaster is entered only after every song on this plane has played once.
        if (focusExperience.stationIndex === arrivingAt) {
          stepFocusObject(1);
          return;
        }

        const playlist = resolvedFocusPlaylist();
        if (!playlist.length) return;

        let index = playlist.findIndex(
          (entry) =>
            entry.assetName === focusAudioCurrentAssetName &&
            entry.url === focusAudioSourceUrl
        );
        if (index < 0) {
          index = playlist.findIndex((entry) => entry.assetName === focusExperience?.object.name);
        }

        let next: FocusPlaylistEntry | undefined;
        if (focusPlaybackProgram.order === "random" && playlist.length > 1) {
          let nextIndex = Math.floor(Math.random() * playlist.length);
          if (nextIndex === index) nextIndex = (nextIndex + 1) % playlist.length;
          next = playlist[nextIndex];
        } else {
          next = playlist[(index + 1 + playlist.length) % playlist.length];
        }
        if (!next) return;

        // A playlist step is a complete visual+audio handoff. Crossing the end
        // of one plane naturally travels to the next; the final plane wraps
        // back to plane one because the playlist itself is circular.
        focusPlaylistEntry(next);
        window.dispatchEvent(new CustomEvent("webrev:focus-playlist-track", {
          detail: {
            mode: presentationSettings.focusAudio.playbackMode,
            scope: presentationSettings.focusAudio.scope,
            order: focusPlaybackProgram.order ?? "ordered",
            stationId: next.stationId,
            stationIndex: next.stationIndex,
            assetName: next.assetName,
            track: next.track
          }
        }));
      }

      function syncLiveFocusAudio() {
        if (!focusExperience) return;

        const selectedUrl = selectedFocusTrackUrl(focusExperience.object);
        if (!presentationSettings.focusAudio.enabled) {
          stopFocusAudio();
          return;
        }
        const desiredUrl =
          focusAudioElement && focusAudioSourceUrl
            ? (
                focusAudioCurrentAssetName === focusExperience.object.name
                  ? (selectedUrl || focusAudioSourceUrl)
                  : focusAudioSourceUrl
              )
            : selectedUrl;
        if (!desiredUrl) {
          stopFocusAudio();
          return;
        }

        if (focusAudioElement && focusAudioSourceUrl === desiredUrl) {
          focusAudioElement.loop =
            presentationSettings.focusAudio.playbackMode === "loop-item";
          if (focusExperience.settled) {
            if (focusAudioFadeFrame) cancelAnimationFrame(focusAudioFadeFrame);
            focusAudioFadeFrame = 0;
            focusAudioElement.volume = Math.max(
              0,
              Math.min(1, presentationSettings.focusAudio.volume)
            );
          }
          return;
        }

        primeFocusAudio(focusExperience.object);
        if (focusExperience.settled) fadeInFocusAudio();
      }

      function fadeInFocusAudio() {
        const audio = focusAudioElement;
        if (!audio || !presentationSettings.focusAudio.enabled) return;

        const targetVolume = Math.max(0, Math.min(1, presentationSettings.focusAudio.volume));
        const startVolume = Math.max(0, Math.min(targetVolume, audio.volume));
        const duration = Math.max(0, presentationSettings.focusAudio.fadeInMs);
        const startedAt = performance.now();

        if (duration === 0) {
          audio.volume = targetVolume;
          return;
        }

        const step = (now: number) => {
          if (focusAudioElement !== audio) return;
          const t = Math.min(1, (now - startedAt) / duration);
          audio.volume = startVolume + (targetVolume - startVolume) * t;
          if (t < 1) focusAudioFadeFrame = requestAnimationFrame(step);
          else focusAudioFadeFrame = 0;
        };
        focusAudioFadeFrame = requestAnimationFrame(step);
      }

      function fadeOutFocusAudio() {
        if (focusAudioFadeFrame) cancelAnimationFrame(focusAudioFadeFrame);
        focusAudioFadeFrame = 0;

        const audio = focusAudioElement;
        if (!audio) return;

        const startVolume = Math.max(0, Math.min(1, audio.volume));
        // Leaving the world should always feel like an exit, never an abrupt cut.
        // Keep the configured fade when it is meaningful, but protect against
        // stale/zero persisted values by falling back to the original 1.8s fade.
        const configuredDuration = Number(presentationSettings.focusAudio.fadeOutMs);
        const duration =
          Number.isFinite(configuredDuration) && configuredDuration > 0
            ? configuredDuration
            : 1800;
        const startedAt = performance.now();

        const finish = () => {
          if (focusAudioElement !== audio) return;
          audio.volume = 0;
          audio.pause();
          audio.currentTime = 0;
          focusAudioElement = null;
          focusAudioSourceUrl = "";
          focusAudioCurrentAssetName = "";
          focusAudioFadeFrame = 0;
        };

        if (startVolume === 0) {
          finish();
          return;
        }

        const step = (now: number) => {
          if (focusAudioElement !== audio) return;
          const t = Math.min(1, (now - startedAt) / duration);
          audio.volume = startVolume * (1 - t);
          if (t < 1) focusAudioFadeFrame = requestAnimationFrame(step);
          else finish();
        };
        focusAudioFadeFrame = requestAnimationFrame(step);
      }

      function beginFocusExperience(obj: SceneObject) {
        const stationIndex = arrivingAt;
        const radius = objectBodyRadius(obj);
        const normalCamera = cameraPosition();
        const baseLocal = { ...obj.local };
        const composition = solveFocusComposition({
          objectPosition: baseLocal,
          objectRadius: radius,
          normalCameraDistance: presentationSettings.camera.distanceFromCenter
        });

        focusExperience = {
          stationIndex,
          object: obj,
          side: composition.side,
          baseLocal,
          startSpin: obj.spin,
          startedAt: performance.now(),
          settled: false,
          cameraDistance: composition.cameraDistance,
          cameraOffsetX: composition.cameraOffsetX,
          cameraOffsetY: composition.cameraOffsetY,
          targetOffsetX: composition.targetOffsetX,
          targetOffsetY: composition.targetOffsetY,
          targetOffsetZ: composition.targetOffsetZ,
          textSide: composition.textSide,
          cameraStart: { ...normalCamera }
        };

        targetYaw = 0;
        targetPitch = 0;
      }

      function endFocusExperience() {
        fadeOutFocusAudio();
        if (!focusExperience) return;
        const obj = focusExperience.object;
        obj.local = { ...focusExperience.baseLocal };
        obj.velocity = { x: 0, y: 0, z: 0 };
        focusExperience = null;
        targetYaw = 0;
        targetPitch = 0;
      }

      function update(now: number, dt: number) {
        const editPose = hemisphereEditorPose();
        if (editPose) {
          targetYaw = editPose.yaw;
          targetPitch = editPose.pitch;
        } else if (focusExperience && focusExperience.stationIndex === arrivingAt) {
          const center = stationCenter(arrivingAt);
          const cam = cameraPosition();
          const target = {
            x: center.x + focusExperience.targetOffsetX,
            y: center.y + focusExperience.targetOffsetY,
            z: center.z + focusExperience.targetOffsetZ
          };
          const angles = lookAnglesAt(target, cam);
          targetYaw = angles.yaw;
          targetPitch = angles.pitch;

          if (!focusExperience.settled && now - focusExperience.startedAt >= 1450) {
            focusExperience.settled = true;
            fadeInFocusAudio();
            window.dispatchEvent(new CustomEvent("webrev:focus-experience-settled", {
              detail: {
                stationId: activeStationId,
                objectId: focusExperience.object.id,
                objectName: focusExperience.object.name,
                side: focusExperience.side,
                textSide: focusExperience.textSide
              }
            }));
          }
        } else if (presentationSettings.camera.mode === "locked") {
          targetYaw = 0;
          targetPitch = 0;
        }

        const dz = targetZ - cameraZ;
        if (Math.abs(dz) > 0.04) {
          cameraZ += Math.sign(dz) * Math.min(Math.abs(dz), rideSpeed * dt);
        } else {
          cameraZ = targetZ;
        }

        if (pendingFocusPlaylistEntry && arrived()) {
          const pending = pendingFocusPlaylistEntry;
          pendingFocusPlaylistEntry = null;
          const obj = (layouts[pending.stationIndex] ?? []).find(
            (candidate: SceneObject) =>
              candidate.kind === "3d" &&
              candidate.visible !== false &&
              candidate.name === pending.assetName
          );
          if (obj) {
            const pendingIndex = journeyEntries.findIndex(
              (entry) => entry.assetName === pending.assetName
            );
            if (pendingIndex >= 0) journeyCursor = pendingIndex;

            // Reuse normal journey playback so dynamic fallback selection,
            // history accounting, exclusions, and focused-object state all
            // stay synchronized after a roller-coaster arrival.
            playJourneyEntry(
              pendingIndex >= 0 ? journeyEntries[pendingIndex] : pending
            );
          }
        }

        lookYaw += (targetYaw - lookYaw) * Math.min(1, dt * 4.0);
        lookPitch += (targetPitch - lookPitch) * Math.min(1, dt * 4.0);
        updateObjects(now, dt);
      }

      function drawHud() {
        ctx.save();
        ctx.fillStyle = "rgba(255,255,255,.88)";
        ctx.font = "600 14px ui-sans-serif, system-ui";
        ctx.fillText("Do It Your Way", 24, 30);
        ctx.fillStyle = "rgba(255,255,255,.48)";
        ctx.font = "12px ui-sans-serif, system-ui";
        ctx.fillText("PRISM RAIL / TOP FACE", 24, 50);

        const mouseHint =
          presentationSettings.camera.mode === "locked"
            ? ""
            : presentationSettings.camera.mode === "focus"
              ? " · move mouse to look"
              : " · move mouse for free look";
        const hint = focusExperience && focusExperience.stationIndex === arrivingAt
          ? focusExperience.settled
            ? `COME INTO OUR WORLD · ${focusExperience.object.name} · ${presentationSettings.focusAudio.playbackMode === "loop-item" ? "LOOP THIS SONG" : "PLAY ALL SONGS"} · right-click for music / leave`
            : `COMING CLOSER · ${focusExperience.object.name}`
          : arrived()
          ? presentationSettings.editor.mode === "hemisphere"
            ? `HEMISPHERE EDITOR · ${presentationSettings.editor.hemisphere.toUpperCase()} · right-click for cameras/reposition`
            : presentationSettings.interaction.contextMenuMode === "edit"
              ? `Explore the monument · right-click for edit tools · drag/toss objects${mouseHint} · ← → ride`
              : `Explore the monument · right-click a 3D object to Come Into Our World${mouseHint} · ← → ride`
          : "Riding the thread…";

        ctx.textAlign = "center";
        ctx.fillText(hint, width * .5, height - 24);
        ctx.textAlign = "right";
        ctx.fillText(`${arrivingAt + 1} / ${stations.length}`, width - 24, 30);
        ctx.restore();
      }

      function render(now: number) {
        resize();
        const dt = Math.min((now - previous) / 1000, 1 / 30);
        previous = now;
        update(now, dt);
        updateRailRideControl();

        for (const model of threeObjects.values()) model.visible = false;
        for (const entry of imagePlanes.values()) entry.group.visible = false;
        for (const entry of textPlanes.values()) entry.mesh.visible = false;
        for (const globe of debugGlobes.values()) globe.visible = false;
        for (const globe of envelopeDebugGlobes.values()) globe.visible = false;
        for (const occluder of occluders.values()) occluder.visible = false;
        for (const layout of layouts) {
          for (const obj of layout) obj.lastScreen = undefined;
        }

        drawBackground();
        drawRail();

        const drawOrder = stations
          .map((_: any, index: number) => index)
          .sort((a: number, b: number) => stationZ(a) - stationZ(b));

        for (const index of drawOrder) drawStation(index, now);

        if (threeRenderer && threeScene && threeCamera) {
          updateActiveMediaEnvelope();
          const cam = cameraPosition();
          threeCamera.position.set(cam.x, cam.y, cam.z);

          if (focusExperience && focusExperience.stationIndex === arrivingAt) {
            const center = stationCenter(arrivingAt);
            const target = {
              x: center.x + focusExperience.targetOffsetX,
              y: center.y + focusExperience.targetOffsetY,
              z: center.z + focusExperience.targetOffsetZ
            };
            const basis = screenBasis(target, cam);
            const T3: any = THREE;
            const matrix = new T3.Matrix4().makeBasis(
              new T3.Vector3(basis.right.x, basis.right.y, basis.right.z),
              new T3.Vector3(basis.up.x, basis.up.y, basis.up.z),
              new T3.Vector3(-basis.forward.x, -basis.forward.y, -basis.forward.z)
            );
            threeCamera.quaternion.setFromRotationMatrix(matrix);
          } else if (presentationSettings.editor.mode === "hemisphere") {
            // Use the exact same camera basis as the editor's projection math.
            // Three.js cameras look down local -Z, so the third basis vector is -forward.
            const center = stationCenter(arrivingAt);
            const basis = screenBasis(center, cam);
            const T3: any = THREE;
            const matrix = new T3.Matrix4().makeBasis(
              new T3.Vector3(basis.right.x, basis.right.y, basis.right.z),
              new T3.Vector3(basis.up.x, basis.up.y, basis.up.z),
              new T3.Vector3(-basis.forward.x, -basis.forward.y, -basis.forward.z)
            );
            threeCamera.quaternion.setFromRotationMatrix(matrix);
          } else {
            threeCamera.rotation.order = "YXZ";
            threeCamera.rotation.set(lookPitch, lookYaw, 0);
          }

          threeRenderer.render(threeScene, threeCamera);
        }

        const vignette = ctx.createRadialGradient(
          width * .5, height * .5, Math.min(width, height) * .25,
          width * .5, height * .5, Math.max(width, height) * .72
        );
        vignette.addColorStop(0, "rgba(0,0,0,0)");
        vignette.addColorStop(1, "rgba(0,0,0,.6)");
        ctx.fillStyle = vignette;
        ctx.fillRect(0, 0, width, height);

        drawHud();
        requestAnimationFrame(render);
      }

      function pointIn(rect: { x: number; y: number; w: number; h: number } | null, x: number, y: number) {
        return !!rect && x >= rect.x && x <= rect.x + rect.w && y >= rect.y && y <= rect.y + rect.h;
      }

      function closeEditContextMenu() {
        if (editContextMenu) editContextMenu.hidden = true;
      }

      function addEditContextAction(label: string, action: () => void, active = false) {
        if (!editContextMenu) return;
        const button = document.createElement("button");
        button.type = "button";
        button.className = active ? "edit-context-action is-active" : "edit-context-action";
        button.textContent = label;
        button.addEventListener("click", () => {
          action();
          closeEditContextMenu();
        });
        editContextMenu.appendChild(button);
      }

      function requestFocusExperience(
        obj: SceneObject,
        audioOverride?: { url: string; track: string }
      ) {
        // A direct object selection uses its saved pairing. Playlist overflow may
        // temporarily display this GLB for an unpaired song without changing the pairing.
        if (audioOverride?.url) {
          playFocusAudioSource(audioOverride.url, obj.name, 0);
        } else {
          primeFocusAudio(obj);
        }
        beginFocusExperience(obj);
        window.dispatchEvent(new CustomEvent("webrev:focus-experience-request", {
          detail: {
            stationId: activeStationId,
            objectId: obj.id,
            objectName: obj.name,
            side: focusExperience?.side,
            textSide: focusExperience?.textSide,
            action: "come-into-our-world"
          }
        }));
        status && (status.textContent = `Come Into Our World · ${obj.name}`);
      }

      function focusPlaylistEntry(entry: FocusPlaylistEntry | undefined) {
        if (!entry) return;
        if (entry.stationIndex !== arrivingAt) {
          // Cross-plane playback must preserve the journey itself: ride the
          // visible prism/string route first, then enter the destination object
          // only after the camera has physically arrived at that plane.
          pendingFocusPlaylistEntry = entry;
          requestStation(
            entry.stationIndex,
            true,
            focusPlaybackProgram.travelMode === "teleport" ||
              focusPlaybackProgram.travelMode === "custom"
              ? focusPlaybackProgram.travelMode
              : "roller-coaster",
            focusPlaybackProgram.customTravelId ?? ""
          );
          presentationSettings.focusAudio.scope =
            focusPlaybackProgram.scope === "station" ? "station" : "all";
          presentationSettings.focusAudio.playbackMode = "zone-cycle";
          return;
        }

        const obj = (layouts[entry.stationIndex] ?? []).find(
          (candidate: SceneObject) =>
            candidate.kind === "3d" &&
            candidate.visible !== false &&
            candidate.name === entry.assetName
        );
        if (!obj) return;
        requestFocusExperience(obj, { url: entry.url, track: entry.track });
      }

      function stepFocusPlaylist(direction: -1 | 1) {
        const playlist = resolvedFocusPlaylist();
        if (!playlist.length) return;

        let index = playlist.findIndex(
          (entry) =>
            entry.assetName === focusAudioCurrentAssetName &&
            entry.url === focusAudioSourceUrl
        );
        if (index < 0 && focusExperience) {
          index = playlist.findIndex(
            (entry) => entry.assetName === focusExperience?.object.name
          );
        }
        if (index < 0) index = direction > 0 ? -1 : 0;

        const nextIndex =
          (index + direction + playlist.length) % playlist.length;
        focusPlaylistEntry(playlist[nextIndex]);
      }

      function randomizeFocusPlaylist() {
        const api = window.webrevPresentationSettings;
        api?.setFocusPlaybackOrder(
          focusPlaybackProgram.order === "random" ? "ordered" : "random"
        );
      }

      function addContextSongPicker() {
        if (!editContextMenu) return;
        const previousScope = presentationSettings.focusAudio.scope;
        presentationSettings.focusAudio.scope = "all";
        const playlist = resolvedFocusPlaylist();
        presentationSettings.focusAudio.scope = previousScope;
        if (!playlist.length) return;

        const wrap = document.createElement("label");
        wrap.className = "edit-context-song-picker";

        const label = document.createElement("span");
        label.textContent = "Jump to song";

        const select = document.createElement("select");
        select.setAttribute("aria-label", "Jump to song");

        const placeholder = document.createElement("option");
        placeholder.value = "";
        placeholder.textContent = "Choose a song…";
        select.appendChild(placeholder);

        playlist.forEach((entry, index) => {
          const option = document.createElement("option");
          option.value = String(index);
          const stationLabel = stations[entry.stationIndex]?.label ?? entry.stationId;
          option.textContent = `${entry.track.replace(/\.[^.]+$/, "")} · ${stationLabel}`;
          select.appendChild(option);
        });

        select.addEventListener("change", () => {
          const index = Number(select.value);
          if (!Number.isInteger(index) || index < 0 || index >= playlist.length) return;
          focusPlaylistEntry(playlist[index]);
          closeEditContextMenu();
        });

        wrap.append(label, select);
        editContextMenu.appendChild(wrap);
      }

      function openExperienceContextMenu(clientX: number, clientY: number, obj: SceneObject | null) {
        if (!editContextMenu) return;
        editContextMenu.replaceChildren();

        const api = window.webrevPresentationSettings;
        const heading = document.createElement("div");
        heading.className = "edit-context-heading";
        heading.textContent = "Music";
        editContextMenu.appendChild(heading);

        addContextSongPicker();
        addEditContextAction("Previous Song", () => stepFocusPlaylist(-1));
        addEditContextAction("Next Song", () => stepFocusPlaylist(1));
        addEditContextAction(
          "Loop Plane",
          () => {
            api?.setFocusPlaybackScope("station");
            api?.setFocusPlaybackMode("zone-cycle");
            focusPlaybackProgram = { ...focusPlaybackProgram, scope: "station" };
          },
          presentationSettings.focusAudio.scope === "station" &&
            presentationSettings.focusAudio.playbackMode === "zone-cycle"
        );
        addEditContextAction(
          "Loop All",
          () => {
            api?.setFocusPlaybackScope("all");
            api?.setFocusPlaybackMode("zone-cycle");
            focusPlaybackProgram = { ...focusPlaybackProgram, scope: "all" };
          },
          presentationSettings.focusAudio.scope === "all" &&
            presentationSettings.focusAudio.playbackMode === "zone-cycle"
        );
        addEditContextAction(
          focusPlaybackProgram.order === "random" ? "Randomize ✓" : "Randomize",
          () => randomizeFocusPlaylist(),
          focusPlaybackProgram.order === "random"
        );

        if (focusExperience && focusExperience.stationIndex === arrivingAt) {
          addEditContextAction("Leave for now <3", () => endFocusExperience());
        }

        if (obj?.kind === "3d") {
          const objectHeading = document.createElement("div");
          objectHeading.className = "edit-context-heading";
          objectHeading.textContent = obj.name;
          editContextMenu.appendChild(objectHeading);
          addEditContextAction("Play This", () => beginJourneyFromObject(obj));
        }

        editContextMenu.style.left = `${Math.max(8, Math.min(window.innerWidth - 290, clientX))}px`;
        editContextMenu.style.top = `${Math.max(8, Math.min(window.innerHeight - 360, clientY))}px`;
        editContextMenu.hidden = false;
      }

      function openEditContextMenu(clientX: number, clientY: number, obj: SceneObject | null) {
        if (!editContextMenu) return;
        const api = window.webrevPresentationSettings;
        if (!api) return;

        editContextMenu.replaceChildren();
        const editor = api.getEditorState();

        addEditContextAction(
          "Hemisphere Editor · Front",
          () => api.setEditorMode("hemisphere", "front"),
          editor.mode === "hemisphere" && editor.hemisphere === "front"
        );
        addEditContextAction(
          "Hemisphere Editor · Back",
          () => api.setEditorMode("hemisphere", "back"),
          editor.mode === "hemisphere" && editor.hemisphere === "back"
        );
        addEditContextAction(
          "Exit Edit Layer",
          () => api.setEditorMode("none"),
          editor.mode === "none"
        );

        if (obj) {
          const repositioning =
            editor.mode === "hemisphere" &&
            editor.repositionObjectName === obj.name;
          addEditContextAction(
            `Reposition ${repositioning ? "OFF" : "ON"} · ${obj.name}`,
            () => {
              if (editor.mode !== "hemisphere") {
                api.setEditorMode("hemisphere", obj.hemisphere === "back" ? "back" : "front");
              }
              api.setRepositionObject(repositioning ? null : obj.name);
            },
            repositioning
          );
        }

        const heading = document.createElement("div");
        heading.className = "edit-context-heading";
        heading.textContent = "Hemisphere camera";
        editContextMenu.appendChild(heading);

        for (const preset of api.listEditorCameraPresets()) {
          addEditContextAction(
            preset.label,
            () => {
              if (api.getEditorState().mode !== "hemisphere") api.setEditorMode("hemisphere", "front");
              api.setEditorCameraPreset(preset.id);
            },
            editor.mode === "hemisphere" && editor.cameraPreset === preset.id
          );
        }

        editContextMenu.style.left = `${Math.max(8, Math.min(window.innerWidth - 270, clientX))}px`;
        editContextMenu.style.top = `${Math.max(8, Math.min(window.innerHeight - 340, clientY))}px`;
        editContextMenu.hidden = false;
      }

      gameCanvas.addEventListener("contextmenu", (event) => {
        event.preventDefault();
        const rect = gameCanvas.getBoundingClientRect();
        const obj = findHitObject(event.clientX - rect.left, event.clientY - rect.top);

        if (presentationSettings.interaction.contextMenuMode === "edit") {
          openEditContextMenu(event.clientX, event.clientY, obj);
        } else {
          openExperienceContextMenu(event.clientX, event.clientY, obj);
        }
      });

      window.addEventListener("pointerdown", (event) => {
        if (!editContextMenu || editContextMenu.hidden) return;
        if (event.target instanceof Node && editContextMenu.contains(event.target)) return;
        closeEditContextMenu();
      });

      gameCanvas.addEventListener("pointerdown", (event) => {
        if (!arrived()) return;
        const rect = gameCanvas.getBoundingClientRect();
        pointerX = event.clientX - rect.left;
        pointerY = event.clientY - rect.top;

        const obj = findHitObject(pointerX, pointerY);
        if (obj) {
          if (focusExperience?.object === obj) return;
          if (presentationSettings.editor.mode === "hemisphere") {
            if (presentationSettings.editor.repositionObjectName !== obj.name) return;
            if (obj.hemisphere !== presentationSettings.editor.hemisphere) return;
          } else if (obj.motion.type === "fixed" && obj.motion.fixedMode === "anchored") {
            return;
          }
          grabbed = { stationIndex: arrivingAt, object: obj };
          dragLastX = pointerX;
          dragLastY = pointerY;
          dragLastTime = performance.now();
          draggedDistance = 0;
          gameCanvas.setPointerCapture(event.pointerId);
        }
      });

      gameCanvas.addEventListener("pointermove", (event) => {
        const rect = gameCanvas.getBoundingClientRect();
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;
        pointerX = x;
        pointerY = y;

        if (grabbed) {
          const now = performance.now();
          const dt = Math.max((now - dragLastTime) / 1000, 0.001);
          const dx = x - dragLastX;
          const dy = y - dragLastY;
          const obj = grabbed.object;
          const sensitivity = 0.012;
          if (presentationSettings.editor.mode === "hemisphere") {
            const pose = hemisphereEditorPose();
            if (pose) {
              const basis = screenBasis(pose.center, pose.position);
              const sx = dx * sensitivity;
              const sy = -dy * sensitivity;
              obj.local.x += basis.right.x * sx + basis.up.x * sy;
              obj.local.y += basis.right.y * sx + basis.up.y * sy;
              obj.local.z += basis.right.z * sx + basis.up.z * sy;
            }
          } else {
            obj.local.x += dx * sensitivity;
            obj.local.y -= dy * sensitivity;
          }

          if (presentationSettings.editor.mode === "hemisphere") {
            obj.anchor = { ...obj.local };
            obj.anchorMode = "absolute";
            obj.anchorOffset = { x: 0, y: 0, z: 0 };
            obj.velocity = { x: 0, y: 0, z: 0 };
          } else if (obj.motion.type === "fixed") {
            obj.anchor = { ...obj.local };
            obj.anchorMode = "absolute";
            obj.anchorOffset = { x: 0, y: 0, z: 0 };
            obj.velocity = { x: 0, y: 0, z: 0 };
          } else {
            const maxToss = Number(motion.maxTossSpeed) || 2.6;
            obj.velocity.x = Math.max(-maxToss, Math.min(maxToss, (dx / dt) * 0.0025));
            obj.velocity.y = Math.max(-maxToss, Math.min(maxToss, (-dy / dt) * 0.0025));
          }
          draggedDistance += Math.hypot(dx, dy);
          solveObjectBounds(grabbed.stationIndex, obj);

          dragLastX = x;
          dragLastY = y;
          dragLastTime = now;
          gameCanvas.style.cursor = "grabbing";
          return;
        }

        if (presentationSettings.editor.mode === "none" && presentationSettings.camera.mode !== "locked") {
          const nx = x / Math.max(1, rect.width) - .5;
          const ny = y / Math.max(1, rect.height) - .5;

          if (presentationSettings.camera.mode === "focus") {
            // Limited look mode: keep the center image inside the viewport.
            targetYaw = nx * .34;
            targetPitch = -ny * .20;
          } else {
            // Free mode: full yaw rotation and a wide pitch range.
            targetYaw = nx * Math.PI * 2;
            targetPitch = Math.max(
              -Math.PI * 0.49,
              Math.min(Math.PI * 0.49, -ny * Math.PI)
            );
          }
        }

        const hover = findHitObject(x, y);
        gameCanvas.style.cursor = hover ? "pointer" : "crosshair";
      });

      function releasePointer(event: PointerEvent) {
        if (!grabbed) return;
        const obj = grabbed.object;
        const wasClick = draggedDistance < 6;
        grabbed = null;
        if (gameCanvas.hasPointerCapture(event.pointerId)) gameCanvas.releasePointerCapture(event.pointerId);
        if (
          wasClick &&
          obj.kind === "3d" &&
          obj.visible !== false &&
          journeyClickStartEnabled
        ) {
          beginJourneyFromObject(obj);
        } else if (wasClick && obj.kind !== "3d") {
          executeAction(obj.action);
        }
      }

      gameCanvas.addEventListener("pointerup", releasePointer);
      gameCanvas.addEventListener("pointercancel", releasePointer);

      gameCanvas.addEventListener("pointerleave", () => {
        if (!grabbed && presentationSettings.camera.mode === "focus") {
          targetYaw = 0;
          targetPitch = 0;
        }
      });

      const retryFocusAudioFromGesture = () => {
        const audio = focusAudioElement;
        if (!audio || !audio.paused || !focusAudioSourceUrl) return;
        void audio.play().then(() => {
          if (focusExperience?.settled) fadeInFocusAudio();
        }).catch(() => {});
      };

      gameCanvas.addEventListener("pointerdown", retryFocusAudioFromGesture, { capture: true });

      gameCanvas.addEventListener("click", (event) => {
        if (!arrived() || draggedDistance >= 6) return;
        const rect = gameCanvas.getBoundingClientRect();
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;
        const hit = findHitObject(x, y);
        if (hit) {
          if (
            hit.kind === "3d" &&
            hit.visible !== false &&
            journeyClickStartEnabled
          ) {
            const track = focusTrackForObject(hit);
            beginJourneyFromObject(hit);
            status && (status.textContent =
              track
                ? `Playing ${track.name.replace(/\.[^.]+$/, "")} · ${hit.name}`
                : `Come Into Our World · ${hit.name}`
            );
          }
          return;
        }
      });

      focusSongPrev?.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        if (focusExperience) stepFocusObject(-1);
        else stepFocusPlaylist(-1);
      });

      focusSongNext?.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        if (focusExperience) stepFocusObject(1);
        else stepFocusPlaylist(1);
      });

      railRideNext?.addEventListener("click", () => {
        if (!arrived() || focusExperience || stations.length < 2) return;

        if (arrivingAt >= stations.length - 1) railRideDirection = -1;
        else if (arrivingAt <= 0) railRideDirection = 1;

        requestStation(arrivingAt + railRideDirection, false, "roller-coaster");
      });

      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          event.preventDefault();
          closeEditContextMenu();
          if (focusExperience && focusExperience.stationIndex === arrivingAt) {
            endFocusExperience();
            status && (status.textContent = `Back at ${stations[arrivingAt]?.label ?? "this plane"}`);
          }
          return;
        }

        // Project navigation policy:
        // Left/Right are exclusively for object iteration on the current plane.
        // Up/Down are exclusively for plane travel. This removes the ambiguous
        // behavior where ArrowRight could mean either "next object" or
        // "next plane" depending on transient focus state.
        if (event.key === "ArrowRight" || event.key === "ArrowLeft") {
          event.preventDefault();
          const direction: -1 | 1 = event.key === "ArrowRight" ? 1 : -1;

          if (focusExperience) {
            stepFocusObject(direction);
            return;
          }

          const entries = planeJourneyEntries(arrivingAt);
          const seed = direction > 0 ? entries[0] : entries[entries.length - 1];
          if (seed) playJourneyEntry(seed);
          return;
        }

        if (event.key === "ArrowUp") {
          event.preventDefault();
          if (focusExperience) endFocusExperience();
          railRideDirection = 1;
          requestStation(
            Math.min(stations.length - 1, arrivingAt + 1),
            false,
            "teleport"
          );
          return;
        }

        if (event.key === "ArrowDown") {
          event.preventDefault();
          if (focusExperience) endFocusExperience();
          railRideDirection = -1;
          requestStation(
            Math.max(0, arrivingAt - 1),
            false,
            "teleport"
          );
          return;
        }

        if (event.key === "Home") requestStation(0, false, "teleport");
      });

      // v2 demo default: ordered songs across every plane, wrapping forever.
      presentationSettings.focusAudio.scope = "all";
      presentationSettings.focusAudio.playbackMode = "zone-cycle";
      focusPlaybackProgram = {
        ...focusPlaybackProgram,
        scope: "all",
        order: "ordered"
      };
      requestStation(0, false, "teleport");
      requestAnimationFrame(render);
    }
  }
</script>

