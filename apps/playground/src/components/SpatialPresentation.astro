    function normalizeUnpairedGlbPolicy(
      value: UnpairedGlbCountPolicy
    ): UnpairedGlbCountPolicy {
      if (value === "all") return "all";
      if (typeof value === "number") {
        return Math.max(0, Math.floor(Number(value) || 0));
      }
      const rawMin = Math.max(0, Math.floor(Number(value?.min) || 0));
      const rawMax = Math.max(0, Math.floor(Number(value?.max) || 0));
      return {
        mode: "range",
        min: Math.min(rawMin, rawMax),
        max: Math.max(rawMin, rawMax)
      };
    }

    function resolvedUnpairedGlbLimit(stationId?: string): UnpairedGlbCountPolicy {
      const specific = stationId ? unpairedGlbLimits[stationId] : undefined;
      if (specific != null) return normalizeUnpairedGlbPolicy(specific);
      return normalizeUnpairedGlbPolicy(
        unpairedGlbLimits.global ?? { mode: "range", min: 3, max: 5 }
      );
    }

    function resolveUnpairedGlbCount(
      policy: UnpairedGlbCountPolicy,
      rand: () => number
    ) {
      if (policy === "all") return "all" as const;
      if (typeof policy === "number") return policy;
      const min = Math.max(0, Math.floor(policy.min));
      const max = Math.max(min, Math.floor(policy.max));
      return min + Math.floor(rand() * (max - min + 1));
    }

