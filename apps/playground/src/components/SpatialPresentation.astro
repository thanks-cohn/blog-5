    function resolvedFocusPlaylistForApi(): FocusPlaylistEntry[] {
      const tracks = (Array.isArray(config.musicTracks) ? config.musicTracks : [])
        .filter((track: any) => typeof track?.name === "string" && typeof track?.url === "string");
      const stationIndexes =
        presentationSettings.focusAudio.scope === "all"
          ? stationDefinitions.map((_: any, index: number) => index)
          : [Math.max(0, stationDefinitions.findIndex((station: any) => station.id === activeStationId))];

      const glbs = allSceneAssetNames()
        .filter((asset) =>
          asset.uploaded &&
          asset.kind === "3d" &&
          stationIndexes.includes(
            stationDefinitions.findIndex((station: any) => station.id === asset.stationId)
          )
        );

      if (!glbs.length) return [];

      const pairedByTrack = new Map<string, typeof glbs[number]>();
      for (const asset of glbs) {
        const assigned = assetFocusAudioState[asset.name]?.track ?? configuredAssetFocusTrack(asset.name);
        if (assigned && !pairedByTrack.has(assigned)) pairedByTrack.set(assigned, asset);
      }

      let fallbackIndex = 0;
      return tracks.map((track: any) => {
        const paired = pairedByTrack.get(String(track.name));
        const asset = paired ?? glbs[fallbackIndex++ % glbs.length];
        const stationIndex = Math.max(
          0,
          stationDefinitions.findIndex((station: any) => station.id === asset.stationId)
        );
        return {
          stationId: asset.stationId,
          stationIndex,
          assetName: asset.name,
          track: String(track.name),
          url: String(track.url)
        };
      });
    }

