  function publishGlbRuntimeStatus(obj: SceneObject, status: GlbRuntimeStatus, error?: unknown) {
    glbRuntimeStatus.set(obj.name, status);
    if (error != null) {
      const message = error instanceof Error ? error.message : String(error);
      glbRuntimeError.set(obj.name, message);
    } else if (status === "loaded" || status === "loading") {
      glbRuntimeError.delete(obj.name);
    }
    window.dispatchEvent(new CustomEvent("webrev:asset-runtime-status", {
      detail: {
        name: obj.name,
        status,
        attempts: threeLoadAttempts.get(obj.id) ?? 0,
        lastError: glbRuntimeError.get(obj.name)
      }
    }));
  }

  function ensureThreeObject(obj: SceneObject) {
    if (!obj.url || obj.kind !== "3d" || !gltfLoader || !threeScene || threeObjects.has(obj.id) || threeLoading.has(obj.id)) return;

    const now = performance.now();
    const retryAt = threeRetryAt.get(obj.id) ?? 0;
    if (now < retryAt) return;

    threeLoading.add(obj.id);
    publishGlbRuntimeStatus(obj, "loading");
    gltfLoader.load(
      obj.url,
      (gltf: any) => {
        const T3: any = THREE;
        const root: any = gltf.scene;
        const sourceBox: any = new T3.Box3().setFromObject(root);
        const sourceCenter: any = sourceBox.getCenter(new T3.Vector3());
        const sourceSize: any = sourceBox.getSize(new T3.Vector3());
        const maxDimension = Math.max(sourceSize.x, sourceSize.y, sourceSize.z) || 1;
        const normalizationScale = 2 / maxDimension;

        // IMPORTANT: centering and scaling must live on separate transform nodes.
        // A single node computes T * R * S, which would leave a source model whose
        // bounding-box center is far from its origin visibly offset from the logical
        // object center used by the hemisphere solver.
        const centerer: any = new T3.Group();
        root.position.x -= sourceCenter.x;
        root.position.y -= sourceCenter.y;
        root.position.z -= sourceCenter.z;
        centerer.add(root);

        const normalizer: any = new T3.Group();
        normalizer.scale.setScalar(normalizationScale);
        normalizer.add(centerer);
        normalizer.updateMatrixWorld(true);

        // Bounds are now measured around the same origin used by hemisphere math.
        const normalizedBox: any = new T3.Box3().setFromObject(normalizer);
        const normalizedCenter: any = normalizedBox.getCenter(new T3.Vector3());
        const centeredTolerance = 0.0005;
        if (
          Math.abs(normalizedCenter.x) > centeredTolerance ||
          Math.abs(normalizedCenter.y) > centeredTolerance ||
          Math.abs(normalizedCenter.z) > centeredTolerance
        ) {
          // Compensate any residual transform inherited from the source scene.
          centerer.position.x -= normalizedCenter.x / normalizationScale;
          centerer.position.y -= normalizedCenter.y / normalizationScale;
          centerer.position.z -= normalizedCenter.z / normalizationScale;
          normalizer.updateMatrixWorld(true);
        }

        const finalBox: any = new T3.Box3().setFromObject(normalizer);
        obj.modelBounds = {
          min: {
            x: finalBox.min.x,
            y: finalBox.min.y,
            z: finalBox.min.z
          },
          max: {
            x: finalBox.max.x,
            y: finalBox.max.y,
            z: finalBox.max.z
          }
        };
        const normalizedSphere: any = finalBox.getBoundingSphere(new T3.Sphere());
        obj.modelRadius = normalizedSphere.radius;

        const group: any = new T3.Group();
        group.add(normalizer);
        group.visible = false;
        threeScene.add(group);
        threeObjects.set(obj.id, group);
        threeLoading.delete(obj.id);
        threeLoadAttempts.delete(obj.id);
        threeRetryAt.delete(obj.id);
        publishGlbRuntimeStatus(obj, "loaded");
      },
      undefined,
      (error: any) => {
        threeLoading.delete(obj.id);
        const attempt = (threeLoadAttempts.get(obj.id) ?? 0) + 1;
        threeLoadAttempts.set(obj.id, attempt);
        const retryDelay = Math.min(8000, 400 * Math.pow(2, Math.min(attempt - 1, 4)));
        threeRetryAt.set(obj.id, performance.now() + retryDelay);
        publishGlbRuntimeStatus(obj, attempt >= 5 ? "failed" : "retrying", error);
        console.warn(`GLB load attempt ${attempt} failed for ${obj.name}; retrying in ${retryDelay}ms`, error);
      }
    );
  }

  function ensureImageOccluder(stationIndex: number, center: Vec3) {
    if (!threeScene) return null;
    const T3: any = THREE;
    let mesh: any = occluders.get(stationIndex);
    if (!mesh) {
      const geometry: any = new T3.PlaneGeometry(5.4, 5.9);
      const material: any = new T3.MeshBasicMaterial({
        colorWrite: false,
        depthWrite: true,
        depthTest: true,
        side: T3.DoubleSide
      });
      mesh = new T3.Mesh(geometry, material);
      mesh.renderOrder = -1000;
      threeScene.add(mesh);
      occluders.set(stationIndex, mesh);
    }
    mesh.position.set(center.x, center.y, center.z + 0.02);
    mesh.rotation.set(0, 0, 0);
    mesh.visible = true;
    return mesh;
  }


