      let layouts = generateAllLayouts();
      captureStylePositions = () => {
        const positions: Record<string, any> = {};
        for (const layout of layouts) {
          for (const obj of layout) {
            if (!obj.url) continue;
            positions[obj.name] = {
              x: obj.local.x,
              y: obj.local.y,
              z: obj.local.z,
              size: obj.size,
              spin: obj.spin,
              hemisphere: obj.hemisphere ?? "front",
              visible: obj.visible !== false
            };
          }
        }
        return positions;
      };
      ensureThree();

      // Read-only, JSON-serializable runtime truth for agents and diagnostics.
      // This deliberately lives beside the renderer so it can report actual
      // layout/resource state without creating a second mutable state model.
      function getDebugSnapshot(): WebRevDebugSnapshot {
        const planeStates = stations.map((station: any, stationIndex: number) => {
          const center = stationCenter(stationIndex);
          const objects = (layouts[stationIndex] ?? []).map((obj: SceneObject) => {
            const world = {
              x: center.x + obj.local.x,
              y: center.y + obj.local.y,
              z: center.z + obj.local.z
            };
            const runtime = obj.kind === "3d" && obj.url
              ? {
                  status: glbRuntimeStatus.get(obj.name) ?? "acknowledged",
                  attempts: threeLoadAttempts.get(obj.id) ?? 0,
                  lastError: glbRuntimeError.get(obj.name),
                  resident: threeObjects.has(obj.id),
                  loading: threeLoading.has(obj.id)
                }
              : null;
            return {
              id: obj.id,
              name: obj.name,
              kind: obj.kind,
              stationId: station.id,
              stationIndex,
              local: { ...obj.local },
              world,
              screen: obj.lastScreen ? { ...obj.lastScreen } : null,
              size: obj.size,
              spin: obj.spin,
              hemisphere: obj.hemisphere ?? "front",
              visible: obj.visible !== false,
              renderedLastFrame: Boolean(obj.lastScreen && obj.visible !== false),
              motion: JSON.parse(JSON.stringify(obj.motion)),
              anchor: { mode: obj.anchorMode ?? "absolute", position: { ...obj.anchor }, offset: obj.anchorOffset ? { ...obj.anchorOffset } : null },
              envelope: JSON.parse(JSON.stringify(spatialEnvelopeConfigFor(obj))),
              modelBounds: obj.modelBounds ? JSON.parse(JSON.stringify(obj.modelBounds)) : null,
              modelRadius: obj.modelRadius ?? null,
              focus: focusExperience?.object === obj,
              focusTrack: (assetFocusAudioState[obj.name]?.track ?? configuredAssetFocusTrack(obj.name)) || null,
              trackExclusions: [...(assetTrackExclusionsState[obj.name] ?? [])],
              runtime
            };
          });
          return {
            id: station.id,
            label: station.label ?? station.id,
            index: stationIndex,
            center,
            stationZ: stationZ(stationIndex),
            active: stationIndex === arrivingAt && arrived(),
            current: stationIndex === arrivingAt,
            previous: stationIndex === (arrivingAt - 1 + stations.length) % stations.length,
            next: stationIndex === (arrivingAt + 1) % stations.length,
            previewPolicy: window.webrevPresentationSettings?.getPlanePreviewPolicy(station.id),
            mainImageResident: imagePlanes.has(station.id),
            textPlaneResident: textPlanes.has(station.id),
            randomizedGlbs: [...(randomGlbSelectionHistory[stationIndex] ?? [])],
            objects
          };
        });
        const currentTrack = trackCatalog().find((track: any) => track.url === focusAudioSourceUrl);
        return {
          schemaVersion: 1,
          capturedAt: new Date().toISOString(),
          runtime: {
            route: `${location.pathname}${location.search}${location.hash}`,
            viewport: { width, height, devicePixelRatio: window.devicePixelRatio || 1 }
          },
          camera: {
            position: cameraPosition(), currentZ: cameraZ, targetZ, yaw: lookYaw, pitch: lookPitch,
            targetYaw, targetPitch, mode: presentationSettings.camera.mode,
            placement: presentationSettings.camera.placement, arrived: arrived()
          },
          travel: {
            state: arrived() ? (focusExperience ? "focus-transition" : "idle") : "roller-coaster",
            destinationPlane: stations[arrivingAt]?.id ?? null,
            pendingFocusObject: pendingFocusPlaylistEntry?.assetName ?? null
          },
          journey: {
            active: Boolean(focusExperience || pendingFocusPlaylistEntry), stationIndex: journeyStationIndex,
            cursor: journeyCursor, length: journeyEntries.length,
            activeObject: focusExperience?.object.name ?? null,
            planeCycleCount: journeyPlaneCyclesCompleted, planeSongCount: journeyPlaneSongCount,
            completedJourneyCount,
            residencyPolicy: window.webrevPresentationSettings?.getPlaneResidencyPolicy() ?? null,
            clickToStart: journeyClickStartEnabled,
            pendingDestinationEntry: pendingFocusPlaylistEntry ? { ...pendingFocusPlaylistEntry } : null
          },
          audio: {
            playing: Boolean(focusAudioElement && !focusAudioElement.paused),
            paused: Boolean(focusAudioElement?.paused), currentTrack: currentTrack?.name ?? null,
            currentAsset: focusAudioCurrentAssetName || null, sourceUrl: focusAudioSourceUrl || null,
            volume: focusAudioElement?.volume ?? presentationSettings.focusAudio.volume,
            loop: Boolean(focusAudioElement?.loop), recent: [...playedTrackHistory],
            played: [...playedTrackLedger], currentPlane: [...journeyPlanePlayedTracks]
          },
          randomization: {
            unpairedGlbLimit: window.webrevPresentationSettings?.getUnpairedGlbLimit(),
            diversityPolicy: JSON.parse(JSON.stringify(randomGlbDiversityPolicy)),
            glbSelectionHistory: randomGlbSelectionHistory.map((entry) => [...entry]),
            glbSelectionDecisions: randomGlbSelectionDebug.map((entry) =>
              JSON.parse(JSON.stringify(entry))
            ),
            fallbackSongHistoryWindow, avoidCurrentPlaneSongs: avoidCurrentPlaneSongsForFallback
          },
          mediaEnvelope: mediaEnvelopeDebugState(),
          renderer: {
            initialized: Boolean(threeRenderer && threeScene && threeCamera),
            contextLost: Boolean(threeRenderer?.getContext?.().isContextLost?.()),
            threeObjectCount: threeObjects.size, loadedGlbCount: threeObjects.size,
            loadingGlbCount: threeLoading.size,
            failedGlbCount: [...glbRuntimeStatus.values()].filter((value) => value === "failed").length,
            imagePlaneCount: imagePlanes.size, textPlaneCount: textPlanes.size,
            debugGlobeCount: debugGlobes.size + envelopeDebugGlobes.size
          },
          planes: planeStates
        };
      }

      window.webrevDebug = {
        schemaVersion: 1,
        getDebugSnapshot,
        getPlaneDebugState(stationId = activeStationId) {
          return getDebugSnapshot().planes.find((plane) => plane.id === stationId) ?? null;
        },
        getObjectDebugState(nameOrId: string) {
          for (const plane of getDebugSnapshot().planes) {
            const object = (plane.objects as Array<Record<string, unknown>>).find(
              (candidate) => candidate.name === nameOrId || candidate.id === nameOrId
            );
            if (object) return object;
          }
          return null;
        },
        getJourneyDebugState: () => getDebugSnapshot().journey,
        getRendererDebugState: () => getDebugSnapshot().renderer,
        getAudioDebugState: () => getDebugSnapshot().audio,
        getRandomizationDebugState: () => getDebugSnapshot().randomization,
        getMediaEnvelopeDebugState: () => mediaEnvelopeDebugState(),
        getGlbSelectionDebugState(stationId = activeStationId) {
          const randomization = getDebugSnapshot().randomization as {
            glbSelectionDecisions?: Array<Record<string, unknown>>;
          };
          return randomization.glbSelectionDecisions?.find(
            (entry) => entry.stationId === stationId
          ) ?? null;
        }
      };

      function rebuildAssetLayouts() {
        layouts = generateAllLayouts();

        // Rebuilds may change the randomized GLB sample. Dispose GPU resources
        // for models no longer referenced by any current layout instead of
        // allowing old geometry/materials/textures to accumulate indefinitely.
        const validIds = new Set<string>();
        for (const layout of layouts) {
          for (const obj of layout) {
            if (obj.kind === "3d" && obj.url) validIds.add(obj.id);
          }
        }
        pruneThreeObjects(validIds);
      }

      function makeAssetRow(obj: SceneObject) {
        const row = document.createElement("div");
        row.className = "sphere-asset-row";

        const name = document.createElement("span");
        name.className = "sphere-asset-name";
        name.textContent = obj.name;

        const side = document.createElement("select");
        side.className = "sphere-side-select";
        side.setAttribute("aria-label", `Placement for ${obj.name}`);
        for (const value of ["front", "back"] as const) {
          const option = document.createElement("option");
          option.value = value;
          option.textContent = value === "front" ? "Front" : "Back";
          option.selected = obj.hemisphere === value;
          side.appendChild(option);
        }
        side.addEventListener("change", () => {
          window.webrevPresentationSettings?.setAssetHemisphere(
            obj.name,
            side.value === "back" ? "back" : "front"
          );
        });

        const motionSelect = document.createElement("select");
        motionSelect.className = "sphere-motion-select";
        motionSelect.setAttribute("aria-label", `Motion for ${obj.name}`);
        const motionOptions = [
          ["free", "Free"],
          ["fixed-anchored", "Fixed"],
          ["fixed-range", "Fixed range"]
        ] as const;
        const currentMotionValue =
          obj.motion.type === "free"
            ? "free"
            : obj.motion.fixedMode === "range"
              ? "fixed-range"
              : "fixed-anchored";
        for (const [value, label] of motionOptions) {
          const option = document.createElement("option");
          option.value = value;
          option.textContent = label;
          option.selected = value === currentMotionValue;
          motionSelect.appendChild(option);
        }
        motionSelect.addEventListener("change", () => {
          if (motionSelect.value === "free") {
            window.webrevPresentationSettings?.setAssetMotion(obj.name, { type: "free" });
          } else if (motionSelect.value === "fixed-range") {
            window.webrevPresentationSettings?.setAssetMotion(obj.name, {
              type: "fixed",
              fixedMode: "range",
              range: 0.8,
              behavior: { type: "bob", amplitude: 0.35, speed: 0.7 }
            });
          } else {
            window.webrevPresentationSettings?.setAssetMotion(obj.name, {
              type: "fixed",
              fixedMode: "anchored",
              behavior: { type: "none" }
            });
          }
        });

        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "sphere-asset-remove";
        remove.setAttribute("aria-label", `Hide ${obj.name}`);
        remove.textContent = "×";
        remove.addEventListener("click", () => {
          window.webrevPresentationSettings?.setAssetVisible(obj.name, false);
        });

        const stationSelect = document.createElement("select");
        stationSelect.className = "sphere-motion-select";
        stationSelect.setAttribute("aria-label", `Plane for ${obj.name}`);
        for (const station of stations) {
          const option = document.createElement("option");
          option.value = station.id;
          option.textContent = station.label ?? station.id;
          option.selected = station.id === window.webrevPresentationSettings?.getAssetStation(obj.name);
          stationSelect.appendChild(option);
        }
        stationSelect.addEventListener("change", () => {
          window.webrevPresentationSettings?.setAssetStation(obj.name, stationSelect.value);
        });

        row.append(name, stationSelect, side, motionSelect, remove);
        return row;
      }

      function currentApiValue(key: PresentationSettingKey) {
        return window.webrevPresentationSettings?.get(key);
      }

      function setApiValue(key: PresentationSettingKey, value: PresentationSettingValue) {
        window.webrevPresentationSettings?.set(key, value);
      }

      function renderApiSettingsControls() {
        if (!apiSettingsControls) return;
        const api = window.webrevPresentationSettings;
        if (!api) return;

        apiSettingsControls.replaceChildren();
        const descriptors = api.describeSettings(activeStationId);
        let currentGroup = "";

        for (const descriptor of descriptors) {
          if (descriptor.group !== currentGroup) {
            currentGroup = descriptor.group;
            const heading = document.createElement("div");
            heading.className = "api-settings-group-title";
            heading.textContent =
              descriptor.group === "sphere" ? "Sphere geometry" :
              descriptor.group === "camera" ? "Camera" :
              descriptor.group === "viewport" ? "Viewport" :
              descriptor.group === "initialPlacement" ? "Initial placement" :
              descriptor.group === "interaction" ? "Interaction" :
              descriptor.group === "focusAudio" ? "Focus music" :
              descriptor.group === "debug" ? "Debug" :
              descriptor.group === "editor" ? "Edit Layer" :
              "Text plane";
            apiSettingsControls.appendChild(heading);
          }

          const row = document.createElement("label");
          row.className = descriptor.control === "toggle"
            ? "api-setting-row api-setting-toggle"
            : "api-setting-row";

          const textWrap = document.createElement("span");
          textWrap.className = "api-setting-copy";
          const label = document.createElement("strong");
          label.textContent = descriptor.label;
          textWrap.appendChild(label);
          if (descriptor.description) {
            const description = document.createElement("small");
            description.textContent = descriptor.description;
            textWrap.appendChild(description);
          }

          const current = currentApiValue(descriptor.key);

          if (descriptor.control === "toggle") {
            const input = document.createElement("input");
            input.type = "checkbox";
            input.checked = Boolean(current);
            input.addEventListener("change", () => setApiValue(descriptor.key, input.checked));
            row.append(input, textWrap);
          } else if (descriptor.control === "select") {
            const select = document.createElement("select");
            select.className = "api-setting-control";
            for (const choice of descriptor.options ?? []) {
              const option = document.createElement("option");
              option.value = choice.value;
              option.textContent = choice.label;
              option.selected = String(current ?? "") === choice.value;
              select.appendChild(option);
            }
            select.disabled = Boolean(descriptor.readOnly);
            select.addEventListener("change", () => setApiValue(descriptor.key, select.value));
            row.append(textWrap, select);
          } else if (descriptor.control === "color") {
            const input = document.createElement("input");
            input.className = "api-setting-control";
            input.type = "color";
            input.value = typeof current === "string" && /^#[0-9a-f]{6}$/i.test(current) ? current : "#ffffff";
            input.addEventListener("input", () => setApiValue(descriptor.key, input.value));
            row.append(textWrap, input);
          } else {
            const input = document.createElement("input");
            input.className = "api-setting-control";
            input.type = "number";
            if (descriptor.min != null) input.min = String(descriptor.min);
            if (descriptor.max != null) input.max = String(descriptor.max);
            if (descriptor.step != null) input.step = String(descriptor.step);
            input.readOnly = Boolean(descriptor.readOnly);
            input.value = Number(current ?? 0).toFixed(descriptor.step && descriptor.step < 0.1 ? 2 : 1);
            const commit = () => {
              if (descriptor.readOnly) return;
              const value = Number(input.value);
              if (Number.isFinite(value)) setApiValue(descriptor.key, value);
            };
            input.addEventListener("change", commit);
            input.addEventListener("keydown", (event) => {
              if (event.key !== "Enter") return;
              event.preventDefault();
              commit();
            });
            row.append(textWrap, input);
          }

          apiSettingsControls.appendChild(row);
        }
      }

