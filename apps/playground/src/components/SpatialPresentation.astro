    function downloadCurrentStyleSnapshot() {
      if (!styleExplorationEnabled || !styleSnapshotReady || !latestStyleSnapshot) return false;
      const capturedAt = String((latestStyleSnapshot as any).capturedAt ?? new Date().toISOString());
      const safeStamp = capturedAt.replace(/[:.]/g, "-");
      const blob = new Blob([JSON.stringify(latestStyleSnapshot, null, 2)], {
        type: "application/json"
      });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = `webrev-style-${safeStamp}.json`;
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
      return true;
    }
