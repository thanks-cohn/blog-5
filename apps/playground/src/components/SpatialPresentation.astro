        } else if (key === "editor.cameraPreset") {
          if (presentationSettings.editor.mode === "hemisphere") {
            presentationSettings.editor.cameraPreset =
              value === "side" || value === "bottom-corner-up" || value === "top-left-down"
                ? value
                : "top";
          }
        } else if (key === "editor.repositionObjectName") {
          if (presentationSettings.editor.mode === "hemisphere") presentationSettings.editor.repositionObjectName = String(value ?? "");
        } else if (key === "textPlane.enabled") {
          presentationSettings.textPlane.enabled = Boolean(value);
        } else if (key === "textPlane.color") {
          presentationSettings.textPlane.color = String(value || "#ffffff");
        } else if (key === "textPlane.width") {
          presentationSettings.textPlane.width = Math.max(0.2, Number(value) || 0.2);
        } else if (key === "textPlane.height") {
