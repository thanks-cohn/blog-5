---
import oversphereLocations from "../assets/oversphere/locations/urls.json";
export interface Props {
  config: any;
  homeHref: string;
  links: Record<string, string>;
}

const { config, homeHref, links } = Astro.props;

type DiscoveredAsset = { name: string; url: string; kind: "2d" | "3d"; initialStationId?: string };

const discovered2d = import.meta.glob("../assets/2d-assets/*.{png,jpg,jpeg,webp,avif,svg}", {
  eager: true,
  query: "?url",
  import: "default"
}) as Record<string, string>;

const discoveredCenterImages = import.meta.glob("../assets/2d-assets/*-center.{png,jpg,jpeg,webp,avif}", {
  eager: true,
  query: "?url",
  import: "default"
}) as Record<string, string>;

const centerImagesByArtwork: Record<string, string> = {};
for (const [path, url] of Object.entries(discoveredCenterImages)) {
  const file = path.split("/").pop() ?? "";
  const base = file.replace(/\.[^.]+$/, "");
  const artworkName = base.replace(/-center$/, "");
  if (artworkName && artworkName !== base) centerImagesByArtwork[artworkName] = url;
}

const discovered3d = import.meta.glob("../assets/3d-assets/*.{glb,gltf}", {
  eager: true,
  query: "?url",
  import: "default"
}) as Record<string, string>;

const discoveredMusic = import.meta.glob("../assets/music/*.{mp3,wav,ogg,m4a,aac,flac}", {
  eager: true,
  query: "?url",
  import: "default"
}) as Record<string, string>;

const discoveredEnvelopeMedia = import.meta.glob("../assets/**/*.{mp4,webm,gif,png,jpg,jpeg,webp,avif}", {
  eager: true,
  query: "?url",
  import: "default"
}) as Record<string, string>;

const discoveredOversphereVideos = import.meta.glob("../assets/oversphere/videos/*.{mp4,webm}", {
  eager: true,
  query: "?url",
  import: "default"
}) as Record<string, string>;

const oversphereLocalVideos = Object.entries(discoveredOversphereVideos)
  .map(([path, url]) => ({
    id: path.split("/").pop() ?? path,
    name: path.split("/").pop() ?? path,
    path,
    url,
    source: "local"
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

function normalizedOversphereUrlVideos(value: any) {
  const entries = Array.isArray(value?.videos) ? value.videos : [];
  return entries
    .map((entry: any, index: number) => {
      if (typeof entry === "string") {
        const url = entry.trim();
        if (!url) return null;
        return {
          id: url,
          name: `remote-${index + 1}`,
          url,
          source: "url"
        };
      }
      if (!entry || typeof entry.url !== "string" || !entry.url.trim()) return null;
      const url = entry.url.trim();
      return {
        id: String(entry.id ?? url),
        name: String(entry.name ?? entry.id ?? `remote-${index + 1}`),
        url,
        source: "url"
      };
    })
    .filter(Boolean);
}

const oversphereUrlVideos = normalizedOversphereUrlVideos(oversphereLocations);
const oversphereVideos = [...oversphereUrlVideos, ...oversphereLocalVideos];

const mediaEnvelopeMedia = Object.entries(discoveredEnvelopeMedia)
  .map(([path, url]) => ({
    id: path.split("/").pop() ?? path,
    name: path.split("/").pop() ?? path,
    path,
    url
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const musicTracks = Object.entries(discoveredMusic)
  .map(([path, url]) => ({ name: path.split("/").pop() ?? path, url }))
  .sort((a, b) => a.name.localeCompare(b.name));

const assetsByArtwork: Record<string, DiscoveredAsset[]> = {};
const assetInventory: DiscoveredAsset[] = [];
const stationDefinitionsForImport = Array.isArray(config?.stations) ? config.stations : [];
const artworkNames: string[] = Array.from(
  new Set<string>(
    stationDefinitionsForImport
      .map((station: any) => String(station?.artworkName ?? "").trim())
      .filter((name: string) => name.length > 0)
  )
).sort((a: string, b: string) => b.length - a.length);

function registerAsset(path: string, url: string, kind: "2d" | "3d") {
  const file = path.split("/").pop() ?? "";
  const base = file.replace(/\.[^.]+$/, "");
  const artworkName = artworkNames.find(
    (name) => base.startsWith(`${name}-`) && base.length > name.length + 1
  );
  const initialStationId = artworkName
    ? stationDefinitionsForImport.find((station: any) => station.artworkName === artworkName)?.id
    : undefined;
  const asset: DiscoveredAsset = { name: file, url, kind, initialStationId };
  assetInventory.push(asset);
  if (artworkName) (assetsByArtwork[artworkName] ??= []).push(asset);
}

for (const [path, url] of Object.entries(discovered2d)) registerAsset(path, url, "2d");
for (const [path, url] of Object.entries(discovered3d)) registerAsset(path, url, "3d");

const runtimeConfig = {
  ...config,
  assetsByArtwork,
  assetInventory,
  centerImagesByArtwork,
  musicTracks,
  mediaEnvelopeMedia,
  oversphereVideos,
  oversphereLocations,
  resolvedLinks: links
};
---

<div
  class="presentation"
  data-webrev-id="presentation.do-it-your-way"
  data-config={JSON.stringify(runtimeConfig)}
  data-home-href={homeHref}
>
  <canvas id="prism-rail-canvas" aria-label="Do It Your Way spatial presentation"></canvas>
  <canvas id="glb-layer" aria-hidden="true"></canvas>
  <button type="button" id="rail-ride-next" class="rail-ride-next">
    Take the Roller Coaster
  </button>
  <button type="button" id="focus-song-prev" class="focus-song-overlay focus-song-overlay-left" aria-label="Previous song and object">
    <span aria-hidden="true">‹</span>
  </button>
  <button type="button" id="focus-song-next" class="focus-song-overlay focus-song-overlay-right" aria-label="Next song and object">
    <span aria-hidden="true">›</span>
  </button>
  <div class="sr-only" aria-live="polite" id="presentation-status"></div>
  <div id="edit-context-menu" class="edit-context-menu" hidden></div>

  <button
    type="button"
    id="sphere-settings-toggle"
    class="sphere-settings-toggle"
    aria-label="Sphere asset settings"
    aria-expanded="false"
    aria-controls="sphere-settings-panel"
  >⚙</button>

  <aside id="sphere-settings-panel" class="sphere-settings-panel" hidden>
    <div class="sphere-settings-header">
      <div>
        <strong id="station-settings-title">Sphere assets</strong>
        <div id="sphere-size-readout" class="sphere-size-readout"></div>
      </div>
      <button type="button" id="sphere-settings-close" class="sphere-settings-close" aria-label="Close settings">×</button>
    </div>

    <div id="api-settings-controls" class="api-settings-controls"></div>

    <section class="sphere-side-section" aria-labelledby="style-exploration-title">
      <div class="sphere-side-title" id="style-exploration-title">Style exploration</div>
      <label class="sphere-asset-add">
        <span>Style mode</span>
        <input id="style-exploration-toggle" type="checkbox" />
      </label>
      <label class="sphere-asset-add">
        <span>Start journey on click</span>
        <input id="journey-click-start-toggle" type="checkbox" checked />
      </label>
      <div class="style-exploration-actions">
        <button type="button" id="settings-save" class="settings-save">Save</button>
        <button type="button" id="style-exploration-download" class="style-exploration-download" disabled>
          Download JSON
        </button>
      </div>
      <div id="style-exploration-status" class="sphere-size-readout">
        Style mode is off.
      </div>
    </section>

    <section class="sphere-side-section" aria-labelledby="focus-song-pairing-title">
      <div class="sphere-side-title" id="focus-song-pairing-title">GLB focus song</div>
      <label class="sphere-asset-add">
        <span>GLB object</span>
        <select id="focus-song-glb-picker">
          <option value="">Choose a GLB…</option>
        </select>
      </label>
      <label class="sphere-asset-add">
        <span>Plane</span>
        <select id="focus-song-station-picker" disabled>
          <option value="">Choose a GLB first…</option>
        </select>
      </label>
      <label class="sphere-asset-add">
        <span>Song</span>
        <select id="focus-song-track-picker" disabled>
          <option value="">Choose a song…</option>
        </select>
      </label>
      <div id="focus-song-pairing-status" class="sphere-size-readout"></div>
    </section>

    <label class="sphere-asset-add">
      <span>Add / restore asset</span>
      <select id="sphere-asset-picker">
        <option value="">Choose an asset…</option>
      </select>
    </label>

    <section class="sphere-side-section" aria-labelledby="front-assets-title">
      <div class="sphere-side-title" id="front-assets-title">Front</div>
      <div id="front-assets-list" class="sphere-asset-list"></div>
    </section>

    <section class="sphere-side-section" aria-labelledby="back-assets-title">
      <div class="sphere-side-title" id="back-assets-title">Back</div>
      <div id="back-assets-list" class="sphere-asset-list"></div>
    </section>
  </aside>
</div>

<script>
  import * as THREE from "../vendor/three.module.min.js";
  import { GLTFLoader } from "../vendor/GLTFLoader.js";
  import {
    cameraDistanceForPlacement,
    constrainBodyToHemisphereSphere,
    maxBodyRadiusForSphere,
    sphereFromCircumference,
    sphereFromDiameter,
    sphereFromRadius,
    type CameraPlacement
  } from "../lib/spatialSphere";
  import {
    fixedPositionAtTime,
    normalizeObjectMotion,
    type ObjectMotion
  } from "../lib/objectMotion";
  import {
    HEMISPHERE_CAMERA_PRESETS,
    hemisphereEditorCameraPosition,
    lookAnglesAt,
    screenBasis,
    type EditLayerState,
    type HemisphereCameraPreset
  } from "../lib/editLayer";
  import {
    normalizeSpatialEnvelopeConfig,
    resolveSphereCollision,
    spatialEnvelopeRadius,
    type SpatialEnvelopeConfig
  } from "../lib/spatialEnvelope";
  import {
    solveFocusComposition,
    type FocusSide
  } from "../lib/focusExperience";

  type Vec3 = { x: number; y: number; z: number };
  type Projected = { x: number; y: number; depth: number; scale: number };
  type AssetAction =
    | { type: "station"; stationId: string }
    | { type: "link"; linkKey: string }
    | { type: "url"; url: string }
    | { type: "text"; title?: string; body?: string };

  type SceneObject = {
    id: string;
    name: string;
    kind: "2d" | "3d";
    url?: string;
    local: Vec3;
    velocity: Vec3;
    size: number;
    shape: number;
    spin: number;
    spinVelocity: number;
    phase: number;
    image?: HTMLImageElement;
    action?: AssetAction;
    depthLayer?: "near" | "middle" | "far";
    hideBehindImage?: boolean;
    hemisphere?: "front" | "back";
    visible?: boolean;
    modelBounds?: {
      min: Vec3;
      max: Vec3;
    };
    modelRadius?: number;
    motion: ObjectMotion;
    anchor: Vec3;
    anchorMode?: "absolute" | "camera-midpoint";
    anchorOffset?: Vec3;
    lastScreen?: { x: number; y: number; radius: number; depth: number };
  };

  type CameraMode = "locked" | "focus" | "free";
  type FocusPlaybackMode = "zone-cycle" | "loop-item";
  type FocusPlaybackScope = "station" | "all";
  type FocusPlaybackOrder = "ordered" | "random";
  type PlaneTravelMode = "teleport" | "roller-coaster" | "custom";

  type MediaEnvelopeTrigger =
    | { type: "song"; trackId: string }
    | { type: "object-focus"; assetName: string }
    | { type: "station-enter"; stationId: string }
    | { type: "journey-progress"; segmentId: string; gte: number }
    | { type: "event"; eventName: string }
    | { type: "custom"; resolverId: string; options?: Record<string, unknown> };

  type MediaEnvelopeMediaSource = {
    id: string;
    type: "video" | "image";
    src: string;
    loop?: boolean;
    muted?: boolean;
    opacity?: number;
  };

  type MediaEnvelopeProgram = {
    id: string;
    envelope?: {
      shape?: "sphere";
      origin?: { mode?: "focused-object" | "station-center"; offset?: Vec3 };
      radius?: number;
      growth?: { mode?: "instant" | "timed"; durationMs?: number; easing?: "linear" | "easeOutCubic" };
    };
    coverage?: {
      include?: Array<"current-main-panel" | "next-main-panel">;
      padding?: number;
      panelAllowance?: number;
      minRadius?: number;
    };
    surface?: {
      side?: "inside";
      orientation?: { mode?: "upright-to-world" | "surface-native" };
      depthMode?: "scene" | "foreground";
    };
    protectedRegions?: Array<{
      target: "current-main-panel" | "next-main-panel";
      mode?: "avoid";
      angularRadiusDeg?: number;
      paddingPx?: number;
    }>;
    layout?: {
      mode?: "grid" | "hero" | "grid-with-hero";
      rows?: number;
      columns?: number;
      horizontalArcDeg?: number;
      verticalArcDeg?: number;
      gapDeg?: number;
      tileAngularWidthDeg?: number;
      tileAngularHeightDeg?: number;
      azimuthOffsetDeg?: number;
      elevationOffsetDeg?: number;
    };
    media?: MediaEnvelopeMediaSource[];
    choreography?: {
      clock?: "binding";
      cues?: Array<Record<string, unknown>>;
    };
    lifecycle?: {
      endOnMediaEnd?: boolean;
    };
    performance?: {
      cullOutsideEnvelope?: boolean;
      restoreOutsideAfterMs?: number;
    };
  };

  type MediaEnvelopeBinding = {
    id: string;
    trigger: MediaEnvelopeTrigger;
    programId: string;
    priority?: number;
  };

  type OversphereVideoSelectionPolicy = {
    avoidRecent: number;
    avoidCurrentPlane: boolean;
    avoidPreviousPlane: boolean;
    pairingRequired: boolean;
    selection: "random";
  };

  type MediaEnvelopeRuntimeState = {
    active: boolean;
    bindingId?: string;
    programId?: string;
    trigger?: Record<string, unknown>;
    stationId?: string;
    focusedAssetName?: string;
    resolvedRadius?: number;
    origin?: Vec3;
    clockSeconds?: number;
    tileCount?: number;
    tiles?: Array<Record<string, unknown>>;
    activeCues?: string[];
  };
  type UnpairedGlbCountPolicy =
    | number
    | "all"
    | { mode: "range"; min: number; max: number };
  type PlanePreviewPolicy = {
    showGlbs: boolean;
    maxGlbs: number | "all";
    representation?: "glb" | "icon";
  };
  type RandomGlbDiversityPolicy = {
    avoidWithinRun: boolean;
    avoidAdjacent: boolean;
    recentPlaneMultipliers: Record<number, number>;
  };
  type PlaneResidencyPolicy =
    | { mode: "cycles"; value: number }
    | { mode: "songs"; value: number }
    | { mode: "coverage"; value: number };
  type WeightedJourneyResource = {
    id: string;
    weight?: number;
    probability?: number;
  };
  type JourneyResourcePool = {
    id: string;
    resources: WeightedJourneyResource[];
  };
  type TransitionResourcePolicy =
    | { mode: "inherit" }
    | { mode: "preset"; resources: string[] }
    | { mode: "pool"; poolId: string };
  type JourneyMusicEvolutionPolicy = {
    presetJourneys: number;
    presetSequence: string[];
    randomPoolId?: string;
    pools: JourneyResourcePool[];
    transitionPolicies: Record<string, TransitionResourcePolicy>;
  };
  type FocusPlaybackProgram = {
    scope?: FocusPlaybackScope;
    order?: FocusPlaybackOrder;
    sequence?: string[];
    residency?: PlaneResidencyPolicy;
    travelMode?: PlaneTravelMode;
    customTravelId?: string;
    pools?: Array<{
      id: string;
      assets?: string[];
      tracks?: string[];
      order?: FocusPlaybackOrder;
      repeat?: number | "forever";
    }>;
  };
  type FocusPlaylistEntry = {
    stationId: string;
    stationIndex: number;
    assetName: string;
    track: string;
    url: string;
  };
  type PresentationSettingKey =
    | "camera.mode"
    | "camera.placement"
    | "camera.distanceFromCenter"
    | "sphere.diameter"
    | "sphere.radius"
    | "sphere.circumference"
    | "sphere.restitution"
    | "viewport.enabled"
    | "viewport.paddingPx"
    | "initialPlacement.keepViewerImageSightlineClear"
    | "interaction.contextMenuMode"
    | "focusAudio.enabled"
    | "focusAudio.track"
    | "focusAudio.playbackMode"
    | "focusAudio.scope"
    | "focusAudio.volume"
    | "focusAudio.fadeInMs"
    | "focusAudio.fadeOutMs"
    | "debug.glbGlobe.enabled"
    | "debug.glbGlobe.objectName"
    | "editor.mode"
    | "editor.hemisphere"
    | "editor.cameraPreset"
    | "editor.repositionObjectName"
    | "textPlane.enabled"
    | "textPlane.color"
    | "textPlane.width"
    | "textPlane.height"
    | "textPlane.offsetY"
    | "textPlane.offsetZ"
    | "textPlane.attachment"
    | "textPlane.orientationMode"
    | "textPlane.rotationAxis"
    | "textPlane.angleDegrees"
    | "textPlane.placementSpace";
  type PresentationSettingValue = boolean | number | string;
  type AssetHemisphere = "front" | "back";
  type AssetPlacementState = Record<string, { hemisphere: AssetHemisphere; visible: boolean }>;
  type PresentationSettingsSnapshot = {
    camera: {
      mode: CameraMode;
      placement: CameraPlacement;
      distanceFromCenter: number;
    };
    sphere: {
      diameter: number;
      radius: number;
      circumference: number;
      restitution: number;
    };
    viewport: {
      enabled: boolean;
      paddingPx: number;
    };
    initialPlacement: {
      keepViewerImageSightlineClear: boolean;
    };
    interaction: {
      contextMenuMode: "experience" | "edit";
    };
    focusAudio: {
      enabled: boolean;
      track: string;
      playbackMode: FocusPlaybackMode;
      scope: FocusPlaybackScope;
      volume: number;
      fadeInMs: number;
      fadeOutMs: number;
    };
    debug: {
      glbGlobe: {
        enabled: boolean;
        objectName: string;
      };
    };
    editor: EditLayerState;
    textPlane: {
      enabled: boolean;
      color: string;
      width: number;
      height: number;
      offsetY: number;
      offsetZ: number;
      attachment: "separate";
      orientationMode: "axis-angle";
      rotationAxis: "center-horizontal-line";
      angleDegrees: number;
      placementSpace: "image-relative";
    };
  };
  type GlbRuntimeStatus = "acknowledged" | "loading" | "loaded" | "retrying" | "failed";
  type SettingsListener = (settings: PresentationSettingsSnapshot) => void;
  type SettingOption = { value: string; label: string };
  type SettingDescriptor = {
    key: PresentationSettingKey;
    label: string;
    group: "sphere" | "camera" | "viewport" | "initialPlacement" | "interaction" | "focusAudio" | "debug" | "editor" | "textPlane";
    control: "number" | "select" | "toggle" | "color";
    description?: string;
    min?: number;
    max?: number;
    step?: number;
    readOnly?: boolean;
    options?: SettingOption[];
  };

  type WebRevDebugSnapshot = {
    schemaVersion: 1;
    capturedAt: string;
    runtime: { route: string; viewport: { width: number; height: number; devicePixelRatio: number } };
    camera: Record<string, unknown>;
    travel: Record<string, unknown>;
    journey: Record<string, unknown>;
    audio: Record<string, unknown>;
    randomization: Record<string, unknown>;
    mediaEnvelope: MediaEnvelopeRuntimeState;
    renderer: Record<string, unknown>;
    planes: Array<Record<string, unknown>>;
  };

  declare global {
    interface Window {
      webrevDebug?: {
        readonly schemaVersion: 1;
        getDebugSnapshot(): WebRevDebugSnapshot;
        getPlaneDebugState(stationId?: string): Record<string, unknown> | null;
        getObjectDebugState(nameOrId: string): Record<string, unknown> | null;
        getJourneyDebugState(): Record<string, unknown>;
        getRendererDebugState(): Record<string, unknown>;
        getAudioDebugState(): Record<string, unknown>;
        getRandomizationDebugState(): Record<string, unknown>;
        getGlbSelectionDebugState(stationId?: string): Record<string, unknown> | null;
        getMediaEnvelopeDebugState(): MediaEnvelopeRuntimeState;
      };
      webrevPresentationSettings?: {
        get(key?: PresentationSettingKey): PresentationSettingsSnapshot | PresentationSettingValue;
        set(key: PresentationSettingKey, value: PresentationSettingValue): PresentationSettingsSnapshot;
        reset(key?: PresentationSettingKey): PresentationSettingsSnapshot;
        subscribe(listener: SettingsListener): () => void;
        describeSettings(stationId?: string): SettingDescriptor[];
        listAssets(stationId?: string): Array<{ name: string; stationId: string; hemisphere: AssetHemisphere; visible: boolean; motion: ObjectMotion; kind: "2d" | "3d"; uploaded: boolean; focusTrack?: string; runtimeStatus?: GlbRuntimeStatus; loadAttempts?: number }>;
        listAssetLibrary(): Array<{ name: string; stationId: string; kind: "2d" | "3d"; uploaded: boolean }>;
        getAssetStation(name: string): string | null;
        setAssetStation(name: string, stationId: string): void;
        setAssetHemisphere(name: string, hemisphere: AssetHemisphere): void;
        setAssetVisible(name: string, visible: boolean): void;
        getAssetMotion(name: string): ObjectMotion | null;
        setAssetMotion(name: string, motion: ObjectMotion): void;
        getAssetFocusAudio(name: string): { track: string } | null;
        setAssetFocusAudio(name: string, patch: { track?: string }): void;
        getAssetTrackExclusions(name: string): string[];
        setAssetTrackExclusions(name: string, tracks: string[]): string[];
        addAssetTrackExclusion(name: string, track: string): string[];
        removeAssetTrackExclusion(name: string, track: string): string[];
        getUnpairedGlbLimit(stationId?: string): UnpairedGlbCountPolicy;
        setUnpairedGlbLimit(limit: UnpairedGlbCountPolicy, stationId?: string): UnpairedGlbCountPolicy;
        getRandomGlbDiversityPolicy(): RandomGlbDiversityPolicy;
        setRandomGlbDiversityPolicy(policy: Partial<RandomGlbDiversityPolicy>): RandomGlbDiversityPolicy;
        getRandomGlbSelectionHistory(): string[][];
        clearRandomGlbSelectionHistory(): void;
        getPlanePreviewPolicy(stationId?: string): PlanePreviewPolicy;
        setPlanePreviewPolicy(policy: Partial<PlanePreviewPolicy>, stationId?: string): PlanePreviewPolicy;
        getFallbackSongHistoryWindow(): number;
        setFallbackSongHistoryWindow(count: number): number;
        getPlayedTrackHistory(): { recent: string[]; played: string[]; unheard: string[] };
        clearPlayedTrackHistory(): void;
        getAvoidCurrentPlaneSongsForFallback(): boolean;
        setAvoidCurrentPlaneSongsForFallback(enabled: boolean): boolean;
        getFocusPlaylist(): FocusPlaylistEntry[];
        setFocusPlaybackMode(mode: FocusPlaybackMode): PresentationSettingsSnapshot;
        setFocusPlaybackScope(scope: FocusPlaybackScope): PresentationSettingsSnapshot;
        getFocusPlaybackProgram(): FocusPlaybackProgram;
        setFocusPlaybackProgram(program: FocusPlaybackProgram): FocusPlaybackProgram;
        setFocusPlaybackOrder(order: FocusPlaybackOrder): FocusPlaybackProgram;
        getPlaneResidencyPolicy(): PlaneResidencyPolicy;
        setPlaneResidencyPolicy(policy: PlaneResidencyPolicy): PlaneResidencyPolicy;
        getPlaneTravelMode(): PlaneTravelMode;
        setPlaneTravelMode(mode: PlaneTravelMode, customTravelId?: string): PlaneTravelMode;
        getJourneyMusicEvolution(): JourneyMusicEvolutionPolicy;
        setJourneyMusicEvolution(policy: Partial<JourneyMusicEvolutionPolicy>): JourneyMusicEvolutionPolicy;
        getCompletedJourneyCount(): number;
        resetCompletedJourneyCount(): number;
        getTransitionResourcePolicy(transitionId: string): TransitionResourcePolicy | null;
        setTransitionResourcePolicy(transitionId: string, policy: TransitionResourcePolicy): TransitionResourcePolicy;
        resolveTransitionResource(transitionId: string): string | null;
        travelToPlane(stationId: string, mode?: PlaneTravelMode, customTravelId?: string): boolean;
        getStyleExplorationMode(): boolean;
        setStyleExplorationMode(enabled: boolean): boolean;
        getJourneyClickStart(): boolean;
        setJourneyClickStart(enabled: boolean): boolean;
        saveSettings(): Record<string, unknown> | null;
        getStyleSnapshot(): Record<string, unknown> | null;
        downloadStyleSnapshot(): boolean;
        listMediaEnvelopePrograms(): MediaEnvelopeProgram[];
        getMediaEnvelopeProgram(id: string): MediaEnvelopeProgram | null;
        setMediaEnvelopeProgram(program: MediaEnvelopeProgram): MediaEnvelopeProgram;
        removeMediaEnvelopeProgram(id: string): boolean;
        listMediaEnvelopeBindings(): MediaEnvelopeBinding[];
        setMediaEnvelopeBinding(binding: MediaEnvelopeBinding): MediaEnvelopeBinding;
        removeMediaEnvelopeBinding(id: string): boolean;
        bindSongToMediaEnvelope(trackId: string, programId: string, bindingId?: string): MediaEnvelopeBinding;
        activateMediaEnvelope(programId: string, context?: Record<string, unknown>): boolean;
        deactivateMediaEnvelope(): void;
