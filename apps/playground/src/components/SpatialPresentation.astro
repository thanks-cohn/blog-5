        ) {
          const rawMin = Math.max(0, Math.floor(Number((value as any).min) || 0));
          const rawMax = Math.max(0, Math.floor(Number((value as any).max) || 0));
          normalized[key] = {
            mode: "range",
            min: Math.min(rawMin, rawMax),
            max: Math.max(rawMin, rawMax)
          };
          continue;
        }
        normalized[key] = Math.max(0, Math.floor(Number(value) || 0));
      }
      if (!("global" in normalized)) normalized.global = { mode: "range", min: 3, max: 5 };
      return normalized;
    }

    let unpairedGlbLimits: Record<string, UnpairedGlbCountPolicy> = loadUnpairedGlbLimits();

    let randomGlbDiversityPolicy: RandomGlbDiversityPolicy = {
      avoidWithinRun: true,
      avoidAdjacent: true,
      recentPlaneMultipliers: {
        1: 0.5,
        2: 0.8
      }
    };

    let randomGlbSelectionHistory: string[][] = [];
    let randomGlbSelectionDebug: Array<Record<string, unknown>> = [];

    function normalizeRandomGlbDiversityPolicy(
      value: Partial<RandomGlbDiversityPolicy> | undefined
    ): RandomGlbDiversityPolicy {
      const multipliers: Record<number, number> = {};
      const source = value?.recentPlaneMultipliers ?? randomGlbDiversityPolicy.recentPlaneMultipliers;
      for (const [distanceKey, multiplierValue] of Object.entries(source ?? {})) {
        const distance = Math.max(1, Math.floor(Number(distanceKey) || 0));
        const multiplier = Math.max(0, Math.min(1, Number(multiplierValue)));
        if (distance > 0 && Number.isFinite(multiplier)) {
          multipliers[distance] = multiplier;
        }
      }
      return {
        avoidWithinRun:
          typeof value?.avoidWithinRun === "boolean"
            ? value.avoidWithinRun
            : randomGlbDiversityPolicy.avoidWithinRun,
        avoidAdjacent:
          typeof value?.avoidAdjacent === "boolean"
            ? value.avoidAdjacent
            : randomGlbDiversityPolicy.avoidAdjacent,
        recentPlaneMultipliers: multipliers
      };
    }

    function weightedRandomGlbSample(
      candidates: any[],
      count: number,
      planeIndex: number,
      rand: () => number
    ) {
      const chosen: any[] = [];
      const pool = [...candidates];

      while (pool.length && chosen.length < count) {
        const weighted = pool.map((asset: any) => {
          let weight = 1;
          for (let distance = 1; distance <= planeIndex; distance++) {
            const priorPlane = randomGlbSelectionHistory[planeIndex - distance] ?? [];
            if (!priorPlane.includes(asset.name)) continue;
            const multiplier =
              randomGlbDiversityPolicy.recentPlaneMultipliers[distance];
            if (typeof multiplier === "number") weight *= multiplier;
          }
          return { asset, weight: Math.max(0.0001, weight) };
        });

        const total = weighted.reduce((sum, entry) => sum + entry.weight, 0);
        let pick = rand() * total;
        let selectedIndex = 0;
        for (let i = 0; i < weighted.length; i++) {
          pick -= weighted[i].weight;
          if (pick <= 0) {
            selectedIndex = i;
            break;
          }
        }

        chosen.push(weighted[selectedIndex].asset);
        pool.splice(selectedIndex, 1);
      }

      return chosen;
    }

