  function normalizeWeightedResources(value: unknown): WeightedJourneyResource[] {
    if (!Array.isArray(value)) return [];
    const result: WeightedJourneyResource[] = [];
    for (const entry of value) {
      if (typeof entry === "string") {
        if (entry) result.push({ id: entry, weight: 1 });
        continue;
      }
      if (!entry || typeof entry !== "object") continue;
      const raw = entry as any;
      if (typeof raw.id !== "string" || !raw.id) continue;
      const rawWeight = Number(raw.weight);
      const rawProbability = Number(raw.probability);
      result.push({
        id: raw.id,
        weight:
          Number.isFinite(rawWeight) && rawWeight > 0
            ? rawWeight
            : 1,
        probability:
          Number.isFinite(rawProbability)
            ? Math.max(0, Math.min(1, rawProbability))
            : undefined
      });
    }
    return result;
  }

  function normalizeTransitionPolicy(value: any): TransitionResourcePolicy {
    if (value?.mode === "preset") {
      return {
        mode: "preset",
        resources: Array.isArray(value.resources)
          ? value.resources.filter((entry: unknown): entry is string =>
              typeof entry === "string" && entry.length > 0
            )
          : []
      };
    }
    if (value?.mode === "pool") {
      return {
        mode: "pool",
        poolId: typeof value.poolId === "string" ? value.poolId : ""
      };
    }
    return { mode: "inherit" };
  }

  function normalizeJourneyMusicEvolution(
    value: Partial<JourneyMusicEvolutionPolicy> | undefined
  ): JourneyMusicEvolutionPolicy {
    const pools = Array.isArray(value?.pools)
      ? value.pools
          .map((pool: any) => ({
            id: typeof pool?.id === "string" ? pool.id : "",
            resources: normalizeWeightedResources(pool?.resources)
          }))
          .filter((pool) => pool.id.length > 0)
      : [];

    const transitionPolicies: Record<string, TransitionResourcePolicy> = {};
    for (const [id, policy] of Object.entries(value?.transitionPolicies ?? {})) {
      if (!id) continue;
      transitionPolicies[id] = normalizeTransitionPolicy(policy);
    }

    return {
      presetJourneys: Math.max(
        0,
        Math.floor(Number(value?.presetJourneys) || 0)
      ),
      presetSequence: Array.isArray(value?.presetSequence)
        ? value.presetSequence.filter(
            (entry): entry is string =>
              typeof entry === "string" && entry.length > 0
          )
        : [],
      randomPoolId:
        typeof value?.randomPoolId === "string"
          ? value.randomPoolId
          : "",
      pools,
      transitionPolicies
    };
  }

  function weightedJourneyResource(
    resources: WeightedJourneyResource[]
  ): string | null {
    const recent = new Set(
      playedTrackHistory.slice(-Math.max(0, transitionRecentHistoryWindow))
    );
    const nonRecent = resources.filter((entry) => !recent.has(entry.id));
    const candidates = nonRecent.length ? nonRecent : resources;
    if (!candidates.length) return null;

    // Explicit probabilities reserve exact portions of the draw space.
    // Example: 0.30 + 0.20 leaves 0.50 for the remaining weighted pool.
    const explicit = candidates.filter(
      (entry) =>
        typeof entry.probability === "number" &&
        Number.isFinite(entry.probability) &&
        entry.probability > 0
    );
    const fallback = candidates.filter(
      (entry) => !explicit.includes(entry)
    );

    const explicitTotal = Math.min(
      1,
      explicit.reduce(
        (sum, entry) => sum + Math.max(0, Math.min(1, Number(entry.probability) || 0)),
        0
      )
    );

    let roll = Math.random();
    let cursor = 0;
    for (const entry of explicit) {
      const probability = Math.max(
        0,
        Math.min(1, Number(entry.probability) || 0)
      );
      const capped = Math.min(probability, Math.max(0, 1 - cursor));
      cursor += capped;
      if (roll < cursor) return entry.id;
      if (cursor >= 1) break;
    }

    // Any unreserved probability falls through to relative weights.
    if (fallback.length && roll >= explicitTotal) {
      const totalWeight = fallback.reduce(
        (sum, entry) => sum + Math.max(0.0001, Number(entry.weight) || 1),
        0
      );
      let weightedPick =
        ((roll - explicitTotal) / Math.max(0.0001, 1 - explicitTotal)) *
        totalWeight;
      for (const entry of fallback) {
        weightedPick -= Math.max(0.0001, Number(entry.weight) || 1);
        if (weightedPick <= 0) return entry.id;
      }
      return fallback[fallback.length - 1]?.id ?? null;
    }

    // If explicit probabilities consume the full space, or no weighted fallback
    // exists, use the final explicit member as a deterministic safety net.
    return explicit[explicit.length - 1]?.id ??
      candidates[candidates.length - 1]?.id ??
      null;
  }

  function transitionResourcePolicy(
    transitionId: string
  ): TransitionResourcePolicy | null {
    const direct = journeyMusicEvolution.transitionPolicies[transitionId];
    if (direct && direct.mode !== "inherit") return direct;
    const wildcard = journeyMusicEvolution.transitionPolicies["*"];
    if (wildcard && wildcard.mode !== "inherit") return wildcard;
    return null;
  }

  function resolveTransitionResourceInternal(
    transitionId: string
  ): string | null {
    const policy = transitionResourcePolicy(transitionId);
    if (!policy) return null;

    if (policy.mode === "preset") {
      if (!policy.resources.length) return null;
      const index = Math.min(
        Math.max(0, completedJourneyCount),
        policy.resources.length - 1
      );
      return policy.resources[index] ?? policy.resources[0] ?? null;
    }

    if (policy.mode !== "pool") return null;
    const pool = journeyMusicEvolution.pools.find(
      (candidate) => candidate.id === policy.poolId
    );
    return pool ? weightedJourneyResource(pool.resources) : null;
  }

