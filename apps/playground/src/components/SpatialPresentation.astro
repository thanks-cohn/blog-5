          presentationSettings.interaction.contextMenuMode = value === "edit" ? "edit" : "experience";
        } else if (key === "focusAudio.enabled") {
          presentationSettings.focusAudio.enabled = Boolean(value);
        } else if (key === "focusAudio.track") {
          presentationSettings.focusAudio.track = String(value ?? "");
        } else if (key === "focusAudio.playbackMode") {
          presentationSettings.focusAudio.playbackMode =
            value === "loop-item" ? "loop-item" : "zone-cycle";
        } else if (key === "focusAudio.scope") {
          presentationSettings.focusAudio.scope = value === "all" ? "all" : "station";
        } else if (key === "focusAudio.volume") {
          presentationSettings.focusAudio.volume = Math.max(0, Math.min(1, Number(value) || 0));
        } else if (key === "focusAudio.fadeInMs") {
          presentationSettings.focusAudio.fadeInMs = Math.max(0, Number(value) || 0);
        } else if (key === "focusAudio.fadeOutMs") {
          presentationSettings.focusAudio.fadeOutMs = Math.max(0, Number(value) || 0);
        } else if (key === "debug.glbGlobe.enabled") {
